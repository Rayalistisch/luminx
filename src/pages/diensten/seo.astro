---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import ContactOverlay from "../../components/ContactOverlay.astro";
import SeoScanInline from "../../components/SeoScanInline.astro";
import Icon from "../../components/pm/Icon.astro";

const siteOrigin = Astro.site?.toString() ?? "https://luminx.nl";
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin).toString();

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "SEO – Zoekmachineoptimalisatie",
  description: "Hogere organische posities via technische SEO, contentstrategie en linkbuilding die duurzaam verkeer en leads opleveren.",
  serviceType: "Search Engine Optimization",
  url: canonicalUrl,
  areaServed: "NL",
  provider: {
    "@type": "Organization",
    "@id": `${siteOrigin}/#organization`,
    name: "LUMINX",
    url: siteOrigin,
  },
};

const heroMetrics = [
  { value: "3–6 mnd", label: "Eerste meetbare stijging" },
  { value: "+40–120%", label: "Meer organisch verkeer" },
  { value: "Duurzaam", label: "Geen afhankelijkheid van ads" },
];

const heroOutcomes = [
  "Organische posities stijgen op commercieel relevante zoekwoorden",
  "Kwalitatief verkeer groeit zonder doorlopende advertentiekosten",
  "Technische websitekwaliteit verbetert de gebruikerservaring en crawlbaarheid",
];

const resultStack = [
  { value: "+40–120%", label: "Meer organisch verkeer" },
  { value: "3–6 mnd", label: "Eerste meetbare stijging" },
  { value: "Duurzaam", label: "Geen afhankelijkheid van ads" },
];

const specialismen = [
  {
    icon: "wrench",
    tone: "",
    title: "Technische SEO",
    description: "Crawling, indexering, Core Web Vitals en sitespeed vormen de technische basis van SEO. Zonder correcte technische configuratie kan Google een website niet volledig ranken.",
  },
  {
    icon: "search",
    tone: "pm-icon--pink",
    title: "Zoekwoordstrategie",
    description: "Effectief zoekwoordonderzoek richt zich op zoekintentie en commercieel potentieel. Zoekvolume alleen is geen betrouwbare indicator voor waarde.",
  },
  {
    icon: "file-text",
    tone: "pm-icon--yellow",
    title: "Content SEO",
    description: "Content die aansluit op elke fase van de klantreis (oriëntatie, vergelijking, aankoop) vergroot zowel organische zichtbaarheid als conversiekans.",
  },
  {
    icon: "link",
    tone: "pm-icon--wine",
    title: "Linkbuilding",
    description: "Domeinautoriteit is een van de sterkste rankingfactoren. Kwalitatieve backlinks via relevante publicaties, gastartikelen en digitale PR versterken die autoriteit structureel.",
  },
  {
    icon: "map-pin",
    tone: "pm-icon--pink",
    title: "Lokale SEO",
    description: "Voor regio-gebonden bedrijven is lokale SEO essentieel. Google Business Profile, lokale citaties en geo-gerichte content bepalen de zichtbaarheid in lokale zoekresultaten.",
  },
  {
    icon: "bag",
    tone: "pm-icon--yellow",
    title: "E-commerce SEO",
    description: "In e-commerce bepalen categoriestructuur, productpagina-optimalisatie en schema markup hoe effectief organisch verkeer converteert naar omzet.",
  },
] as const;

const benefits = [
  {
    title: "Organisch verkeer is cumulatief, advertentieverkeer niet",
    body: "Bij SEA stopt het verkeer zodra het budget stopt. Organische posities blijven verkeer genereren zonder kosten per klik. Dat maakt SEO op termijn de meest kostenefficiënte bron van websiteverkeer.",
  },
  {
    title: "Technische SEO vereist specialistische kennis",
    body: "Crawling, sitespeed, serverconfiguratie, JavaScript rendering en Core Web Vitals vallen buiten de expertise van de meeste marketing- en webteams. Technische SEO-fouten zijn een van de meest voorkomende oorzaken van slechte organische prestaties.",
  },
  {
    title: "SEO-resultaten zijn meetbaar tot op conversieniveau",
    body: "Professionele SEO-rapportage gaat verder dan rankingposities. Door verkeer, conversies en omzet te koppelen aan specifieke optimalisaties wordt zichtbaar welke inspanningen daadwerkelijk bijdragen aan bedrijfsdoelen.",
  },
  {
    title: "De drie SEO-pijlers werken alleen in samenhang",
    body: "Techniek zorgt voor indexeerbaarheid, content voor relevantie, en linkbuilding voor autoriteit. Organisaties die slechts één of twee pijlers optimaliseren, behalen structureel lagere resultaten dan bij een geïntegreerde aanpak.",
  },
  {
    title: "Extern SEO-team schaalt zonder wervingskosten",
    body: "Een volledig SEO-team (technisch specialist, contentstrateeg, linkbuilder) intern opbouwen kost tijd en budget. Uitbesteding geeft directe toegang tot alle disciplines zonder werving, inwerkperiode of capaciteitsmanagement.",
  },
];

const steps = [
  {
    icon: "search",
    title: "Audit & analyse",
    body: "Een technische SEO-audit brengt indexeringsproblemen in kaart. Zoekwoordonderzoek op basis van intent en volume identificeert de meest waardevolle zoektermen. Concurrentieanalyse toont de haalbaarheid per zoekterm.",
  },
  {
    icon: "compass",
    title: "Strategie",
    body: "Op basis van de audit ontstaat een prioriteitenlijst per pijler: welke technische issues het meeste effect hebben, welke contentkansen het hoogste rendement bieden, en waar linkbuilding het verschil maakt.",
  },
  {
    icon: "code",
    title: "Implementatie",
    body: "De implementatiefase omvat technische fixes, contentcreatie en -optimalisatie, en structurele linkbuilding via relevante publicaties en digitale PR.",
  },
  {
    icon: "chart",
    title: "Meten & optimaliseren",
    body: "Maandelijkse rapportage op rankings, organisch verkeer en conversies maakt het mogelijk de strategie bij te sturen op basis van actuele data en algoritme-updates.",
  },
] as const;

const pains = [
  "De website rankt niet op commercieel relevante zoekwoorden",
  "Technische fouten verhinderen correcte crawling en indexering door Google",
  "Bestaande content sluit niet aan op de zoekintenties van de doelgroep",
  "Concurrenten met sterkere domeinautoriteit domineren de zoekresultaten",
  "Er ontbreekt inzicht in welke SEO-activiteiten daadwerkelijk omzet genereren",
  "Rankingfluctuaties treden op zonder duidelijke diagnose of bijsturingsstrategie",
];

const gains = [
  "Technische SEO-audit met geprioriteerde actielijst en directe fixes",
  "Zoekwoordstrategie gebaseerd op volume, zoekintentie en concurrentiehaalbaarheid",
  "Contentplan en -productie afgestemd op elke fase van de klantreis",
  "Structurele linkbuilding en autoriteitsopbouw via relevante publicaties",
  "Maandelijkse rapportage op rankings, organisch verkeer en conversies",
  "Proactieve bijsturing bij algoritme-updates van Google",
];

const outcomes = [
  "Hogere organische posities",
  "Meer kwalitatief verkeer",
  "Betere technische websitekwaliteit",
  "Lagere kosten per lead",
  "Duurzame zichtbaarheid",
  "Meer conversies uit organisch verkeer",
  "Sterke contentstrategie",
  "Autoriteitsopbouw in jouw niche",
];

const related = [
  { href: "/vergelijk/seo-vs-sea", title: "SEO vs. SEA", desc: "Wanneer kies je organisch, wanneer betaald?" },
  { href: "/vergelijk/geo-vs-seo", title: "GEO vs. SEO", desc: "Zoekmachines vs. AI-antwoorden, wat past bij jou?" },
  { href: "/blog/google-maart-core-update-2026", title: "Google Maart Core Update 2026", desc: "Wat betekent de update voor jouw website?" },
  { href: "/blog/google-patent-ai-gegenereerde-paginas", title: "Google's AI-patent", desc: "Wat het betekent voor jouw SEO-strategie." },
  { href: "/diensten/online-marketing", title: "Online Marketing", desc: "SEO als onderdeel van een brede marketingaanpak." },
];

const faq = [
  {
    q: "Hoe lang duurt het voor SEO resultaat zichtbaar is?",
    a: "De eerste meetbare verbeteringen zijn doorgaans zichtbaar na drie tot zes maanden. Technische fixes kunnen sneller effect hebben, maar contentposities en autoriteitsopbouw vragen meer tijd. Na zes tot twaalf maanden zie je doorgaans substantiële groei in organisch verkeer en rankings.",
  },
  {
    q: "Wat kost SEO uitbesteden?",
    a: "De kosten zijn afhankelijk van de scope: technische complexiteit, het aantal pagina's, de concurrentie in jouw markt en of we ook content produceren. We werken altijd met een helder voorstel zodat je precies weet wat je betaalt en wat je terugkrijgt.",
  },
  {
    q: "Wat is het verschil tussen SEO en SEA?",
    a: "SEO richt zich op organische (gratis) posities via techniek, content en linkbuilding. Dat kost tijd maar heeft een duurzame impact. SEA werkt met betaalde advertenties die direct bovenaan de zoekresultaten verschijnen. De meeste bedrijven profiteren van een combinatie van beide.",
  },
  {
    q: "Kunnen jullie ook content schrijven?",
    a: "Ja. Contentcreatie is een integraal onderdeel van onze SEO-aanpak. We schrijven op basis van zoekintentie, klantreis en E-E-A-T-richtlijnen, met teksten die zowel goed scoren als overtuigen.",
  },
  {
    q: "Welke tools gebruiken jullie voor SEO?",
    a: "We werken met Screaming Frog, Ahrefs, Google Search Console, SEMrush en Google Analytics 4. Deze combinatie geeft inzicht in technische issues, backlinks, zoekwoorden, concurrentie en conversies.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map(({ q, a }) => ({
    "@type": "Question",
    name: q,
    acceptedAnswer: { "@type": "Answer", text: a },
  })),
};
---

<BaseLayout
  title="SEO Uitbesteden – Zoekmachineoptimalisatie | LuminX"
  description="Hogere organische posities via technische SEO, contentstrategie en linkbuilding die duurzaam verkeer en leads opleveren. Professionele SEO door LuminX."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(serviceSchema)}></script>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
  <Nav basePath="/" />

  <main class="svc">

    <!-- Hero -->
    <section class="svc__hero" aria-labelledby="svc-title">
      <div class="pm-stack">
        <span class="pm-stack__layer" aria-hidden="true"></span>
        <span class="pm-stack__layer" aria-hidden="true"></span>
        <span class="pm-stack__layer" aria-hidden="true"></span>

        <div class="pm-stack__panel svc__panel">
          <img class="pm-obj pm-obj--right" src="/images/3d/seo-search.webp" width="1223" height="1012" alt="" aria-hidden="true" decoding="async" />
          <div class="svc__hero-content">
            <a href="/diensten/online-marketing" class="svc__back" data-reveal>
              <Icon name="arrow" size={16} stroke={2.4} /> Online Marketing
            </a>
            <span class="pm-tag svc__tag" data-reveal style="--d: 1"><Icon name="search" size={16} /> Specialisme · Zoekmachineoptimalisatie</span>
            <h1 id="svc-title" class="pm-h1 svc__title" data-reveal style="--d: 2">SEO</h1>
            <p class="pm-opening svc__sub" data-reveal style="--d: 3">
              Effectieve SEO rust op drie pijlers: technische gezondheid, relevante content en domeinautoriteit. Samen bepalen ze of een website vindbaar is op de zoekopdrachten die commercieel ertoe doen.
            </p>
            <div class="svc__actions" data-reveal style="--d: 4">
              <a href="#contact" class="pm-btn pm-btn--yellow">Plan kennismaking <Icon name="arrow" /></a>
              <a href="#aanpak" class="pm-btn pm-btn--white">Bekijk aanpak</a>
            </div>
          </div>
        </div>
      </div>

      <div class="pm-container svc__float-wrap">
        <div class="pm-card pm-card--lift svc__float" data-reveal>
          <div class="svc__float-side">
            <span class="pm-label">Meetbare effecten van SEO</span>
            <ul class="pm-checks">
              {heroOutcomes.map((o) => <li>{o}</li>)}
            </ul>
          </div>
          <ul class="svc__metrics" aria-label="Kerncijfers">
            {heroMetrics.map((m, i) => (
              <li class="pm-stat svc__metric" data-reveal style={`--d: ${i}`}>
                <span class="pm-stat__value">{m.value}</span>
                <span class="pm-stat__label">{m.label}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- Wat is SEO -->
    <section class="pm-section svc__what" aria-labelledby="what-title">
      <div class="pm-container pm-split svc__what-grid">
        <div class="pm-card pm-card--pink pm-card--lift svc__stack" aria-hidden="true" data-reveal>
          <div class="svc__stack-head">
            <span class="pm-icon pm-icon--sm pm-icon--yellow"><Icon name="trending-up" /></span>
            <span>SEO Resultaten</span>
          </div>
          <ol class="svc__stack-list">
            {resultStack.map((r, i) => (
              <li>
                <span class="svc__stack-num">0{i + 1}</span>
                <span class="svc__stack-body">
                  <strong>{r.value}</strong>
                  <span>{r.label}</span>
                </span>
              </li>
            ))}
          </ol>
        </div>

        <div class="svc__what-text">
          <header class="pm-head pm-head--left svc__head-left">
            <span class="pm-label" data-reveal>Wat is SEO?</span>
            <h2 id="what-title" class="pm-h2" data-reveal style="--d: 1">Zoekmachineoptimalisatie: definitie en werking</h2>
          </header>
          <p class="pm-text" data-reveal style="--d: 2">Search Engine Optimization (SEO) is het systematisch verbeteren van de vindbaarheid van een website in organische zoekresultaten. De drie pijlers van SEO zijn technische optimalisatie, contentrelevantie en domeinautoriteit. Elk onderdeel is noodzakelijk voor duurzame rankings.</p>
          <p class="pm-text" data-reveal style="--d: 3">In tegenstelling tot betaald adverteren (SEA) levert SEO geen direct verkeer op, maar bouwt het een cumulatief effect op. Goed gepositioneerde pagina's genereren continu organisch verkeer zonder kosten per klik. Daarmee is SEO voor de meeste organisaties op termijn het meest rendabele digitale marketingkanaal.</p>
          <a href="#contact" class="pm-link svc__inline" data-overlay-open data-reveal style="--d: 4">Gratis SEO-analyse <Icon name="arrow" size={18} stroke={2.4} /></a>
        </div>
      </div>
    </section>

    <!-- Specialismen -->
    <section class="pm-section svc__types" aria-labelledby="types-title">
      <div class="pm-container">
        <header class="pm-head">
          <span class="pm-label" data-reveal>Specialismen</span>
          <h2 id="types-title" class="pm-h2" data-reveal style="--d: 1">De zes disciplines van professionele SEO</h2>
          <p class="pm-opening" data-reveal style="--d: 2">Een effectieve SEO-strategie omvat technische optimalisatie, contentstrategie en linkbuilding. Elk specialisme adresseert een specifiek onderdeel van het rankingalgoritme.</p>
        </header>
        <ul class="svc__grid">
          {specialismen.map((t, i) => (
            <li class="pm-card pm-card--pad svc__tile" data-reveal style={`--d: ${i % 3}`}>
              <span class:list={["pm-icon", t.tone]}><Icon name={t.icon} /></span>
              <h3 class="pm-h3 svc__tile-title">{t.title}</h3>
              <p class="pm-text">{t.description}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Waarom uitbesteden -->
    <section class="pm-section pm-band--paper svc__benefits" aria-labelledby="benefits-title">
      <div class="pm-container">
        <header class="pm-head">
          <span class="pm-label" data-reveal>Waarom uitbesteden?</span>
          <h2 id="benefits-title" class="pm-h2" data-reveal style="--d: 1">Wat professionele SEO oplevert ten opzichte van intern beheer</h2>
          <p class="pm-opening" data-reveal style="--d: 2">Google voert meerdere algoritme-updates per jaar door. De technische en inhoudelijke eisen voor organische zichtbaarheid stijgen continu. Dat maakt SEO een specialistisch vakgebied met meetbare voordelen bij professionele uitvoering.</p>
        </header>
        <div class="pm-split">
          <ul class="pm-accordion" data-reveal>
            {benefits.map((b, i) => (
              <li>
                <details class="pm-acc" name="seo-benefits" open={i === 0}>
                  <summary>{b.title}</summary>
                  <div class="pm-acc__body"><p>{b.body}</p></div>
                </details>
              </li>
            ))}
          </ul>
          <div class="pm-card pm-card--yellow pm-card--lift svc__statcard" data-reveal style="--d: 1">
            <div class="pm-stat">
              <span class="pm-stat__value">90%</span>
              <span class="pm-stat__label">van onze klanten ziet binnen 6 maanden rankingstijging</span>
            </div>
            <span class="pm-dots" aria-hidden="true"></span>
            <div class="pm-stat">
              <span class="pm-stat__value">100%</span>
              <span class="pm-stat__label">eigenaarschap van je content en data</span>
            </div>
            <span class="pm-icon svc__statcard-badge" aria-hidden="true"><Icon name="shield" /></span>
          </div>
        </div>
      </div>
    </section>

    <!-- Aanpak -->
    <section class="pm-section svc__approach" id="aanpak" aria-labelledby="approach-title">
      <div class="pm-container">
        <header class="pm-head">
          <span class="pm-label" data-reveal>Aanpak</span>
          <h2 id="approach-title" class="pm-h2" data-reveal style="--d: 1">Vier fases van audit naar duurzame organische groei</h2>
        </header>
        <ol class="svc__chain">
          {steps.map((s, i) => (
            <li class="pm-card pm-card--milk svc__chain-step" data-reveal style={`--d: ${i}`}>
              <span class:list={["pm-icon", i === 3 ? "pm-icon--yellow" : i % 2 ? "pm-icon--pink" : ""]}><Icon name={s.icon} /></span>
              <span class="svc__chain-num">Fase 0{i + 1}</span>
              <h3 class="pm-h3 svc__chain-title">{s.title}</h3>
              <p class="pm-text">{s.body}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Knelpunten vs oplevering -->
    <section class="pm-section pm-section--tight svc__compare" aria-label="Knelpunten en oplossingen">
      <div class="pm-container">
        <div class="pm-card pm-card--plum pm-card--lift svc__plum">
          <div class="svc__plum-split">
            <article class="svc__plum-col" data-reveal>
              <span class="pm-icon pm-icon--pink" aria-hidden="true"><Icon name="alert" /></span>
              <h2 class="pm-h3">Veelvoorkomende SEO-knelpunten bij organisaties</h2>
              <ul class="pm-checks pm-checks--x">
                {pains.map((p) => <li>{p}</li>)}
              </ul>
            </article>
            <article class="pm-card pm-card--milk pm-card--pad svc__plum-col svc__plum-col--light" data-reveal style="--d: 1">
              <span class="pm-icon pm-icon--yellow" aria-hidden="true"><Icon name="check" /></span>
              <h2 class="pm-h3">Wat een SEO-traject oplevert</h2>
              <ul class="pm-checks">
                {gains.map((g) => <li>{g}</li>)}
              </ul>
            </article>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="pm-section svc__faq" aria-labelledby="faq-title">
      <div class="pm-container pm-container--narrow">
        <header class="pm-head">
          <span class="pm-label" data-reveal>Veelgestelde vragen</span>
          <h2 id="faq-title" class="pm-h2" data-reveal style="--d: 1">Alles over SEO uitbesteden</h2>
          <p class="pm-opening" data-reveal style="--d: 2">Staat jouw vraag er niet bij? Neem gerust contact op voor een vrijblijvend gesprek.</p>
        </header>
        <ul class="pm-accordion" data-reveal style="--d: 1">
          {faq.map((item, i) => (
            <li>
              <details class="pm-acc" name="seo-faq" open={i === 0}>
                <summary>{item.q}</summary>
                <div class="pm-acc__body"><p>{item.a}</p></div>
              </details>
            </li>
          ))}
        </ul>
        <div class="svc__faq-more" data-reveal>
          <a href="#contact" class="pm-btn pm-btn--white pm-btn--sm" data-overlay-open>Stel je vraag <Icon name="arrow" /></a>
        </div>
      </div>
    </section>

    <!-- Gratis SEO-scan (component restyled separately) -->
    <SeoScanInline />

    <!-- Resultaten -->
    <section class="pm-section pm-section--tight svc__outcomes" aria-labelledby="outcomes-title">
      <div class="pm-container">
        <header class="pm-head">
          <span class="pm-icon pm-icon--yellow" aria-hidden="true" data-reveal><Icon name="target" /></span>
          <h2 id="outcomes-title" class="pm-h2" data-reveal style="--d: 1">Resultaten die je mag verwachten</h2>
        </header>
        <ul class="svc__chips">
          {outcomes.map((o, i) => (
            <li class:list={["pm-tag", i % 3 === 0 ? "pm-tag--yellow" : i % 3 === 1 ? "pm-tag--paper" : "pm-tag--pink"]} data-reveal style={`--d: ${i % 4}`}>{o}</li>
          ))}
        </ul>

        <a href="/diensten/geo" class="pm-card pm-card--yellow pm-card--lift svc__crosslink" data-reveal>
          <span class="pm-icon pm-icon--wine" aria-hidden="true"><Icon name="sparkles" /></span>
          <span class="svc__crosslink-text">
            <span class="pm-tag svc__crosslink-badge">Nieuw</span>
            <strong>GEO – AI-zichtbaarheid</strong>
            <span>Zichtbaar in ChatGPT, Gemini en Perplexity? Ontdek Generative Engine Optimization</span>
          </span>
          <span class="svc__arrow" aria-hidden="true"><Icon name="arrow" size={18} stroke={2.4} /></span>
        </a>
      </div>
    </section>

    <!-- Gerelateerd -->
    <section class="pm-section pm-section--tight svc__related" aria-labelledby="related-title">
      <div class="pm-container">
        <header class="pm-head pm-head--left">
          <span id="related-title" class="pm-label">Gerelateerd</span>
        </header>
        <ul class="svc__related-grid">
          {related.map((r, i) => (
            <li data-reveal style={`--d: ${i}`}>
              <a href={r.href} class="pm-card svc__related-card">
                <span class="svc__related-text">
                  <strong>{r.title}</strong>
                  <span>{r.desc}</span>
                </span>
                <span class="svc__arrow" aria-hidden="true"><Icon name="arrow" size={18} stroke={2.4} /></span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- CTA -->
    <section class="pm-band svc__cta" id="contact" aria-labelledby="cta-title">
      <div class="pm-container svc__cta-inner">
        <span class="pm-icon pm-icon--yellow" aria-hidden="true" data-reveal><Icon name="search" /></span>
        <h2 id="cta-title" class="pm-h2 pm-outline svc__cta-title" data-reveal style="--d: 1">Klaar voor structurele organische groei?</h2>
        <p class="pm-opening svc__cta-text" data-reveal style="--d: 2">We analyseren jouw huidige SEO-situatie en presenteren een concreet plan met prioriteiten, tijdlijn en verwachte resultaten.</p>
        <a href="#" class="pm-btn pm-btn--yellow" data-overlay-open data-reveal style="--d: 3">Plan kennismaking <Icon name="arrow" /></a>
      </div>
    </section>

    <Footer />
    <ContactOverlay />
  </main>
