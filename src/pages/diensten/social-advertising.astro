---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import ContactOverlay from "../../components/ContactOverlay.astro";
import Icon from "../../components/pm/Icon.astro";

const siteOrigin = Astro.site?.toString() ?? "https://luminx.nl";
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin).toString();

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Social Advertising",
  description: "Social advertising campagnes op Meta, LinkedIn en TikTok die je doelgroep bereiken en merkbekendheid omzetten in leads.",
  serviceType: "Social Media Advertising",
  url: canonicalUrl,
  areaServed: "NL",
  provider: {
    "@type": "Organization",
    "@id": `${siteOrigin}/#organization`,
    name: "LUMINX",
    url: siteOrigin,
  },
};

const metrics = [
  { value: "2–5×", label: "Hogere engagement rate" },
  { value: "−25–50%", label: "Lagere CPM vs. benchmark" },
  { value: "3 kanalen", label: "Meta · LinkedIn · TikTok" },
];

const uitkomsten = [
  "Merkbekendheid stijgt binnen de gedefinieerde doelgroep",
  "Leadkwaliteit verbetert door gerichte funnelsegmentatie",
  "Kosten per conversie dalen door structurele creatieve tests",
];

const resultaten = [
  { value: "2–5×", label: "Hogere engagement rate" },
  { value: "−25–50%", label: "Lagere CPM vs. benchmark" },
  { value: "Meta · LinkedIn · TikTok", label: "Kanaalcoverage" },
];

const kanalen = [
  {
    icon: "megaphone",
    tone: "",
    title: "Meta Ads",
    description: "Facebook en Instagram bieden doelgroepsturing op demografie, interesse en gedrag. Het platform dekt de volledige funnel: van awareness tot directe conversie.",
  },
  {
    icon: "users",
    tone: "pm-icon--wine",
    title: "LinkedIn Ads",
    description: "LinkedIn segmenteert op functietitel, sector en bedrijfsgrootte. Dit maakt het platform het meest geschikte kanaal om B2B-beslissers met een gerichte boodschap te bereiken.",
  },
  {
    icon: "play",
    tone: "pm-icon--pink",
    title: "TikTok Ads",
    description: "TikTok levert native video-advertenties die opgaan in de feed. Het platform scoort sterk op merkbekendheid en bereikt jongere, actief betrokken doelgroepen.",
  },
  {
    icon: "image",
    tone: "pm-icon--yellow",
    title: "Pinterest Ads",
    description: "Pinterest richt zich op visuele productadvertenties in sectoren als lifestyle, wonen, mode en food. Gebruikers bevinden zich actief in de inspiratie- en aankoopfase.",
  },
  {
    icon: "target",
    tone: "",
    title: "Retargeting",
    description: "Retargeting bereikt warme doelgroepen opnieuw: websitebezoekers, videokijkers en abandon-cart segmenten ontvangen gepersonaliseerde boodschappen op basis van eerder gedrag.",
  },
  {
    icon: "sparkles",
    tone: "pm-icon--pink",
    title: "UGC & Creator content",
    description: "Advertenties op basis van user-generated content en creator-samenwerkingen presteren doorgaans authentieker en verlagen de kosten per resultaat ten opzichte van studio-content.",
  },
];

const benefits = [
  {
    title: "Precisiemeting op doelgroep en kanaal",
    body: "Systematisch testen op doelgroep, kanaal en format bepaalt waar het advertentiebudget het hoogste rendement oplevert. Datagedreven allocatie vervangt aannames.",
  },
  {
    title: "Creative testing op schaal",
    body: "Creatives vormen de grootste hefboom in paid social. Gestructureerde A/B-tests op tekst, beeld, format en call-to-action identificeren winnaars die vervolgens worden opgeschaald.",
  },
  {
    title: "Full-funnel aanpak van awareness tot conversie",
    body: "Een full-funnel aanpak dekt elke fase van de klantreis: awareness voor nieuwe doelgroepen, consideration voor geinteresseerden, en conversie voor warme leads die klaar zijn om te handelen.",
  },
  {
    title: "Snelle iteratie op basis van realtime data",
    body: "Social advertising kent korte feedbackcycli. Wekelijkse optimalisatie op basis van actuele data zorgt ervoor dat ondermaats presterende advertenties snel worden gestopt en winnaars meer budget ontvangen.",
  },
  {
    title: "Volledig accounteigenaarschap bij de klant",
    body: "Best practice in social advertising is dat de adverteerder eigenaar blijft van alle advertentieaccounts. Dit garandeert volledige transparantie op budget, resultaten en kosten, ongeacht de samenwerking met een bureau.",
  },
];

const steps = [
  { title: "Doelgroep & strategie", body: "Doelgroeponderzoek, kanaalselectie en campagnestrategie worden bepaald op basis van bedrijfsdoelstellingen, beschikbaar budget en de fase in de klantreis." },
  { title: "Creatie & opzet", body: "Creatieve concepten en copy worden ontwikkeld per doelgroep en kanaal. Daarnaast vindt campagne-opzet, pixel- en eventinstallatie plaats voor correcte conversietracking." },
  { title: "Livegang & optimalisatie", body: "Na livegang volgt wekelijkse optimalisatie in de eerste maand op doelgroepen, plaatsingen, creatives en biedstrategieen." },
  { title: "Schalen & uitbreiden", body: "De schaalfase bouwt voort op bewezen winnaars en datapunten. Uitbreiding richt zich op nieuwe doelgroepen, kanalen en advertentieformats." },
];

const problemen = [
  "Hoog bereik zonder proportionele leadgeneratie",
  "Creatives worden eenmalig geproduceerd zonder structurele testcycli",
  "Doelgroepinstellingen zijn te breed of niet afgestemd op de funnelfase",
  "Retargeting ontbreekt voor bezoekers die al interesse toonden",
  "Budgetallocatie vindt plaats zonder inzicht in campagneprestaties",
  "Pixel- en conversietracking zijn niet correct geconfigureerd",
];

const opleveringen = [
  "Kanaalstrategie per funnelfase: awareness, overweging en conversie",
  "Creatieve concepten en copy afgestemd op doelgroep en kanaal",
  "Structurele A/B-tests op doelgroepen, creatives en formats",
  "Retargeting-funnels voor warme doelgroepen en lookalike-audiences",
  "Volledige conversietracking via Pixel, CAPI en GA4",
  "Periodieke rapportage met conclusies en aanbevelingen",
];

const faq = [
  {
    q: "Welk social kanaal is het beste voor mijn bedrijf?",
    a: "Dat hangt af van jouw doelgroep, product en doelstelling. B2B-bedrijven die beslissers willen bereiken kiezen vaak LinkedIn. Voor brede consumentenmerken werkt Meta sterk. TikTok is krachtig voor merken die jonger publiek zoeken. We adviseren altijd op basis van jouw specifieke situatie, niet op basis van trends.",
  },
  {
    q: "Wat kost social advertising?",
    a: "De kosten bestaan uit het advertentiebudget dat rechtstreeks naar het platform gaat, en de beheervergoeding aan LuminX. De beheervergoeding is afhankelijk van de campagnecomplexiteit en het maandbudget. We werken altijd met een transparant voorstel.",
  },
  {
    q: "Hoe meet je succes bij social advertising?",
    a: "We meten op basis van jouw doelstelling: merkbekendheid op bereik en videoviews, leadgeneratie op cost per lead en leadkwaliteit, conversies op ROAS en cost per purchase. Alle data is toegankelijk via jouw eigen dashboard.",
  },
  {
    q: "Hoe onderscheiden jullie creatives zich?",
    a: "We combineren strategisch inzicht in de doelgroep met een visueel sterke uitvoering. Onze creatives zijn opgebouwd vanuit gedragswetenschappelijke principes, de eerste seconden bepalen of iemand stopt met scrollen. We testen continu en leren van elke iteratie.",
  },
  {
    q: "Wat is het verschil tussen organisch en betaald social?",
    a: "Organisch social is je aanwezigheid via berichten, stories en reels die je gratis plaatst. Bereik is beperkt tot je bestaande volgers. Betaald social (advertising) geeft je de mogelijkheid om gericht nieuwe doelgroepen te bereiken, te segmenteren en te schalen op basis van resultaat.",
  },
];

const outcomes = [
  "Meer merkbekendheid bij de juiste doelgroep",
  "Hogere kwaliteit leads",
  "Lagere kosten per conversie",
  "Consistente leadinstroom",
  "Schaalbare creatieve tests",
  "Volledige accounttransparantie",
  "Sterke retargeting-funnels",
  "Geïntegreerde kanaalstrategie",
];

const reads = [
  { href: "/diensten/online-marketing", title: "Online Marketing", body: "Social advertising als onderdeel van een brede aanpak." },
  { href: "/diensten/sea", title: "SEA & Google Ads", body: "Betaalde campagnes in Google naast Meta en LinkedIn." },
  { href: "/diensten/emailmarketing", title: "E-mailmarketing", body: "Leads nurturen na de eerste klik via social." },
];

const pillTones = ["pm-tag--yellow", "pm-tag--pink", "", "pm-tag--paper"];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map(({ q, a }) => ({
    "@type": "Question",
    name: q,
    acceptedAnswer: { "@type": "Answer", text: a },
  })),
};
---

<BaseLayout
  title="Social Advertising – Meta, LinkedIn & TikTok Ads | LuminX"
  description="Social advertising campagnes op Meta, LinkedIn en TikTok die je doelgroep bereiken en merkbekendheid omzetten in leads en conversies."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(serviceSchema)}></script>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
  <Nav basePath="/" />

  <main class="svc">

    <!-- Hero -->
    <section class="svc__hero" aria-labelledby="svc-title">
      <div class="pm-stack">
        <span class="pm-stack__layer" aria-hidden="true"></span>
        <span class="pm-stack__layer" aria-hidden="true"></span>
        <span class="pm-stack__layer" aria-hidden="true"></span>
        <div class="pm-stack__panel svc__panel">
          <div class="svc__hero-content">
            <a href="/diensten/online-marketing" class="svc__back" data-reveal><Icon name="arrow" size={16} /> Online Marketing</a>
            <span class="pm-tag pm-tag--pink" data-reveal style="--d: 1">Specialisme</span>
            <h1 id="svc-title" class="pm-h1 svc__title" data-reveal style="--d: 2">Social Advertising</h1>
            <p class="pm-opening svc__sub" data-reveal style="--d: 3">Effectieve social advertising combineert doelgroepdata, platformkennis en creatieve iteratie om de juiste mensen te bereiken, op het kanaal waar ze actief zijn, met advertenties die aanzetten tot actie.</p>
            <div class="svc__actions" data-reveal style="--d: 4">
              <a href="#contact" class="pm-btn pm-btn--yellow">Plan kennismaking <Icon name="arrow" /></a>
              <a href="#aanpak" class="pm-btn pm-btn--white">Bekijk aanpak</a>
            </div>
          </div>
        </div>
      </div>

      <div class="pm-container svc__float-wrap">
        <div class="pm-card pm-card--lift svc__float" data-reveal>
          <ul class="svc__metrics">
            {metrics.map((m) => (
              <li class="pm-stat svc__metric">
                <strong class="pm-stat__value">{m.value}</strong>
                <span class="pm-stat__label">{m.label}</span>
              </li>
            ))}
          </ul>
          <div class="svc__glance">
            <div class="svc__glance-head">
              <span class="pm-icon pm-icon--sm pm-icon--wine" aria-hidden="true"><Icon name="share" /></span>
              <span class="pm-label">Meetbare uitkomsten</span>
            </div>
            <ul class="pm-checks">
              {uitkomsten.map((d) => <li>{d}</li>)}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Wat is social advertising -->
    <section class="pm-section" aria-labelledby="social-what-title">
      <div class="pm-container pm-split svc__intro-grid">
        <div class="svc__intro-text">
          <span class="pm-label" data-reveal>Wat is social advertising?</span>
          <h2 id="social-what-title" class="pm-h2" data-reveal style="--d: 1">Betaalde social campagnes die doelgroepen bereiken buiten het eigen netwerk</h2>
          <p class="pm-text" data-reveal style="--d: 2">Social advertising is het inkopen van advertentieruimte op platforms als Meta, LinkedIn en TikTok. Adverteerders bereiken hiermee specifieke doelgroepen op basis van gedrag, interesses en demografische kenmerken, onafhankelijk van het eigen volgersbestand.</p>
          <p class="pm-text" data-reveal style="--d: 3">In tegenstelling tot organisch social, dat afhankelijk is van platformalgoritmes, biedt betaald social volledige controle over bereik, boodschap en timing. Bij juiste inzet functioneert social advertising als een schaalbaar acquisitiekanaal voor merkbekendheid en leadgeneratie.</p>
          <a href="#contact" class="pm-link" data-overlay-open data-reveal style="--d: 4">Gratis campagneadvies <Icon name="arrow" size={18} /></a>
        </div>
        <div class="svc__fan-wrap" data-reveal style="--d: 2">
          <span class="pm-label">Social Resultaten</span>
          <ol class="svc__fan">
            {resultaten.map((r, i) => (
              <li>
                <span class="svc__fan-num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
                <strong>{r.value}</strong>
                <span class="svc__fan-label">{r.label}</span>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <!-- Kanalen & formats -->
    <section class="pm-section pm-section--tight" aria-labelledby="social-services-title">
      <div class="pm-container">
        <header class="pm-head">
          <span class="pm-label" data-reveal>Kanalen & formats</span>
          <h2 id="social-services-title" class="pm-h2" data-reveal style="--d: 1">De belangrijkste social advertising kanalen in Nederland</h2>
          <p class="pm-opening" data-reveal style="--d: 2">Elk platform bedient een ander segment van de funnel. Effectieve social advertising combineert kanalen op basis van doelgroep, fase en advertentieformat.</p>
        </header>
        <ul class="svc__grid">
          {kanalen.map((item, i) => (
            <li data-reveal style={`--d: ${i % 3}`}>
              <article class="pm-card pm-card--milk svc__tile">
                <span class:list={["pm-icon", item.tone]} aria-hidden="true"><Icon name={item.icon} /></span>
                <h3 class="pm-h3">{item.title}</h3>
                <p class="pm-text">{item.description}</p>
              </article>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Voordelen -->
    <section class="pm-section" aria-labelledby="social-benefits-title">
      <div class="pm-container pm-split">
        <div class="pm-card pm-card--pink pm-card--lift svc__feature" data-reveal>
          <span class="pm-label">Voordelen</span>
          <h2 id="social-benefits-title" class="pm-h2">Kenmerken van effectief social advertising-beheer</h2>
          <p class="pm-text">Social platforms veranderen continu: algoritmes, advertentieformats, doelgroepsturing en biedstrategieen evolueren snel. Professioneel beheer vereist dat deze ontwikkelingen structureel worden gevolgd en toegepast.</p>
          <div class="svc__feature-stats">
            <div class="pm-stat"><strong class="pm-stat__value">3×</strong><span class="pm-stat__label">meer leads gemiddeld in het eerste kwartaal</span></div>
            <div class="pm-stat"><strong class="pm-stat__value">100%</strong><span class="pm-stat__label">accounteigenaarschap bij de klant</span></div>
          </div>
        </div>
        <ul class="pm-accordion" data-reveal style="--d: 1">
          {benefits.map((b, i) => (
            <li>
              <details class="pm-acc" name="social-benefits" open={i === 0}>
                <summary>{b.title}</summary>
                <div class="pm-acc__body"><p>{b.body}</p></div>
              </details>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Aanpak -->
    <section class="pm-section pm-section--tight" id="aanpak" aria-labelledby="social-approach-title">
      <div class="pm-container">
        <div class="pm-card pm-card--plum pm-card--lift svc__steps-card">
          <header class="pm-head">
            <span class="pm-tag pm-tag--pink" data-reveal>Aanpak</span>
            <h2 id="social-approach-title" class="pm-h2" data-reveal style="--d: 1">Vier fases van doelgroeponderzoek naar schaalbare campagnes</h2>
          </header>
          <ol class="svc__steps" style="--steps: 4">
            {steps.map((s, i) => (
              <li class="svc__step" data-reveal style={`--d: ${i}`}>
                <span class="pm-icon pm-icon--yellow svc__step-num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
                <h3 class="pm-h3">{s.title}</h3>
                <p>{s.body}</p>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <!-- Context -->
    <section class="pm-section" aria-label="Knelpunten en oplevering">
      <div class="pm-container pm-split svc__duo">
        <article class="pm-card" data-reveal>
          <div class="svc__duo-head">
            <span class="pm-icon pm-icon--pink" aria-hidden="true"><Icon name="alert" /></span>
            <h2 class="pm-h2">Veelvoorkomende knelpunten bij social advertising</h2>
          </div>
          <ul class="pm-checks pm-checks--x">
            {problemen.map((p) => <li>{p}</li>)}
          </ul>
        </article>
        <article class="pm-card pm-card--milk pm-card--lift" data-reveal style="--d: 1">
          <div class="svc__duo-head">
            <span class="pm-icon pm-icon--yellow" aria-hidden="true"><Icon name="check" /></span>
            <h2 class="pm-h2">Wat professioneel social advertising oplevert</h2>
          </div>
          <ul class="pm-checks">
            {opleveringen.map((o) => <li>{o}</li>)}
          </ul>
        </article>
      </div>
    </section>

    <!-- FAQ -->
    <section class="pm-section" aria-labelledby="social-faq-title">
      <div class="pm-container pm-container--narrow">
        <header class="pm-head svc__faq-head">
          <span class="pm-label" data-reveal>Veelgestelde vragen</span>
          <h2 id="social-faq-title" class="pm-h2" data-reveal style="--d: 1">Alles over social advertising uitbesteden</h2>
          <p class="pm-opening" data-reveal style="--d: 2">Staat jouw vraag er niet bij? Neem gerust contact op voor een vrijblijvend gesprek.</p>
          <a href="#contact" class="pm-link" data-overlay-open data-reveal style="--d: 3">Stel je vraag <Icon name="arrow" size={18} /></a>
        </header>
        <ul class="pm-accordion" data-reveal>
          {faq.map((item, i) => (
            <li>
              <details class="pm-acc" name="social-faq" open={i === 0}>
                <summary>{item.q}</summary>
                <div class="pm-acc__body"><p>{item.a}</p></div>
              </details>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Resultaten -->
    <section class="pm-band pm-band--paper pm-section pm-section--tight" aria-labelledby="social-outcomes-title">
      <div class="pm-container svc__outcomes-inner">
        <h2 id="social-outcomes-title" class="pm-h2" data-reveal>Resultaten die je mag verwachten</h2>
        <ul class="svc__pills">
          {outcomes.map((o, i) => (
            <li data-reveal style={`--d: ${i}`}><span class:list={["pm-tag", pillTones[i % pillTones.length]]}>{o}</span></li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Gerelateerde diensten -->
    <section class="pm-section pm-section--tight" aria-label="Gerelateerde diensten">
      <div class="pm-container">
        <span class="pm-label svc__reads-label">Gerelateerde diensten</span>
        <ul class="svc__reads">
          {reads.map((r, i) => (
            <li data-reveal style={`--d: ${i}`}>
              <a href={r.href} class="pm-card pm-card--milk svc__read">
                <span><strong>{r.title}</strong><small>{r.body}</small></span>
                <Icon name="arrow" />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- CTA -->
    <section class="pm-band svc__cta" id="contact" aria-labelledby="social-cta-title">
      <div class="pm-container svc__cta-inner">
        <h2 id="social-cta-title" class="pm-h2 pm-outline svc__cta-title" data-reveal>Klaar voor social campagnes die écht converteren?</h2>
        <p class="pm-opening svc__cta-text" data-reveal style="--d: 1">We vertalen jouw doelstellingen naar een concreet campagneplan met kanaaladvies, creatieve richting en verwachte resultaten.</p>
        <a href="#" class="pm-btn pm-btn--yellow" data-overlay-open data-reveal style="--d: 2">Plan kennismaking <Icon name="arrow" /></a>
      </div>
    </section>
  </main>

  <Footer />
  <ContactOverlay />
</BaseLayout>

<style>
  /* ── Hero: stacked plum panel + overlapping "at a glance" card ───────── */
  .svc__hero { position: relative; padding-top: 72px; }

  .svc__panel {
    padding: clamp(4.5rem, 8vw, 6.5rem) var(--pm-gutter) clamp(10rem, 17vw, 13rem);
  }

  .svc__hero-content {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 1.4rem;
    max-width: 920px;
    margin-inline: auto;
  }

  .svc__back {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--pm-milk);
    font-size: 0.875rem;
    font-weight: 700;
    text-decoration: none;
    opacity: 0.85;
    transition: opacity 0.25s ease;
  }
  .svc__back svg { transform: rotate(180deg); }
  @media (hover: hover) { .svc__back:hover { opacity: 1; } }

  .svc__title { color: var(--pm-milk); }
  .svc__sub { max-width: 640px; }

  .svc__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin-top: 0.4rem;
  }

  .svc__float-wrap {
    position: relative;
    margin-top: clamp(-9rem, -13vw, -7rem);
    z-index: 2;
  }

  .svc__float {
    max-width: 1120px;
    margin-inline: auto;
    padding: clamp(1.5rem, 3.5vw, 3rem);
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 3vw, 2.75rem);
    align-items: center;
  }

  .svc__metrics {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
  }
  .svc__metric {
    container-type: inline-size;
    height: 100%;
    padding: 1.1rem 1.15rem 1.2rem;
    border: var(--pm-border);
    border-radius: var(--pm-r);
    background: var(--pm-milk);
  }
  .svc__metric:nth-child(2) { background: var(--pm-yellow); }
  .svc__metric .pm-stat__value { font-size: clamp(1.1rem, 16cqi, 2.1rem); overflow-wrap: normal; hyphens: auto; }

  .svc__glance { display: grid; gap: 1rem; }
  .svc__glance-head { display: flex; align-items: center; gap: 0.85rem; }

  /* ── Generic section bits ─────────────────────────────────────────────── */
  .svc__intro-grid { align-items: center; gap: clamp(2rem, 5vw, 4.5rem); }
  .svc__intro-text { display: grid; gap: 1.1rem; justify-items: start; }
  .svc__intro-text .pm-text + .pm-text { margin-top: 0; }
