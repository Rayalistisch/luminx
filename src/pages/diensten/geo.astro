---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import ContactOverlay from "../../components/ContactOverlay.astro";
import Icon from "../../components/pm/Icon.astro";

const siteOrigin = Astro.site?.toString() ?? "https://luminx.nl";
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin).toString();

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "GEO – Generative Engine Optimization",
  description: "Zichtbaar worden in AI-antwoorden van ChatGPT, Gemini en Perplexity. We zorgen dat jouw expertise, merk en kennis worden opgepikt door generatieve AI-systemen.",
  serviceType: "Generative Engine Optimization",
  url: canonicalUrl,
  areaServed: "NL",
  provider: {
    "@type": "Organization",
    "@id": `${siteOrigin}/#organization`,
    name: "LUMINX",
    url: siteOrigin,
  },
};

const specialismen = [
  {
    icon: "message",
    tone: "",
    title: "Promptonderzoek",
    description: "Elke branche heeft een eigen set vragen die gebruikers aan AI stellen. Promptonderzoek brengt in kaart welke dat zijn, wie er nu wordt geciteerd en waar de kennisleemtes liggen.",
  },
  {
    icon: "file-text",
    tone: "pm-icon--pink",
    title: "Contentoptimalisatie voor AI",
    description: "AI-systemen selecteren bronnen op basis van helderheid, structuur en feitelijkheid. Content die daaraan voldoet wordt opgepikt. Content die alleen verkoopt, wordt overgeslagen.",
  },
  {
    icon: "code",
    tone: "pm-icon--yellow",
    title: "Structured data & schema",
    description: "Schema markup en entiteitsherkenning maken het voor AI-modellen mogelijk om een merk, product of expertise correct te classificeren en als bron te gebruiken.",
  },
  {
    icon: "quote",
    tone: "pm-icon--wine",
    title: "Citeerbare expertise",
    description: "AI-modellen citeren stellingen, definities en unieke data. Merken die originele inzichten publiceren worden vaker als bron geselecteerd dan merken die bestaande kennis herhalen.",
  },
  {
    icon: "award",
    tone: "pm-icon--pink",
    title: "Autoriteitsopbouw",
    description: "AI-systemen beoordelen betrouwbaarheid op basis van vermeldingen, backlinks en publicaties. Hoe vaker een merk als bron wordt gerefereerd, hoe zwaarder het weegt in AI-antwoorden.",
  },
  {
    icon: "chart",
    tone: "pm-icon--yellow",
    title: "AI-monitoring & rapportage",
    description: "AI-zichtbaarheid is meetbaar. Systematische monitoring toont aan of een merk wordt geciteerd in ChatGPT, Gemini en Perplexity, en waar bijsturing nodig is.",
  },
] as const;

const benefits = [
  {
    title: "Vroeg voordeel in een groeiend kanaal",
    body: "De meeste bedrijven richten zich uitsluitend op Google. AI-zoekmachines groeien elk kwartaal, maar de concurrentie is nog minimaal. Merken die nu autoriteit opbouwen bij AI-systemen, worden als eerste geciteerd zodra het kanaal mainstream wordt.",
  },
  {
    title: "GEO en SEO zijn geen losse strategieën",
    body: "Content die helder, citeerbaar en goed gestructureerd is, presteert beter in zowel Google als AI-antwoorden. Eén investering, twee kanalen. Bedrijven die GEO combineren met SEO zien een versterkend effect op beide.",
  },
  {
    title: "De verschuiving is al bezig",
    body: "Zoekopdrachten bewegen van Google naar AI-tools. Niet over vijf jaar, nu. Bedrijven die hun content en autoriteit nu opbouwen voor AI-consumptie, staan over twee jaar in een positie die concurrenten niet meer kunnen inhalen. Wachten is achteruitgang.",
  },
  {
    title: "Elke branche heeft andere AI-vragen",
    body: "Wat gebruikers aan ChatGPT vragen over juridisch advies verschilt fundamenteel van vragen over e-commerce of SaaS. Effectieve GEO begint met promptonderzoek per branche: welke vragen worden gesteld, wie wordt geciteerd, en waar liggen de kennisleemtes.",
  },
  {
    title: "AI-zichtbaarheid is meetbaar",
    body: "Het is een misverstand dat AI-zichtbaarheid niet te meten is. Via systematische monitoring is vast te stellen of een merk wordt geciteerd, hoe vaak, en in welke context. Zonder meting geen sturing.",
  },
];

const faq = [
  {
    q: "Wat is GEO precies?",
    a: "GEO staat voor Generative Engine Optimization. Het is het optimaliseren van jouw content, website en autoriteit zodat AI-tools zoals ChatGPT, Gemini en Perplexity jouw merk en expertise opnemen in hun antwoorden. Waar SEO focust op Google-rankings, richt GEO zich op zichtbaarheid in AI-gegenereerde antwoorden.",
  },
  {
    q: "Wat is het verschil tussen GEO en SEO?",
    a: "SEO gaat over ranken in zoekmachines via techniek, content en linkbuilding. GEO gaat een stap verder: in plaats van pagina's optimaliseren voor zoekwoorden, zorg je dat jouw expertise, kennis en merk worden opgepikt door AI-systemen. In de praktijk overlappen ze sterk: goede SEO is een fundament voor GEO, en GEO-content presteert ook beter in Google.",
  },
  {
    q: "Hoe lang duurt het voor GEO resultaat geeft?",
    a: "GEO is een langetermijnstrategie, vergelijkbaar met SEO. De eerste resultaten, zoals vaker geciteerd worden in AI-antwoorden, zijn doorgaans zichtbaar na drie tot zes maanden. Autoriteit en consistente zichtbaarheid bouwen zich op over zes tot twaalf maanden.",
  },
  {
    q: "Hoe meten jullie AI-zichtbaarheid?",
    a: "We testen systematisch welke vragen AI-tools beantwoorden in jouw branche, en of jouw merk of content daarin verschijnt. Dit doen we handmatig en met gespecialiseerde tools. Maandelijks rapporteren we over je voortgang en passen we de aanpak aan.",
  },
  {
    q: "Heb ik al een goede SEO nodig voor GEO?",
    a: "Een technisch gezonde website en bestaande content helpen enorm, maar je hoeft geen perfecte SEO-score te hebben. We beginnen altijd met een audit en stellen een prioriteitenlijst op: welke basis-SEO-elementen zijn nodig, en waar starten we met GEO-optimalisatie.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map(({ q, a }) => ({
    "@type": "Question",
    name: q,
    acceptedAnswer: { "@type": "Answer", text: a },
  })),
};

const heroMetrics = [
  { icon: "bot", value: "3+ kanalen", label: "ChatGPT, Gemini, Perplexity" },
  { icon: "zap", value: "Vroeg voordeel", label: "Weinig concurrentie nu" },
  { icon: "layers", value: "SEO + GEO", label: "Eén aanpak, twee kanalen" },
] as const;

const heroOutcomes = [
  "Het merk verschijnt als bron in AI-antwoorden over de branche",
  "Content wordt geselecteerd op basis van autoriteit en structuur",
  "Zichtbaarheid in een kanaal waar de meeste concurrenten nog afwezig zijn",
];

const resultStack = [
  { value: "AI-first", label: "Zoekopdrachten verschuiven" },
  { value: "3+ tools", label: "ChatGPT, Gemini, Perplexity" },
  { value: "Nu instappen", label: "Vroeg voordeel t.o.v. concurrenten" },
];

const steps = [
  {
    title: "AI-audit & promptonderzoek",
    body: "Eerste stap is inzicht: hoe behandelen AI-tools jouw branche? Welke vragen worden gesteld, wie wordt geciteerd en waar zijn de kennisleemtes? Zonder deze data is elke GEO-strategie giswerk.",
  },
  {
    title: "Strategie",
    body: "De audit bepaalt de prioriteiten: welke bestaande pagina's worden geoptimaliseerd, welke nieuwe content is nodig en welke structurele aanpassingen maken het verschil. Elke actie is gekoppeld aan een meetbaar doel.",
  },
  {
    title: "Implementatie",
    body: "Content wordt geoptimaliseerd op citeerbare helderheid, structured data wordt geïmplementeerd en autoriteit wordt opgebouwd via publicaties die AI-systemen als betrouwbaarheidssignaal gebruiken.",
  },
  {
    title: "Monitoren & bijsturen",
    body: "AI-zichtbaarheid wordt maandelijks gemeten: verschijnt het merk in relevante AI-antwoorden? In welke context? Met welke frequentie? Op basis van die data wordt de strategie aangescherpt.",
  },
];

const pains = [
  "Concurrenten worden geciteerd door AI, het eigen merk niet",
  "Content is geschreven voor Google, niet voor AI-consumptie",
  "Geen inzicht in welke vragen AI beantwoordt per branche",
  "Structured data ontbreekt of is incorrect geïmplementeerd",
  "AI-zichtbaarheid wordt niet gemeten, dus bijsturen is onmogelijk",
  "Afwachten terwijl early movers posities innemen die later niet meer beschikbaar zijn",
];

const gains = [
  "AI-audit met inzicht in hoe het merk, de concurrentie en de branche door AI worden behandeld",
  "Promptkaart met de exacte vragen die AI beantwoordt in de betreffende markt",
  "Content die voldoet aan de criteria die AI-systemen hanteren voor bronselectie",
  "Structured data die AI-modellen in staat stelt het merk correct te classificeren",
  "Autoriteitsopbouw via publicaties die als betrouwbaarheidssignaal functioneren",
  "Maandelijkse rapportage met meetbare voortgang op AI-zichtbaarheid",
];

const outcomes = [
  "Zichtbaarheid in ChatGPT-antwoorden",
  "Geciteerd door Gemini en Perplexity",
  "Sterke digitale autoriteit",
  "AI-geoptimaliseerde content",
  "Vroeg marktvoordeel",
  "Structured data correct geïmplementeerd",
  "Toekomstbestendige strategie",
  "Maandelijkse AI-zichtbaarheidsrapportage",
];

const related = [
  { href: "/vergelijk/geo-vs-seo", title: "GEO vs. SEO", desc: "Wanneer kies je AI-zichtbaarheid, wanneer zoekmachines?" },
  { href: "/diensten/seo", title: "SEO", desc: "Structurele zichtbaarheid in Google naast AI-antwoorden." },
  { href: "/diensten/strategy", title: "Digitale Strategie", desc: "GEO als onderdeel van een brede digitale groeistrategie." },
];
---

<BaseLayout
  title="GEO – AI Zichtbaarheid & Generative Engine Optimization | LuminX"
  description="Zichtbaar worden in ChatGPT, Gemini en Perplexity. LuminX optimaliseert jouw content en autoriteit zodat AI-systemen jouw merk en expertise opnemen in hun antwoorden."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(serviceSchema)}></script>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
  <Nav basePath="/" />

  <main class="svc">

    <!-- Hero -->
    <section class="svc__hero" aria-labelledby="svc-title">
      <div class="pm-stack">
        <span class="pm-stack__layer" aria-hidden="true"></span>
        <span class="pm-stack__layer" aria-hidden="true"></span>
        <span class="pm-stack__layer" aria-hidden="true"></span>

        <div class="pm-stack__panel svc__panel">
          <img class="pm-obj pm-obj--right" src="/images/3d/ai-chip.webp" width="1165" height="1290" alt="" aria-hidden="true" decoding="async" />
          <div class="svc__hero-content">
            <a href="/diensten/seo" class="svc__back" data-reveal>
              <Icon name="arrow" size={16} stroke={2.4} /> SEO
            </a>
            <span class="pm-tag svc__tag" data-reveal style="--d: 1"><Icon name="sparkles" size={16} /> Specialisme · AI-zichtbaarheid</span>
            <h1 id="svc-title" class="pm-h1 svc__title" data-reveal style="--d: 2">GEO</h1>
            <p class="pm-opening svc__sub" data-reveal style="--d: 3">
              Steeds meer zoekopdrachten worden beantwoord door AI in plaats van door Google. Merken die nu investeren in AI-zichtbaarheid bouwen een voorsprong op die later niet meer in te halen is. GEO is de discipline die dat mogelijk maakt.
            </p>
            <div class="svc__actions" data-reveal style="--d: 4">
              <a href="#contact" class="pm-btn pm-btn--yellow" data-overlay-open>Plan kennismaking <Icon name="arrow" /></a>
              <a href="#aanpak" class="pm-btn pm-btn--white">Bekijk aanpak</a>
            </div>
          </div>
        </div>
      </div>

      <div class="pm-container svc__float-wrap">
        <div class="pm-card pm-card--lift svc__float" data-reveal>
          <ul class="svc__metrics" aria-label="Kerncijfers">
            {heroMetrics.map((m, i) => (
              <li class="svc__metric" data-reveal style={`--d: ${i}`}>
                <span class:list={["pm-icon", "pm-icon--sm", i === 0 ? "" : i === 1 ? "pm-icon--yellow" : "pm-icon--pink"]} aria-hidden="true"><Icon name={m.icon} /></span>
                <span class="svc__metric-text">
                  <strong>{m.value}</strong>
                  <span>{m.label}</span>
                </span>
              </li>
            ))}
          </ul>
          <div class="svc__float-foot">
            <span class="pm-label">Wat GEO oplevert</span>
            <ul class="pm-checks svc__float-checks">
              {heroOutcomes.map((o) => <li>{o}</li>)}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Wat is GEO -->
    <section class="pm-section svc__what" aria-labelledby="what-title">
      <div class="pm-container pm-split svc__what-grid">
        <div class="svc__what-text">
          <header class="pm-head pm-head--left svc__head-left">
            <span class="pm-label" data-reveal>Wat is GEO?</span>
            <h2 id="what-title" class="pm-h2" data-reveal style="--d: 1">Zoekopdrachten verschuiven van Google naar AI</h2>
          </header>
          <p class="pm-text" data-reveal style="--d: 2">GEO staat voor Generative Engine Optimization. Waar SEO draait om posities in Google, richt GEO zich op zichtbaarheid in de antwoorden van ChatGPT, Gemini en Perplexity. Het verschil is fundamenteel: in Google concurreer je om een klikpositie, in AI concurreer je om geciteerd te worden als bron.</p>
          <p class="pm-text" data-reveal style="--d: 3">AI-systemen selecteren bronnen op basis van autoriteit, structuur en citeerbare expertise. Content die helder, feitelijk en goed gestructureerd is, wordt vaker opgepikt. Content die alleen verkoopt, wordt genegeerd. GEO en SEO zijn geen losse strategieën. Goede GEO-content presteert per definitie ook beter in Google.</p>
          <a href="#contact" class="pm-link svc__inline" data-overlay-open data-reveal style="--d: 4">Gratis GEO-analyse <Icon name="arrow" size={18} stroke={2.4} /></a>
        </div>

        <div class="pm-card pm-card--plum pm-card--lift svc__stack" aria-hidden="true" data-reveal style="--d: 1">
          <div class="svc__stack-head">
            <span class="pm-icon pm-icon--sm pm-icon--pink"><Icon name="sparkles" /></span>
            <span>GEO Optimalisaties</span>
          </div>
          <ol class="svc__stack-list">
            {resultStack.map((r, i) => (
              <li>
                <span class="svc__stack-num">0{i + 1}</span>
                <span class="svc__stack-body">
                  <strong>{r.value}</strong>
                  <span>{r.label}</span>
                </span>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <!-- Zes pijlers -->
    <section class="pm-section pm-band--paper svc__types" aria-labelledby="types-title">
      <div class="pm-container">
        <header class="pm-head">
          <span class="pm-label" data-reveal>Specialisme</span>
          <h2 id="types-title" class="pm-h2" data-reveal style="--d: 1">De zes pijlers van GEO</h2>
          <p class="pm-opening" data-reveal style="--d: 2">GEO bestaat uit zes disciplines die samen bepalen of een merk wel of niet wordt geciteerd door AI-systemen. Elk onderdeel heeft een eigen functie in het proces van onzichtbaar naar bron.</p>
        </header>
        <ul class="svc__grid">
          {specialismen.map((t, i) => (
            <li class="pm-card pm-card--milk pm-card--pad svc__tile" data-reveal style={`--d: ${i % 3}`}>
              <span class="svc__tile-top">
                <span class:list={["pm-icon", t.tone]}><Icon name={t.icon} /></span>
                <span class="svc__tile-num" aria-hidden="true">0{i + 1}</span>
              </span>
              <h3 class="pm-h3 svc__tile-title">{t.title}</h3>
              <p class="pm-text">{t.description}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Waarom GEO -->
    <section class="pm-section svc__benefits" aria-labelledby="benefits-title">
      <div class="pm-container pm-split svc__benefits-grid">
        <div class="svc__benefits-left">
          <header class="pm-head pm-head--left">
            <span class="pm-label" data-reveal>Waarom GEO?</span>
            <h2 id="benefits-title" class="pm-h2" data-reveal style="--d: 1">Waarom GEO nu relevant is voor elk bedrijf</h2>
            <p class="pm-opening" data-reveal style="--d: 2">Het zoekgedrag van consumenten verandert structureel. AI-tools beantwoorden steeds meer vragen die voorheen via Google gingen. Bedrijven die niet zichtbaar zijn in AI-antwoorden, verliezen een groeiend deel van hun potentiële bereik.</p>
          </header>
          <div class="svc__minis">
            <div class="pm-card pm-card--pink svc__mini" data-reveal style="--d: 3">
              <span class="pm-icon pm-icon--sm pm-icon--milk" aria-hidden="true"><Icon name="trending-up" /></span>
              <strong>Groeiend</strong>
              <span>AI-zoekopdrachten nemen elk kwartaal toe</span>
            </div>
            <div class="pm-card pm-card--yellow svc__mini" data-reveal style="--d: 4">
              <span class="pm-icon pm-icon--sm pm-icon--milk" aria-hidden="true"><Icon name="target" /></span>
              <strong>Weinig concurrentie</strong>
              <span>De meeste bureaus zijn hier nog niet mee bezig</span>
            </div>
          </div>
        </div>
        <ul class="pm-accordion" data-reveal style="--d: 1">
          {benefits.map((b, i) => (
            <li>
              <details class="pm-acc" name="geo-benefits" open={i === 0}>
                <summary>{b.title}</summary>
                <div class="pm-acc__body"><p>{b.body}</p></div>
              </details>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Aanpak -->
    <section class="pm-section pm-section--tight svc__approach" id="aanpak" aria-labelledby="approach-title">
      <div class="pm-container">
        <div class="pm-card pm-card--plum pm-card--lift svc__plum">
          <header class="pm-head pm-head--left svc__plum-head">
            <span class="pm-tag pm-tag--pink" data-reveal>Aanpak</span>
            <h2 id="approach-title" class="pm-h2" data-reveal style="--d: 1">Van onzichtbaar naar geciteerd in vier fases</h2>
          </header>
          <ol class="svc__timeline">
            {steps.map((s, i) => (
              <li class="svc__tl-step" data-reveal style={`--d: ${i}`}>
                <span class:list={["svc__tl-num", i === steps.length - 1 && "svc__tl-num--goal"]} aria-hidden="true">0{i + 1}</span>
                <div class="svc__tl-body">
                  <h3 class="svc__tl-title">{s.title}</h3>
                  <p>{s.body}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <!-- Fouten vs oplevering -->
    <section class="pm-section svc__compare" aria-label="Veelvoorkomende fouten en wat GEO oplevert">
      <div class="pm-container pm-split">
        <article class="pm-card pm-card--pink pm-card--pad svc__compare-card" data-reveal>
          <span class="pm-icon pm-icon--milk" aria-hidden="true"><Icon name="alert" /></span>
          <h2 class="pm-h3">Veelvoorkomende fouten bij GEO</h2>
          <ul class="pm-checks pm-checks--x">
            {pains.map((p) => <li>{p}</li>)}
          </ul>
        </article>
        <article class="pm-card pm-card--milk pm-card--lift pm-card--pad svc__compare-card" data-reveal style="--d: 1">
          <span class="pm-icon pm-icon--yellow" aria-hidden="true"><Icon name="check" /></span>
          <h2 class="pm-h3">Wat een GEO-traject oplevert</h2>
          <ul class="pm-checks">
            {gains.map((g) => <li>{g}</li>)}
          </ul>
        </article>
      </div>
    </section>

    <!-- Resultaten -->
    <section class="pm-section pm-section--tight pm-band--plum svc__outcomes" aria-labelledby="outcomes-title">
      <div class="pm-container">
        <header class="pm-head">
          <span class="pm-icon pm-icon--yellow" aria-hidden="true" data-reveal><Icon name="target" /></span>
          <h2 id="outcomes-title" class="pm-h2" data-reveal style="--d: 1">Resultaten die je mag verwachten</h2>
        </header>
        <ul class="svc__chips">
          {outcomes.map((o, i) => (
            <li class:list={["pm-tag", i % 3 === 0 ? "pm-tag--yellow" : i % 3 === 1 ? "pm-tag--paper" : "pm-tag--pink"]} data-reveal style={`--d: ${i % 4}`}>{o}</li>
          ))}
        </ul>
      </div>
    </section>

    <!-- FAQ -->
    <section class="pm-section svc__faq" aria-labelledby="faq-title">
      <div class="pm-container svc__faq-grid">
        <header class="pm-head pm-head--left svc__faq-head">
          <span class="pm-label" data-reveal>Veelgestelde vragen</span>
          <h2 id="faq-title" class="pm-h2" data-reveal style="--d: 1">Alles over GEO en AI-zichtbaarheid</h2>
          <p class="pm-text" data-reveal style="--d: 2">Staat jouw vraag er niet bij? Neem gerust contact op voor een vrijblijvend gesprek.</p>
          <a href="#contact" class="pm-btn pm-btn--white pm-btn--sm" data-overlay-open data-reveal style="--d: 3">Stel je vraag <Icon name="arrow" /></a>
        </header>
        <ul class="pm-accordion" data-reveal style="--d: 1">
          {faq.map((item, i) => (
            <li>
              <details class="pm-acc" name="geo-faq" open={i === 0}>
                <summary>{item.q}</summary>
                <div class="pm-acc__body"><p>{item.a}</p></div>
              </details>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Gerelateerd -->
    <section class="pm-section pm-section--tight svc__related" aria-labelledby="related-title">
      <div class="pm-container">
        <header class="pm-head pm-head--left">
          <span id="related-title" class="pm-label">Gerelateerd</span>
        </header>
        <ul class="svc__related-grid">
          {related.map((r, i) => (
            <li data-reveal style={`--d: ${i}`}>
              <a href={r.href} class="pm-card svc__related-card">
                <span class="svc__related-text">
                  <strong>{r.title}</strong>
                  <span>{r.desc}</span>
                </span>
                <span class="svc__arrow" aria-hidden="true"><Icon name="arrow" size={18} stroke={2.4} /></span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- CTA -->
    <section class="pm-band svc__cta" id="contact" aria-labelledby="cta-title">
      <div class="pm-container svc__cta-inner">
        <span class="pm-icon pm-icon--yellow" aria-hidden="true" data-reveal><Icon name="sparkles" /></span>
        <h2 id="cta-title" class="pm-h2 pm-outline svc__cta-title" data-reveal style="--d: 1">Klaar om zichtbaar te worden in AI-antwoorden?</h2>
