---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import ContactOverlay from "../../components/ContactOverlay.astro";
import Icon from "../../components/pm/Icon.astro";

const siteOrigin = Astro.site?.toString() ?? "https://luminx.nl";
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin).toString();

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Google Consent Mode v2 Implementatie",
  description: "DMA-conforme Consent Mode v2 implementatie die juridisch waterdicht is en jouw datakwaliteit maximaliseert. Verplicht voor alle Nederlandse websites met Google Ads of GA4.",
  serviceType: "Privacy Compliance",
  url: canonicalUrl,
  areaServed: "NL",
  provider: {
    "@type": "Organization",
    "@id": `${siteOrigin}/#organization`,
    name: "LUMINX",
    url: siteOrigin,
  },
};

const metrics = [
  { value: "Verplicht", label: "Sinds maart 2024 (DMA)" },
  { value: "4 parameters", label: "Correct configureren" },
  { value: "Advanced Mode", label: "Max. dataherstel" },
];

const beschermt = [
  "Remarketing-audiences voor EER-bezoekers",
  "GA4-data van Nederlandse bezoekers",
  "Compliance met DMA en GDPR",
];

const specialismen = [
  {
    icon: "globe",
    tone: "",
    title: "Regiogebaseerde standaardinstellingen",
    description: "EER-landen standaard op 'denied' totdat de bezoeker toestemming geeft. Overige regio's standaard op 'granted'. Correct geconfigureerd via GTM met de juiste parameterlijst.",
  },
  {
    icon: "cookie",
    tone: "pm-icon--pink",
    title: "Cookiebanner integratie",
    description: "Koppeling van Consent Mode v2 aan jouw bestaande cookiebanner of CMP, zodat gebruikerstoestemming automatisch doorgestuurd wordt naar Google's toestemmingssignalen.",
  },
  {
    icon: "sliders",
    tone: "pm-icon--yellow",
    title: "Alle vier de toestemmingsparameters",
    description: "Correcte configuratie van ad_storage, analytics_storage, ad_user_data én ad_personalization, de vier parameters die verplicht zijn onder DMA en Consent Mode v2.",
  },
  {
    icon: "zap",
    tone: "pm-icon--wine",
    title: "Advanced Mode configuratie",
    description: "Implementatie in Advanced Mode zodat GA4 en Google Ads anonieme signaaldata kunnen ontvangen van bezoekers die tracking weigeren, voor betere conversiemodellering.",
  },
  {
    icon: "shield",
    tone: "",
    title: "Validatie & compliance-check",
    description: "Volledige validatie via de Google Tag Assistant, Consent Mode debugger en handmatige verificatie dat de toestemmingssignalen correct doorgestuurd worden.",
  },
  {
    icon: "search",
    tone: "pm-icon--pink",
    title: "Consent Mode audit",
    description: "Voor websites met een bestaande Consent Mode setup: beoordeling of de configuratie correct is, volledig en DMA-compliant, inclusief veelgemaakte fouten zoals onjuiste regio-parameters.",
  },
];

const gevolgen = [
  "Geen remarketing-audiences voor EER-gebruikers in Google Ads",
  "Geen GA4-data van nieuwe bezoekers uit Nederland en Europa",
  "Verlies van Google Ads conversie-optimalisatie voor EU-verkeer",
  "Historische data is permanent verloren: geen backfill mogelijk",
  "Risico op non-compliance met de Digital Markets Act (DMA)",
  "Onjuiste rapportage door ontbrekende EER-datapunten",
];

const fouten = [
  "Consent Mode ingesteld voor alle regio's als \"denied\", ook buiten EER",
  "Consent Mode ingesteld voor alle regio's als \"granted\", ook voor EER (GDPR-risico)",
  "Cookiebanner werkt visueel maar stuurt geen signalen door naar GTM",
  "Alleen de twee oude parameters geconfigureerd, ad_user_data en ad_personalization ontbreken",
  "Basic Mode in plaats van Advanced Mode: minder modellering",
  "Consent Mode aanwezig maar nooit gevalideerd of getest",
];

const opleveringen = [
  "Regiogebaseerde Consent Mode v2 correct in GTM geconfigureerd",
  "Alle vier DMA-verplichte parameters correct ingesteld",
  "Integratie met bestaande cookiebanner of CMP",
  "Advanced Mode voor maximale data-modellering",
  "Validatierapport met bewijs van correcte werking",
  "Documentatie voor jouw team en eventuele audits",
];

const steps = [
  { title: "Audit van huidige situatie", body: "Beoordeling van bestaande Consent Mode configuratie, cookiebanner-integratie en GTM-container. Welke parameters zijn aanwezig, kloppen ze, en wat ontbreekt?" },
  { title: "Implementatie & integratie", body: "Regiogebaseerde configuratie in GTM, alle vier verplichte parameters instellen, Advanced Mode activeren en cookiebanner technisch koppelen aan toestemmingssignalen." },
  { title: "Validatie & documentatie", body: "Verificatie via Google Tag Assistant en Consent Mode debugger. Validatierapport opstellen en volledige documentatie voor jouw team en eventuele compliance-audits." },
];

const faq = [
  {
    q: "Is Consent Mode v2 verplicht voor mijn website?",
    a: "Ja, als je Google Ads of GA4 gebruikt en bezoekers target in de EER (waaronder Nederland). Consent Mode v2 is verplicht gesteld door Google in het kader van de Digital Markets Act. Zonder correcte implementatie worden geen GA4-data verzameld en geen remarketing-audiences gevuld voor EER-bezoekers.",
  },
  {
    q: "Wat zijn de nieuwe parameters in Consent Mode v2?",
    a: "Consent Mode v2 introduceert twee nieuwe verplichte parameters naast de bestaande: ad_user_data (toestemming voor het sturen van gebruikersdata naar Google voor advertenties) en ad_personalization (toestemming voor gepersonaliseerde advertenties). Beide moeten correct zijn geconfigureerd.",
  },
  {
    q: "Wat is het verschil tussen Basic Mode en Advanced Mode?",
    a: "In Basic Mode worden tracking-tags pas geladen na toestemming van de gebruiker. In Advanced Mode worden tags altijd geladen maar zonder identificerende data bij geweigerde toestemming: dit maakt conversiemodellering via AI mogelijk. Advanced Mode geeft meer data en betere modellering.",
  },
  {
    q: "Ik heb al een cookiebanner. Is dat genoeg?",
    a: "Een cookiebanner alleen is niet genoeg. De banner moet technisch verbonden zijn met Consent Mode v2 zodat de toestemmingssignalen correct naar Google worden doorgestuurd. Veel websites hebben een banner die visueel werkt maar technisch geen correcte signalen doorgeeft.",
  },
  {
    q: "Verlies ik data van bezoekers die tracking weigeren?",
    a: "Met Advanced Mode verlies je minder data dan je denkt. Google kan via AI-gebaseerde conversiemodellering tot 65-70% van verloren data reconstrueren als er voldoende toestemmingsdata beschikbaar is als referentie. Dit werkt alleen als Consent Mode correct in Advanced Mode is geconfigureerd.",
  },
];

const outcomes = [
  "DMA & GDPR-compliant",
  "Remarketing-audiences voor EER",
  "Maximale GA4-dataverzameling",
  "Advanced Mode modellering",
  "Gevalideerde configuratie",
  "Volledig gedocumenteerd",
  "Geen compliance-risico's",
  "Betrouwbare Google Ads sturing",
];

const reads = [
  { href: "/diensten/ga4-implementatie", title: "GA4 Implementatie", body: "Betrouwbare analytics naast correcte Consent Mode-configuratie." },
  { href: "/diensten/google-tag-manager", title: "Google Tag Manager", body: "De container die Consent Mode v2 correct moet afvuren." },
];

const pillTones = ["pm-tag--yellow", "pm-tag--pink", "", "pm-tag--paper"];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map(({ q, a }) => ({
    "@type": "Question",
    name: q,
    acceptedAnswer: { "@type": "Answer", text: a },
  })),
};
---

<BaseLayout
  title="Consent Mode v2 Implementatie | LuminX Twente"
  description="DMA-conforme Consent Mode v2 implementatie voor Nederlandse websites. Juridisch waterdicht en maximale datakwaliteit via correcte GTM-configuratie."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(serviceSchema)}></script>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
  <Nav basePath="/" />

  <main class="svc">

    <!-- Hero -->
    <section class="svc__hero" aria-labelledby="svc-title">
      <div class="pm-stack">
        <span class="pm-stack__layer" aria-hidden="true"></span>
        <span class="pm-stack__layer" aria-hidden="true"></span>
        <span class="pm-stack__layer" aria-hidden="true"></span>
        <div class="pm-stack__panel svc__panel">
          <div class="svc__hero-content">
            <a href="/diensten/google-tag-manager" class="svc__back" data-reveal><Icon name="arrow" size={16} /> Google Tag Manager</a>
            <span class="pm-tag pm-tag--pink" data-reveal style="--d: 1">Compliance & Tracking</span>
            <h1 id="svc-title" class="pm-h1 svc__title" data-reveal style="--d: 2">Consent Mode v2</h1>
            <p class="pm-opening svc__sub" data-reveal style="--d: 3">Verplicht voor elke Nederlandse website met Google Ads of GA4. Wij implementeren Consent Mode v2 correct, zodat je juridisch compliant bent én maximale data behoudt.</p>
            <div class="svc__actions" data-reveal style="--d: 4">
              <a href="#contact" class="pm-btn pm-btn--yellow" data-overlay-open>Plan kennismaking <Icon name="arrow" /></a>
              <a href="#gevolgen" class="pm-btn pm-btn--white">Wat staat er op het spel?</a>
            </div>
          </div>
        </div>
      </div>

      <div class="pm-container svc__float-wrap">
        <div class="pm-card pm-card--lift svc__float" data-reveal>
          <ul class="svc__metrics">
            {metrics.map((m) => (
              <li class="pm-stat svc__metric">
                <strong class="pm-stat__value">{m.value}</strong>
                <span class="pm-stat__label">{m.label}</span>
              </li>
            ))}
          </ul>
          <div class="svc__glance">
            <div class="svc__glance-head">
              <span class="pm-icon pm-icon--sm" aria-hidden="true"><Icon name="shield" /></span>
              <span class="pm-label">Wat je beschermt</span>
            </div>
            <ul class="pm-checks">
              {beschermt.map((d) => <li>{d}</li>)}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Urgentie -->
    <section class="pm-section" id="gevolgen" aria-labelledby="cm-urgency-title">
      <div class="pm-container pm-split svc__intro-grid">
        <div class="svc__intro-text">
          <span class="pm-label" data-reveal>Waarom dit urgent is</span>
          <h2 id="cm-urgency-title" class="pm-h2" data-reveal style="--d: 1">Zonder Consent Mode v2 verlies je data: permanent</h2>
          <p class="pm-text" data-reveal style="--d: 2">Consent Mode v2 is niet optioneel. Websites die Google Ads of GA4 gebruiken en bezoekers targeten in de EER zijn verplicht om Consent Mode v2 te implementeren als onderdeel van de Digital Markets Act.</p>
          <p class="pm-text" data-reveal style="--d: 3">De gevolgen van een incorrecte of ontbrekende implementatie zijn direct en onomkeerbaar. Gemiste data kan achteraf niet worden teruggehaald.</p>
        </div>
        <div class="pm-card pm-card--pink pm-card--lift svc__feature" data-reveal style="--d: 2">
          <div class="svc__duo-head">
            <span class="pm-icon pm-icon--milk" aria-hidden="true"><Icon name="alert" /></span>
            <h3 class="pm-h3">Gevolgen bij incorrecte implementatie</h3>
          </div>
          <ul class="pm-checks pm-checks--x svc__checks-ink">
            {gevolgen.map((g) => <li>{g}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <!-- Wat wij implementeren -->
    <section class="pm-section pm-section--tight" aria-labelledby="cm-services-title">
      <div class="pm-container">
        <header class="pm-head">
          <span class="pm-label" data-reveal>Wat wij implementeren</span>
          <h2 id="cm-services-title" class="pm-h2" data-reveal style="--d: 1">Een correcte Consent Mode v2 van begin tot eind</h2>
          <p class="pm-opening" data-reveal style="--d: 2">Wij zorgen dat jouw Consent Mode v2 niet alleen visueel correct is, maar technisch waterdicht, gevalideerd, gedocumenteerd en DMA-compliant.</p>
        </header>
        <ul class="svc__grid">
          {specialismen.map((item, i) => (
            <li data-reveal style={`--d: ${i % 3}`}>
              <article class="pm-card svc__tile">
                <span class:list={["pm-icon", item.tone]} aria-hidden="true"><Icon name={item.icon} /></span>
                <h3 class="pm-h3">{item.title}</h3>
                <p class="pm-text">{item.description}</p>
              </article>
            </li>
          ))}
        </ul>

        <figure class="pm-card pm-card--milk pm-card--lift svc__readout svc__config" data-reveal>
          <div class="svc__readout-bar" aria-hidden="true"><i></i><i></i><i></i><span>consent-default.js</span></div>
          <pre class="svc__code"><code><span>gtag(<em>'consent'</em>, <em>'default'</em>, {'{'}</span>
  <b>ad_storage</b>: <em>'denied'</em>,
  <b>analytics_storage</b>: <em>'denied'</em>,
  <b>ad_user_data</b>: <em>'denied'</em>,
  <b>ad_personalization</b>: <em>'denied'</em>,
  <b>region</b>: [<em>'NL'</em>, <em>'BE'</em>, <em>'DE'</em>, …]  <span class="svc__code-note">// EER</span>
{'}'});
gtag(<em>'consent'</em>, <em>'default'</em>, {'{'}
  <b>ad_storage</b>: <em>'granted'</em>,  <span class="svc__code-note">// overige regio's</span>
  …
{'}'});</code></pre>
          <figcaption class="svc__config-cap">Regiogebaseerd: EER-landen standaard op 'denied' totdat de bezoeker toestemming geeft, overige regio's op 'granted', met alle vier de DMA-parameters.</figcaption>
        </figure>
      </div>
    </section>

    <!-- Context -->
    <section class="pm-section" aria-label="Veelgemaakte fouten en oplevering">
      <div class="pm-container pm-split svc__duo">
        <article class="pm-card" data-reveal>
          <div class="svc__duo-head">
            <span class="pm-icon pm-icon--pink" aria-hidden="true"><Icon name="x" /></span>
            <h2 class="pm-h2">Veelgemaakte fouten die we tegenkomen</h2>
          </div>
          <ul class="pm-checks pm-checks--x">
            {fouten.map((p) => <li>{p}</li>)}
          </ul>
        </article>
        <article class="pm-card pm-card--milk pm-card--lift" data-reveal style="--d: 1">
          <div class="svc__duo-head">
            <span class="pm-icon pm-icon--yellow" aria-hidden="true"><Icon name="check" /></span>
            <h2 class="pm-h2">Wat wij opleveren</h2>
          </div>
          <ul class="pm-checks">
            {opleveringen.map((o) => <li>{o}</li>)}
          </ul>
        </article>
      </div>
    </section>

    <!-- Aanpak -->
    <section class="pm-section pm-section--tight" aria-labelledby="cm-approach-title">
      <div class="pm-container">
        <div class="pm-card pm-card--plum pm-card--lift svc__steps-card">
          <header class="pm-head">
            <span class="pm-tag pm-tag--pink" data-reveal>Aanpak</span>
            <h2 id="cm-approach-title" class="pm-h2" data-reveal style="--d: 1">Van compliance-risico naar waterdichte configuratie in drie stappen.</h2>
          </header>
          <ol class="svc__steps" style="--steps: 3">
            {steps.map((s, i) => (
              <li class="svc__step" data-reveal style={`--d: ${i}`}>
                <span class="pm-icon pm-icon--yellow svc__step-num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
                <h3 class="pm-h3">{s.title}</h3>
                <p>{s.body}</p>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="pm-section" aria-labelledby="cm-faq-title">
      <div class="pm-container pm-container--narrow">
        <header class="pm-head svc__faq-head">
          <span class="pm-label" data-reveal>Veelgestelde vragen</span>
          <h2 id="cm-faq-title" class="pm-h2" data-reveal style="--d: 1">Alles over Consent Mode v2</h2>
          <p class="pm-opening" data-reveal style="--d: 2">Staat jouw vraag er niet bij? Neem gerust contact op voor een vrijblijvend gesprek.</p>
          <a href="#contact" class="pm-link" data-overlay-open data-reveal style="--d: 3">Stel je vraag <Icon name="arrow" size={18} /></a>
        </header>
        <ul class="pm-accordion" data-reveal>
          {faq.map((item, i) => (
            <li>
              <details class="pm-acc" name="cm-faq" open={i === 0}>
                <summary>{item.q}</summary>
                <div class="pm-acc__body"><p>{item.a}</p></div>
              </details>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Resultaten -->
    <section class="pm-band pm-band--paper pm-section pm-section--tight" aria-labelledby="cm-outcomes-title">
      <div class="pm-container svc__outcomes-inner">
        <h2 id="cm-outcomes-title" class="pm-h2" data-reveal>Resultaten die je mag verwachten</h2>
        <ul class="svc__pills">
          {outcomes.map((o, i) => (
            <li data-reveal style={`--d: ${i}`}><span class:list={["pm-tag", pillTones[i % pillTones.length]]}>{o}</span></li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Gerelateerde diensten -->
    <section class="pm-section pm-section--tight" aria-label="Gerelateerde diensten">
      <div class="pm-container">
        <span class="pm-label svc__reads-label">Gerelateerde diensten</span>
        <ul class="svc__reads">
          {reads.map((r, i) => (
            <li data-reveal style={`--d: ${i}`}>
              <a href={r.href} class="pm-card pm-card--milk svc__read">
                <span><strong>{r.title}</strong><small>{r.body}</small></span>
                <Icon name="arrow" />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- CTA -->
    <section class="pm-band svc__cta" id="contact" aria-labelledby="cm-cta-title">
      <div class="pm-container svc__cta-inner">
        <h2 id="cm-cta-title" class="pm-h2 pm-outline svc__cta-title" data-reveal>Is jouw Consent Mode v2 correct geconfigureerd?</h2>
        <p class="pm-opening svc__cta-text" data-reveal style="--d: 1">Wij checken jouw huidige configuratie gratis en laten zien of je compliant bent, en wat er ontbreekt als dat niet het geval is.</p>
        <a href="#" class="pm-btn pm-btn--yellow" data-overlay-open data-reveal style="--d: 2">Gratis compliance-check <Icon name="arrow" /></a>
      </div>
    </section>
  </main>

  <Footer />
  <ContactOverlay />
</BaseLayout>

<style>
  /* ── Hero: stacked plum panel + overlapping "at a glance" card ───────── */
  .svc__hero { position: relative; padding-top: 72px; }

  .svc__panel {
    padding: clamp(4.5rem, 8vw, 6.5rem) var(--pm-gutter) clamp(10rem, 17vw, 13rem);
  }

  .svc__hero-content {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 1.4rem;
    max-width: 920px;
    margin-inline: auto;
  }

  .svc__back {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--pm-milk);
    font-size: 0.875rem;
    font-weight: 700;
    text-decoration: none;
    opacity: 0.85;
    transition: opacity 0.25s ease;
  }
  .svc__back svg { transform: rotate(180deg); }
  @media (hover: hover) { .svc__back:hover { opacity: 1; } }

  .svc__title { color: var(--pm-milk); }
  .svc__sub { max-width: 640px; }

  .svc__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin-top: 0.4rem;
  }

  .svc__float-wrap {
    position: relative;
    margin-top: clamp(-9rem, -13vw, -7rem);
    z-index: 2;
  }

  .svc__float {
    max-width: 1120px;
    margin-inline: auto;
    padding: clamp(1.5rem, 3.5vw, 3rem);
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 3vw, 2.75rem);
    align-items: center;
  }

  .svc__metrics {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
  }
  .svc__metric {
    container-type: inline-size;
    height: 100%;
    padding: 1.1rem 1.15rem 1.2rem;
    border: var(--pm-border);
    border-radius: var(--pm-r);
    background: var(--pm-milk);
  }
  .svc__metric:nth-child(2) { background: var(--pm-yellow); }
  .svc__metric .pm-stat__value { font-size: clamp(1.1rem, 16cqi, 2.1rem); overflow-wrap: normal; hyphens: auto; }

  .svc__glance { display: grid; gap: 1rem; }
  .svc__glance-head { display: flex; align-items: center; gap: 0.85rem; }

  /* ── Generic section bits ─────────────────────────────────────────────── */
  .svc__intro-grid { align-items: center; gap: clamp(2rem, 5vw, 4.5rem); }
  .svc__intro-text { display: grid; gap: 1.1rem; justify-items: start; }
  .svc__intro-text .pm-text + .pm-text { margin-top: 0; }
  .svc__intro-text .pm-link { margin-top: 0.4rem; }

  /* readout card: monospace stat panel (tracking family) */
  .svc__readout {
    margin: 0;
    background: var(--pm-milk);
  }
  .svc__readout-bar {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.85rem 1.25rem;
    border-bottom: var(--pm-border);
    background: var(--pm-paper);
  }
  .svc__readout-bar i {
    width: 12px;
    height: 12px;
    border: var(--pm-border);
    border-radius: 50%;
    background: var(--pm-pink);
  }
  .svc__readout-bar i:nth-child(2) { background: var(--pm-yellow); }
  .svc__readout-bar i:nth-child(3) { background: var(--pm-milk); }
  .svc__readout-bar span {
    margin-left: auto;
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--pm-ink-soft);
  }
  .svc__readout-list { list-style: none; margin: 0; padding: 0; }
  .svc__readout-list li {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: baseline;
    gap: 0.3rem 1.25rem;
    padding: 1.4rem 1.5rem;
  }
  .svc__readout-list li + li { border-top: 2px dashed var(--pm-ink-line); }
  .svc__readout-list strong {
    font-family: var(--pm-display);
    font-weight: 400;
    font-size: clamp(2.2rem, 3.6vw, 3rem);
    line-height: 1;
    color: var(--pm-wine);
  }
  .svc__readout-list span {
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    font-size: 0.85rem;
    line-height: 1.45;
