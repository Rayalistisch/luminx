---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import ContactOverlay from "../../components/ContactOverlay.astro";
import Icon from "../../components/pm/Icon.astro";

const siteOrigin = Astro.site?.toString() ?? "https://luminx.nl";
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin).toString();

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Google Analytics 4 Implementatie",
  description: "Volledige GA4-implementatie met event tracking, conversies en rapportage afgestemd op jouw KPI's. Betrouwbare analytics als basis voor betere beslissingen.",
  serviceType: "Web Analytics",
  url: canonicalUrl,
  areaServed: "NL",
  provider: {
    "@type": "Organization",
    "@id": `${siteOrigin}/#organization`,
    name: "LUMINX",
    url: siteOrigin,
  },
};

const metrics = [
  { value: "1–2 weken", label: "Volledige implementatie" },
  { value: "100%", label: "Correcte conversiedata" },
  { value: "Via GTM", label: "Geen codewijzigingen" },
];

const direct = [
  "Inzicht in welke kanalen daadwerkelijk converteren",
  "Doelgroepen voor remarketing op basis van gedrag",
  "Betere Google Ads sturing via conversiekoppeling",
];

const readout = [
  { value: "91%", label: "van marketeers beschouwt data als cruciaal voor succes" },
  { value: "+24%", label: "nauwkeuriger ROI-meting na correcte GA4 attributie" },
  { value: "+35%", label: "hogere conversieratio na data-gedreven bijsturing" },
];

const specialismen = [
  {
    icon: "layers",
    tone: "",
    title: "GA4-implementatie via GTM",
    description: "Volledige inrichting van GA4 via Google Tag Manager: property aanmaken, configuratietag instellen, datastream koppelen en eerste events valideren.",
  },
  {
    icon: "zap",
    tone: "pm-icon--pink",
    title: "Event tracking op maat",
    description: "Alle relevante interacties bijhouden die standaard GA4 mist: formulierinzendingen, knoppen, downloads, scroll-diepte, videoweergaven en pagina-engagement.",
  },
  {
    icon: "target",
    tone: "pm-icon--yellow",
    title: "Conversie-inrichting",
    description: "Sleutelevenementen instellen als conversie in GA4, zodat je rapportage direct laat zien welke kanalen en pagina's bijdragen aan jouw bedrijfsdoelen.",
  },
  {
    icon: "users",
    tone: "pm-icon--wine",
    title: "Audience & remarketinglijsten",
    description: "Op basis van gedrag in GA4 doelgroepen opbouwen voor Google Ads remarketing: paginabezoekers, formulierstarters, high-intent gebruikers en meer.",
  },
  {
    icon: "chart",
    tone: "",
    title: "GA4 rapportage & dashboards",
    description: "Configuratie van standaardrapportages en aangepaste verkenners zodat je direct antwoord krijgt op vragen over acquisitie, gedrag en conversie.",
  },
  {
    icon: "refresh",
    tone: "pm-icon--pink",
    title: "Migratie van UA naar GA4",
    description: "Als je nog werkt met Universal Analytics-data of een verouderde GA4-inrichting: we brengen de historische context in kaart en zetten een toekomstbestendige setup op.",
  },
];

const benefits = [
  {
    title: "GA4 meet standaard heel weinig, zonder inrichting ben je blind",
    body: "Standaard GA4 registreert paginaweergaven en sessies, maar geen formuliersubmissies, klikken op knoppen of andere conversie-events. Zonder correcte inrichting zie je drukte maar geen richting.",
  },
  {
    title: "Inzicht in de volledige klantreis over kanalen heen",
    body: "GA4 is gebouwd op events en gebruikt een session-onafhankelijk model. Daardoor kun je de volledige klantreis volgen van eerste touchpoint tot conversie, ook als iemand meerdere sessies en apparaten gebruikt.",
  },
  {
    title: "Directe koppeling met Google Ads voor betere campagnesturing",
    body: "Een GA4-property gekoppeld aan Google Ads deelt conversiedata en doelgroepen automatisch. Jouw biedstrategieën optimaliseren dan op echte conversies in plaats van op klikken of sessiemetrics.",
  },
  {
    title: "Privacybestendig en klaar voor een cookieloze toekomst",
    body: "GA4 is ontworpen met privacy-first principes: server-side meting, IP-anonimisering en modellering bij ontbrekende toestemmingsdata. Gecombineerd met Consent Mode v2 haal je maximale data binnen de privacyregels.",
  },
];

const steps = [
  { title: "Intake & analyse", body: "Inventarisatie van bestaande analytics-setup, bedrijfsdoelen en KPI's. Welke conversies zijn kritiek? Welke doelgroepen wil je opbouwen? Wat ontbreekt in huidige rapportage?" },
  { title: "Implementatie via GTM", body: "GA4 configuratietag en event tags instellen via GTM. Alle relevante interacties als events inrichten op basis van de inventarisatie, zonder codewijzigingen in je website." },
  { title: "Validatie & conversies", body: "Validatie via GA4 DebugView en GTM preview. Sleutelevenementen instellen als conversie, koppeling met Google Ads activeren en remarketingdoelgroepen aanmaken." },
  { title: "Rapportage & overdracht", body: "Standaard- en aangepaste rapporten inrichten, documentatie opstellen en jouw team overdragen. Daarna continue beschikbaarheid voor uitbreidingen en optimalisaties." },
];

const problemen = [
  "GA4 geïnstalleerd maar geen enkel conversie-event ingesteld",
  "Dubbele tracking via zowel GTM als hardcoded tag",
  "Formuliersubmissies worden niet gemeten",
  "Geen koppeling met Google Ads account",
  "Geen remarketingdoelgroepen aangemaakt",
  "Rapporten tonen data maar geen bruikbaar inzicht",
];

const opleveringen = [
  "Correcte GA4-inrichting via GTM zonder codewijzigingen",
  "Alle relevante events en conversies geconfigureerd",
  "Koppeling met Google Ads voor gedeelde conversiedata",
  "Remarketingdoelgroepen op basis van gedrag",
  "Aangepaste rapporten op jouw KPI's",
  "Volledige documentatie en overdracht aan jouw team",
];

const faq = [
  {
    q: "Is GA4 verplicht?",
    a: "Universal Analytics is definitief stopgezet. Elke website die analytics gebruikt, werkt nu op GA4. De vraag is alleen of jouw GA4-implementatie correct is ingericht: standaard mist GA4 vrijwel alle zinvolle conversie-events.",
  },
  {
    q: "Wat meet GA4 automatisch en wat moet ik zelf instellen?",
    a: "GA4 meet automatisch paginaweergaven, scroll-diepte (90%), outbound clicks en file downloads. Formulierinzendingen, knoppen, telefoneren, offerte-aanvragen en andere conversie-events moet je zelf configureren via GTM of de GA4 tag.",
  },
  {
    q: "Hoe lang duurt een volledige GA4-implementatie?",
    a: "Een basisimplementatie met events en conversies is doorgaans binnen één tot twee werkweken gerealiseerd. Complexere setups met e-commerce tracking, datalagen of meerdere properties vragen meer tijd.",
  },
  {
    q: "Kan ik GA4 koppelen aan mijn Google Ads-account?",
    a: "Ja, en dit is sterk aanbevolen. Via de koppeling worden conversiedata en GA4-doelgroepen automatisch beschikbaar in Google Ads. Je biedstrategie optimaliseert dan op echte resultaten.",
  },
  {
    q: "Wat is het verschil tussen een event en een conversie in GA4?",
    a: "Elk gebruikersinteractie is een event in GA4. Een conversie is een event dat je als 'sleutelevenement' markeert omdat het een bedrijfsdoel vertegenwoordigt, zoals een formulierinzending of telefoneren. Conversies tellen zwaarder in rapportage en sturen biedstrategieën.",
  },
];

const outcomes = [
  "Correcte conversiedata",
  "Inzicht in kanaalrendement",
  "Betere Google Ads sturing",
  "Remarketingdoelgroepen op gedrag",
  "Betrouwbare rapportage",
  "Geen dubbele tracking",
  "Snellere marketingbeslissingen",
  "Fundament voor schaalbare groei",
];

const reads = [
  { href: "/diensten/google-tag-manager", title: "Google Tag Manager", body: "De container waaruit GA4 zijn data haalt." },
  { href: "/diensten/consent-mode-v2", title: "Consent Mode v2", body: "GDPR-compliant meten zonder dataverlies." },
  { href: "/tracking-audit", title: "Gratis Tracking-audit", body: "Ontdek wat jouw GA4-implementatie nu mist." },
];

const pillTones = ["pm-tag--yellow", "pm-tag--pink", "", "pm-tag--paper"];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map(({ q, a }) => ({
    "@type": "Question",
    name: q,
    acceptedAnswer: { "@type": "Answer", text: a },
  })),
};
---

<BaseLayout
  title="Google Analytics 4 Implementatie | LuminX Twente"
  description="Volledige GA4-implementatie met event tracking, conversies en rapportage. Betrouwbare analytics als basis voor betere marketingbeslissingen."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(serviceSchema)}></script>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
  <Nav basePath="/" />

  <main class="svc">

    <!-- Hero -->
    <section class="svc__hero" aria-labelledby="svc-title">
      <div class="pm-stack">
        <span class="pm-stack__layer" aria-hidden="true"></span>
        <span class="pm-stack__layer" aria-hidden="true"></span>
        <span class="pm-stack__layer" aria-hidden="true"></span>
        <div class="pm-stack__panel svc__panel">
          <div class="svc__hero-content">
            <a href="/diensten/google-tag-manager" class="svc__back" data-reveal><Icon name="arrow" size={16} /> Google Tag Manager</a>
            <span class="pm-tag pm-tag--pink" data-reveal style="--d: 1">Specialisme</span>
            <h1 id="svc-title" class="pm-h1 svc__title" data-reveal style="--d: 2">GA4 Implementatie</h1>
            <p class="pm-opening svc__sub" data-reveal style="--d: 3">Standaard GA4 meet bijna niets. Wij richten jouw Google Analytics 4 correct in, met event tracking, conversies en rapportage die echt inzicht geven in wat jouw marketing oplevert.</p>
            <div class="svc__actions" data-reveal style="--d: 4">
              <a href="#contact" class="pm-btn pm-btn--yellow" data-overlay-open>Plan kennismaking <Icon name="arrow" /></a>
              <a href="#aanpak" class="pm-btn pm-btn--white">Bekijk aanpak</a>
            </div>
          </div>
        </div>
      </div>

      <div class="pm-container svc__float-wrap">
        <div class="pm-card pm-card--lift svc__float" data-reveal>
          <ul class="svc__metrics">
            {metrics.map((m) => (
              <li class="pm-stat svc__metric">
                <strong class="pm-stat__value">{m.value}</strong>
                <span class="pm-stat__label">{m.label}</span>
              </li>
            ))}
          </ul>
          <div class="svc__glance">
            <div class="svc__glance-head">
              <span class="pm-icon pm-icon--sm" aria-hidden="true"><Icon name="chart" /></span>
              <span class="pm-label">Wat je direct merkt</span>
            </div>
            <ul class="pm-checks">
              {direct.map((d) => <li>{d}</li>)}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Het probleem -->
    <section class="pm-section" aria-labelledby="ga4-what-title">
      <div class="pm-container pm-split svc__intro-grid">
        <div class="svc__intro-text">
          <span class="pm-label" data-reveal>Het probleem</span>
          <h2 id="ga4-what-title" class="pm-h2" data-reveal style="--d: 1">GA4 zonder inrichting is een lege meetlat</h2>
          <p class="pm-text" data-reveal style="--d: 2">Google Analytics 4 is het verplichte analytics-platform na de stopzetting van Universal Analytics. Maar standaard meet GA4 slechts paginaweergaven en sessies: geen formulierinzendingen, geen klikken op knoppen, geen conversie-events die je daadwerkelijk helpen sturen.</p>
          <p class="pm-text" data-reveal style="--d: 3">Zonder correcte inrichting heb je een dashboard vol getallen die niets zeggen over het daadwerkelijke rendement van je marketing. Met een professionele implementatie verandert GA4 in een betrouwbaar navigatie-instrument.</p>
          <a href="/tracking-audit" class="pm-link" data-reveal style="--d: 4">Check jouw GA4-implementatie gratis <Icon name="arrow" size={18} /></a>
        </div>
        <figure class="pm-card pm-card--lift svc__readout" data-reveal style="--d: 2">
          <div class="svc__readout-bar" aria-hidden="true"><i></i><i></i><i></i><span>ga4.property</span></div>
          <ul class="svc__readout-list">
            {readout.map((r) => (
              <li><strong>{r.value}</strong><span>{r.label}</span></li>
            ))}
          </ul>
        </figure>
      </div>
    </section>

    <!-- Wat wij implementeren -->
    <section class="pm-section pm-section--tight" aria-labelledby="ga4-services-title">
      <div class="pm-container">
        <header class="pm-head">
          <span class="pm-label" data-reveal>Wat wij implementeren</span>
          <h2 id="ga4-services-title" class="pm-h2" data-reveal style="--d: 1">Van lege property naar volledig analytics-systeem</h2>
          <p class="pm-opening" data-reveal style="--d: 2">We richten GA4 in als een instrument dat jou en je marketingteam dagelijks helpt met betere beslissingen, niet als een dashboard dat je één keer per maand raadpleegt.</p>
        </header>
        <ul class="svc__grid">
          {specialismen.map((item, i) => (
            <li data-reveal style={`--d: ${i % 3}`}>
              <article class="pm-card svc__tile">
                <span class:list={["pm-icon", item.tone]} aria-hidden="true"><Icon name={item.icon} /></span>
                <h3 class="pm-h3">{item.title}</h3>
                <p class="pm-text">{item.description}</p>
              </article>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Waarom professionele inrichting -->
    <section class="pm-section" aria-labelledby="ga4-benefits-title">
      <div class="pm-container pm-split">
        <div class="pm-card pm-card--yellow pm-card--lift svc__feature" data-reveal>
          <span class="pm-label">Waarom professionele inrichting?</span>
          <h2 id="ga4-benefits-title" class="pm-h2">Het verschil tussen data verzamelen en data begrijpen</h2>
          <p class="pm-text">Bijna elk bedrijf heeft GA4 geïnstalleerd. Slechts een fractie heeft het correct ingericht. Het gat daartussen is het verschil tussen navigeren op gevoel en navigeren op feiten.</p>
          <div class="svc__feature-stats">
            <div class="pm-stat"><strong class="pm-stat__value">23×</strong><span class="pm-stat__label">meer kans op klantwerving voor data-gedreven organisaties</span></div>
            <div class="pm-stat"><strong class="pm-stat__value">19×</strong><span class="pm-stat__label">winstgevender dan bedrijven die data negeren</span></div>
          </div>
        </div>
        <ul class="pm-accordion" data-reveal style="--d: 1">
          {benefits.map((b, i) => (
            <li>
              <details class="pm-acc" name="ga4-benefits" open={i === 0}>
                <summary>{b.title}</summary>
                <div class="pm-acc__body"><p>{b.body}</p></div>
              </details>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Aanpak -->
    <section class="pm-section pm-section--tight" id="aanpak" aria-labelledby="ga4-approach-title">
      <div class="pm-container">
        <div class="pm-card pm-card--plum pm-card--lift svc__steps-card">
          <header class="pm-head">
            <span class="pm-tag pm-tag--pink" data-reveal>Aanpak</span>
            <h2 id="ga4-approach-title" class="pm-h2" data-reveal style="--d: 1">Van lege GA4-property naar betrouwbare analytics in vier stappen.</h2>
          </header>
          <ol class="svc__steps" style="--steps: 4">
            {steps.map((s, i) => (
              <li class="svc__step" data-reveal style={`--d: ${i}`}>
                <span class="pm-icon pm-icon--yellow svc__step-num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
                <h3 class="pm-h3">{s.title}</h3>
                <p>{s.body}</p>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <!-- Context -->
    <section class="pm-section" aria-label="Knelpunten en oplevering">
      <div class="pm-container pm-split svc__duo">
        <article class="pm-card" data-reveal>
          <div class="svc__duo-head">
            <span class="pm-icon pm-icon--pink" aria-hidden="true"><Icon name="alert" /></span>
            <h2 class="pm-h2">Wat wij regelmatig aantreffen</h2>
          </div>
          <ul class="pm-checks pm-checks--x">
            {problemen.map((p) => <li>{p}</li>)}
          </ul>
        </article>
        <article class="pm-card pm-card--milk pm-card--lift" data-reveal style="--d: 1">
          <div class="svc__duo-head">
            <span class="pm-icon pm-icon--yellow" aria-hidden="true"><Icon name="check" /></span>
            <h2 class="pm-h2">Wat wij opleveren</h2>
          </div>
          <ul class="pm-checks">
            {opleveringen.map((o) => <li>{o}</li>)}
          </ul>
        </article>
      </div>
    </section>

    <!-- FAQ -->
    <section class="pm-section" aria-labelledby="ga4-faq-title">
      <div class="pm-container pm-container--narrow">
        <header class="pm-head svc__faq-head">
          <span class="pm-label" data-reveal>Veelgestelde vragen</span>
          <h2 id="ga4-faq-title" class="pm-h2" data-reveal style="--d: 1">Alles over GA4 implementatie</h2>
          <p class="pm-opening" data-reveal style="--d: 2">Staat jouw vraag er niet bij? Neem gerust contact op voor een vrijblijvend gesprek.</p>
          <a href="#contact" class="pm-link" data-overlay-open data-reveal style="--d: 3">Stel je vraag <Icon name="arrow" size={18} /></a>
        </header>
        <ul class="pm-accordion" data-reveal>
          {faq.map((item, i) => (
            <li>
              <details class="pm-acc" name="ga4-faq" open={i === 0}>
                <summary>{item.q}</summary>
                <div class="pm-acc__body"><p>{item.a}</p></div>
              </details>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Resultaten -->
    <section class="pm-band pm-band--paper pm-section pm-section--tight" aria-labelledby="ga4-outcomes-title">
      <div class="pm-container svc__outcomes-inner">
        <h2 id="ga4-outcomes-title" class="pm-h2" data-reveal>Resultaten die je mag verwachten</h2>
        <ul class="svc__pills">
          {outcomes.map((o, i) => (
            <li data-reveal style={`--d: ${i}`}><span class:list={["pm-tag", pillTones[i % pillTones.length]]}>{o}</span></li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Gerelateerde diensten -->
    <section class="pm-section pm-section--tight" aria-label="Gerelateerde diensten">
      <div class="pm-container">
        <span class="pm-label svc__reads-label">Gerelateerde diensten</span>
        <ul class="svc__reads">
          {reads.map((r, i) => (
            <li data-reveal style={`--d: ${i}`}>
              <a href={r.href} class="pm-card pm-card--milk svc__read">
                <span><strong>{r.title}</strong><small>{r.body}</small></span>
                <Icon name="arrow" />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- CTA -->
    <section class="pm-band svc__cta" id="contact" aria-labelledby="ga4-cta-title">
      <div class="pm-container svc__cta-inner">
        <h2 id="ga4-cta-title" class="pm-h2 pm-outline svc__cta-title" data-reveal>Weet jij wat jouw GA4 nu mist?</h2>
        <p class="pm-opening svc__cta-text" data-reveal style="--d: 1">We analyseren jouw huidige GA4-implementatie en laten zien welke events, conversies en doelgroepen je nu misloopt, inclusief een concreet plan om het op te lossen.</p>
        <a href="#" class="pm-btn pm-btn--yellow" data-overlay-open data-reveal style="--d: 2">Plan kennismaking <Icon name="arrow" /></a>
      </div>
    </section>
  </main>

  <Footer />
  <ContactOverlay />
</BaseLayout>

<style>
  /* ── Hero: stacked plum panel + overlapping "at a glance" card ───────── */
  .svc__hero { position: relative; padding-top: 72px; }

  .svc__panel {
    padding: clamp(4.5rem, 8vw, 6.5rem) var(--pm-gutter) clamp(10rem, 17vw, 13rem);
  }

  .svc__hero-content {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 1.4rem;
    max-width: 920px;
    margin-inline: auto;
  }

  .svc__back {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--pm-milk);
    font-size: 0.875rem;
    font-weight: 700;
    text-decoration: none;
    opacity: 0.85;
    transition: opacity 0.25s ease;
  }
  .svc__back svg { transform: rotate(180deg); }
  @media (hover: hover) { .svc__back:hover { opacity: 1; } }

  .svc__title { color: var(--pm-milk); }
  .svc__sub { max-width: 640px; }

  .svc__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin-top: 0.4rem;
  }

  .svc__float-wrap {
    position: relative;
    margin-top: clamp(-9rem, -13vw, -7rem);
    z-index: 2;
  }

  .svc__float {
    max-width: 1120px;
    margin-inline: auto;
    padding: clamp(1.5rem, 3.5vw, 3rem);
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 3vw, 2.75rem);
    align-items: center;
  }

  .svc__metrics {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
  }
  .svc__metric {
    container-type: inline-size;
    height: 100%;
    padding: 1.1rem 1.15rem 1.2rem;
    border: var(--pm-border);
    border-radius: var(--pm-r);
    background: var(--pm-milk);
  }
  .svc__metric:nth-child(2) { background: var(--pm-yellow); }
  .svc__metric .pm-stat__value { font-size: clamp(1.1rem, 16cqi, 2.1rem); overflow-wrap: normal; hyphens: auto; }

  .svc__glance { display: grid; gap: 1rem; }
  .svc__glance-head { display: flex; align-items: center; gap: 0.85rem; }

  /* ── Generic section bits ─────────────────────────────────────────────── */
  .svc__intro-grid { align-items: center; gap: clamp(2rem, 5vw, 4.5rem); }
  .svc__intro-text { display: grid; gap: 1.1rem; justify-items: start; }
  .svc__intro-text .pm-text + .pm-text { margin-top: 0; }
  .svc__intro-text .pm-link { margin-top: 0.4rem; }

  /* readout card: monospace stat panel (tracking family) */
  .svc__readout {
    margin: 0;
    background: var(--pm-milk);
  }
  .svc__readout-bar {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.85rem 1.25rem;
    border-bottom: var(--pm-border);
    background: var(--pm-paper);
  }
