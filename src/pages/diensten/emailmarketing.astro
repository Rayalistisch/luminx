---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import ContactOverlay from "../../components/ContactOverlay.astro";
import Icon from "../../components/pm/Icon.astro";

const siteOrigin = Astro.site?.toString() ?? "https://luminx.nl";
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin).toString();

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Emailmarketing & Marketing Automation",
  description: "Geautomatiseerde e-mailflows en nieuwsbrieven die leads nurturen, klanten activeren en omzet genereren op het juiste moment.",
  serviceType: "Email Marketing",
  url: canonicalUrl,
  areaServed: "NL",
  provider: {
    "@type": "Organization",
    "@id": `${siteOrigin}/#organization`,
    name: "LUMINX",
    url: siteOrigin,
  },
};

const metrics = [
  { value: "35–45%", label: "Gemiddelde open rate" },
  { value: "8–14×", label: "ROI vs. andere kanalen" },
  { value: "Volledig", label: "Geautomatiseerde flows" },
];

const direct = [
  "Meer omzet uit bestaande contacten zonder extra advertentiebudget",
  "Hogere leadconversie door tijdige en relevante opvolging",
  "Minder handmatige opvolging dankzij slimme automatisering",
];

const flows = [
  {
    icon: "mail",
    tone: "",
    title: "Welkomstflow",
    description: "Stel nieuwe abonnees voor aan je merk, product en toegevoegde waarde. De eerste indruk bepaalt de langetermijnrelatie.",
  },
  {
    icon: "trending-up",
    tone: "pm-icon--pink",
    title: "Nurture flow",
    description: "Educeer leads stap voor stap richting een aankoopbeslissing. Timing en relevantie op basis van gedrag, niet op aannames.",
  },
  {
    icon: "bag",
    tone: "pm-icon--yellow",
    title: "Abandoned cart & browse",
    description: "Haal geïnteresseerde bezoekers terug die een product bekeken of een bestelling niet afrondden. Geautomatiseerd en gepersonaliseerd.",
  },
  {
    icon: "heart",
    tone: "pm-icon--wine",
    title: "Post-purchase flow",
    description: "Activeer klanten na aankoop met upsell-suggesties, review-verzoeken en loyaliteitsprikkels voor terugkerende omzet.",
  },
  {
    icon: "refresh",
    tone: "",
    title: "Re-engagement flow",
    description: "Win inactieve contacten terug met een gerichte campagne of verwijder ze om je lijstkwaliteit en deliverability te beschermen.",
  },
  {
    icon: "megaphone",
    tone: "pm-icon--pink",
    title: "Promotionele campagnes",
    description: "Seizoensacties, lanceringen en nieuwsbrieven die je bestaande lijst activeren zonder afbreuk te doen aan de relatie.",
  },
];

const benefits = [
  {
    title: "Hoogste ROI van alle digitale kanalen",
    body: "Emailmarketing genereert gemiddeld 8 tot 14 keer de investering terug ten opzichte van andere kanalen. Dat komt doordat je communiceert met mensen die al interesse hebben getoond: geen koud bereik, maar opgebouwde relaties.",
  },
  {
    title: "Volledig eigenaarschap van het kanaal",
    body: "In tegenstelling tot social media of zoekmachines is je e-maillijst van jou. Geen algoritme dat je bereik beperkt, geen platform dat de spelregels verandert. Je hebt directe toegang tot je doelgroep, altijd.",
  },
  {
    title: "Schaalbare automation zonder extra FTE",
    body: "Eenmaal gebouwde flows werken dag en nacht, zeven dagen per week. Of je nu 100 of 100.000 contacten hebt: de juiste mail wordt op het juiste moment gestuurd zonder dat er iemand aan te pas hoeft te komen.",
  },
  {
    title: "Diepgaande segmentatie en personalisatie",
    body: "We segmenteren op basis van gedrag, aankoophistorie, fase in de funnel en interesse. Dat zorgt dat elke ontvanger een relevante boodschap krijgt, wat leidt tot hogere openrates, meer clicks en betere conversies.",
  },
  {
    title: "Meetbare impact op omzet per mail",
    body: "We richten e-commerce tracking in zodat je per flow en per campagne exact ziet hoeveel omzet er gegenereerd wordt. Geen vaag 'engagement' als KPI, maar harde euro's die teruggaan naar investering.",
  },
];

const steps = [
  { title: "Audit & analyse", body: "Audit van huidige lijst, platform, bestaande flows en deliverability. We brengen in kaart wat er al is en waar de grootste kansen liggen." },
  { title: "Strategie & opzet", body: "Flowstrategie, segmentatieopzet en contentplan per fase in de klantreis. Welke flows eerst, met welke boodschap en welke triggers." },
  { title: "Implementatie", body: "Technische bouw van flows, copywriting, visuele opmaak en testrondes op deliverability, weergave en automatiseringslogica." },
  { title: "Optimalisatie", body: "Maandelijkse optimalisatie op openrates, clicks en omzet per flow. A/B-tests op onderwerpregels, timing en call-to-actions." },
];

const problemen = [
  "Leads worden niet opgevolgd na het eerste contactmoment",
  "Nieuwsbrieven worden ad hoc verstuurd zonder strategie",
  "E-mails zijn generiek en niet afgestemd op gedrag of fase",
  "Geen inzicht in welke e-mails daadwerkelijk omzet genereren",
  "Hoge afmeldpercentages door irrelevante of te frequente mails",
  "Deliverability-problemen door technische configuratiefouten",
];

const opleveringen = [
  "Welkomst-, nurture- en re-engagementflows op maat",
  "Segmentatie op basis van gedrag, interesse en fase in de funnel",
  "Gepersonaliseerde content en dynamische productaanbevelingen",
  "A/B-tests op onderwerpregels, timing en CTA's",
  "Technische deliverability-configuratie (SPF, DKIM, DMARC)",
  "Maandelijkse rapportage op opens, clicks en gegenereerde omzet",
];

const faq = [
  {
    q: "Welk emailplatform gebruiken jullie?",
    a: "We werken platform-onafhankelijk en adviseren op basis van jouw situatie: Klaviyo voor e-commerce, ActiveCampaign of HubSpot voor B2B, en Mailchimp of Brevo voor kleinere lijsten en budgetten. We kunnen bestaande platformen overnemen of een nieuw platform opzetten.",
  },
  {
    q: "Wat kost emailmarketing uitbesteden?",
    a: "De kosten zijn afhankelijk van het aantal flows, de complexiteit van segmentatie en of we ook copywriting en design verzorgen. We werken altijd met een transparant voorstel zodat je precies weet wat je betaalt en wat je terugkrijgt.",
  },
  {
    q: "Hoe bouw je een goede e-maillijst op?",
    a: "Via relevante lead magnets, opt-in formulieren op strategische plekken op de website, en eventueel betaalde campagnes om nieuwe contacten te werven. We adviseren over de hele lijstopbouwstrategie, niet alleen over de flows achteraf.",
  },
  {
    q: "Hoe vermijd je de spam-folder?",
    a: "Door correcte technische configuratie (SPF, DKIM, DMARC), een schone lijst zonder inactieve contacten, consistente verzendfrequentie en relevante content. We doen een deliverability-audit als onderdeel van het onboardingproces.",
  },
  {
    q: "Werkt emailmarketing ook voor B2B?",
    a: "Zeker. B2B heeft langere salescycli, wat emailmarketing juist krachtig maakt: je kunt leads nurturen over weken of maanden, kennis delen, vertrouwen opbouwen en op het juiste moment conversiegerichte mails sturen. We bouwen flows specifiek op de B2B-klantreis.",
  },
];

const outcomes = [
  "Meer omzet uit bestaande contacten",
  "Hogere leadconversie",
  "Minder handmatige opvolging",
  "Duurzame klantrelaties",
  "Hogere open- en clickrates",
  "Schaalbare automation",
  "Volledige lijsteigenaarschap",
  "Meetbare omzet per flow",
];

const reads = [
  { href: "/diensten/online-marketing", title: "Online Marketing", body: "E-mailmarketing als onderdeel van een brede marketingaanpak." },
  { href: "/diensten/social-advertising", title: "Social Advertising", body: "Bereik nieuwe leads die je via e-mail kunt nurturen." },
  { href: "/diensten/ga4-implementatie", title: "GA4 Implementatie", body: "Meet de omzetbijdrage van elke e-mailflow." },
];

const pillTones = ["pm-tag--yellow", "pm-tag--pink", "", "pm-tag--paper"];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map(({ q, a }) => ({
    "@type": "Question",
    name: q,
    acceptedAnswer: { "@type": "Answer", text: a },
  })),
};
---

<BaseLayout
  title="Emailmarketing & Marketing Automation | LuminX"
  description="Geautomatiseerde e-mailflows en nieuwsbrieven die leads nurturen, klanten activeren en omzet genereren op het juiste moment."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(serviceSchema)}></script>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
  <Nav basePath="/" />

  <main class="svc">

    <!-- Hero -->
    <section class="svc__hero" aria-labelledby="svc-title">
      <div class="pm-stack">
        <span class="pm-stack__layer" aria-hidden="true"></span>
        <span class="pm-stack__layer" aria-hidden="true"></span>
        <span class="pm-stack__layer" aria-hidden="true"></span>
        <div class="pm-stack__panel svc__panel">
          <div class="svc__hero-content">
            <a href="/diensten/online-marketing" class="svc__back" data-reveal><Icon name="arrow" size={16} /> Online Marketing</a>
            <span class="pm-tag pm-tag--pink" data-reveal style="--d: 1">Specialisme</span>
            <h1 id="svc-title" class="pm-h1 svc__title" data-reveal style="--d: 2">Emailmarketing</h1>
            <p class="pm-opening svc__sub" data-reveal style="--d: 3">We bouwen e-mailflows die werken als een stille verkoper: gepersonaliseerd, getimed en volledig geautomatiseerd, zodat geen lead of klant meer door de mazen glipt.</p>
            <div class="svc__actions" data-reveal style="--d: 4">
              <a href="#contact" class="pm-btn pm-btn--yellow">Plan kennismaking <Icon name="arrow" /></a>
              <a href="#aanpak" class="pm-btn pm-btn--white">Bekijk aanpak</a>
            </div>
          </div>
        </div>
      </div>

      <div class="pm-container svc__float-wrap">
        <div class="pm-card pm-card--lift svc__float" data-reveal>
          <ul class="svc__metrics">
            {metrics.map((m) => (
              <li class="pm-stat svc__metric">
                <strong class="pm-stat__value">{m.value}</strong>
                <span class="pm-stat__label">{m.label}</span>
              </li>
            ))}
          </ul>
          <div class="svc__glance">
            <div class="svc__glance-head">
              <span class="pm-icon pm-icon--sm pm-icon--wine" aria-hidden="true"><Icon name="mail" /></span>
              <span class="pm-label">Wat je direct merkt</span>
            </div>
            <ul class="pm-checks">
              {direct.map((d) => <li>{d}</li>)}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Wat is emailmarketing -->
    <section class="pm-section" aria-labelledby="email-what-title">
      <div class="pm-container pm-split svc__intro-grid">
        <div class="svc__intro-text">
          <span class="pm-label" data-reveal>Wat is emailmarketing?</span>
          <h2 id="email-what-title" class="pm-h2" data-reveal style="--d: 1">Je meest waardevolle kanaal is er al: je gebruikt het alleen niet optimaal</h2>
          <p class="pm-text" data-reveal style="--d: 2">Emailmarketing is het strategisch inzetten van e-mail om leads te nurturen, klanten te activeren en omzet te genereren. Via geautomatiseerde flows communiceer je op het juiste moment met de juiste persoon, gebaseerd op gedrag en fase in de klantreis.</p>
          <p class="pm-text" data-reveal style="--d: 3">In tegenstelling tot social media of advertenties ben jij eigenaar van je e-maillijst. Geen algoritme dat je bereik beperkt. Geen platform dat de spelregels verandert. Gewoon directe toegang tot mensen die al interesse hebben getoond, en dat is onbetaalbaar.</p>
          <a href="#contact" class="pm-link" data-overlay-open data-reveal style="--d: 4">Gratis flow-analyse <Icon name="arrow" size={18} /></a>
        </div>
        <div class="svc__fan-wrap" data-reveal style="--d: 2">
          <ol class="svc__fan">
            {metrics.map((r, i) => (
              <li>
                <span class="svc__fan-num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
                <strong>{r.value}</strong>
                <span class="svc__fan-label">{r.label}</span>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <!-- Flows & campagnes -->
    <section class="pm-section pm-section--tight" aria-labelledby="email-services-title">
      <div class="pm-container">
        <header class="pm-head">
          <span class="pm-label" data-reveal>Flows & campagnes</span>
          <h2 id="email-services-title" class="pm-h2" data-reveal style="--d: 1">Wat wij voor je bouwen</h2>
          <p class="pm-opening" data-reveal style="--d: 2">Van welkomstflow tot re-engagement: we bouwen het volledige e-maillandschap dat jouw lijst omzet in omzet, zonder dat er dagelijks iemand aan te pas hoeft te komen.</p>
        </header>
        <ul class="svc__grid">
          {flows.map((item, i) => (
            <li data-reveal style={`--d: ${i % 3}`}>
              <article class="pm-card svc__tile">
                <span class:list={["pm-icon", item.tone]} aria-hidden="true"><Icon name={item.icon} /></span>
                <h3 class="pm-h3">{item.title}</h3>
                <p class="pm-text">{item.description}</p>
              </article>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Voordelen -->
    <section class="pm-section" aria-labelledby="email-benefits-title">
      <div class="pm-container pm-split">
        <div class="pm-card pm-card--yellow pm-card--lift svc__feature" data-reveal>
          <span class="pm-label">Waarom uitbesteden?</span>
          <h2 id="email-benefits-title" class="pm-h2">Voordelen van professionele emailmarketing</h2>
          <p class="pm-text">Effectieve emailmarketing gaat verder dan een nieuwsbrief versturen. Het vereist strategie, segmentatie, automatiseringslogica, copywriting en technische deliverability-kennis. Dit zijn de voordelen van samenwerken met een specialist.</p>
          <div class="svc__feature-stats">
            <div class="pm-stat"><strong class="pm-stat__value">8–14×</strong><span class="pm-stat__label">gemiddelde ROI ten opzichte van andere kanalen</span></div>
            <div class="pm-stat"><strong class="pm-stat__value">100%</strong><span class="pm-stat__label">eigenaarschap van je lijst en data</span></div>
          </div>
        </div>
        <ul class="pm-accordion" data-reveal style="--d: 1">
          {benefits.map((b, i) => (
            <li>
              <details class="pm-acc" name="email-benefits" open={i === 0}>
                <summary>{b.title}</summary>
                <div class="pm-acc__body"><p>{b.body}</p></div>
              </details>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Aanpak -->
    <section class="pm-section pm-section--tight" id="aanpak" aria-labelledby="email-approach-title">
      <div class="pm-container">
        <div class="pm-card pm-card--plum pm-card--lift svc__steps-card">
          <header class="pm-head">
            <span class="pm-tag pm-tag--pink" data-reveal>Aanpak</span>
            <h2 id="email-approach-title" class="pm-h2" data-reveal style="--d: 1">Van lijstaudit naar volledig geautomatiseerde flow-architectuur.</h2>
          </header>
          <ol class="svc__steps" style="--steps: 4">
            {steps.map((s, i) => (
              <li class="svc__step" data-reveal style={`--d: ${i}`}>
                <span class="pm-icon pm-icon--yellow svc__step-num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
                <h3 class="pm-h3">{s.title}</h3>
                <p>{s.body}</p>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <!-- Context -->
    <section class="pm-section" aria-label="Knelpunten en oplevering">
      <div class="pm-container pm-split svc__duo">
        <article class="pm-card" data-reveal>
          <div class="svc__duo-head">
            <span class="pm-icon pm-icon--pink" aria-hidden="true"><Icon name="alert" /></span>
            <h2 class="pm-h2">Waar organisaties op vastlopen</h2>
          </div>
          <ul class="pm-checks pm-checks--x">
            {problemen.map((p) => <li>{p}</li>)}
          </ul>
        </article>
        <article class="pm-card pm-card--milk pm-card--lift" data-reveal style="--d: 1">
          <div class="svc__duo-head">
            <span class="pm-icon pm-icon--yellow" aria-hidden="true"><Icon name="check" /></span>
            <h2 class="pm-h2">Wat wij concreet opleveren</h2>
          </div>
          <ul class="pm-checks">
            {opleveringen.map((o) => <li>{o}</li>)}
          </ul>
        </article>
      </div>
    </section>

    <!-- FAQ -->
    <section class="pm-section" aria-labelledby="email-faq-title">
      <div class="pm-container pm-container--narrow">
        <header class="pm-head svc__faq-head">
          <span class="pm-label" data-reveal>Veelgestelde vragen</span>
          <h2 id="email-faq-title" class="pm-h2" data-reveal style="--d: 1">Alles over emailmarketing uitbesteden</h2>
          <p class="pm-opening" data-reveal style="--d: 2">Staat jouw vraag er niet bij? Neem gerust contact op voor een vrijblijvend gesprek.</p>
          <a href="#contact" class="pm-link" data-overlay-open data-reveal style="--d: 3">Stel je vraag <Icon name="arrow" size={18} /></a>
        </header>
        <ul class="pm-accordion" data-reveal>
          {faq.map((item, i) => (
            <li>
              <details class="pm-acc" name="email-faq" open={i === 0}>
                <summary>{item.q}</summary>
                <div class="pm-acc__body"><p>{item.a}</p></div>
              </details>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Resultaten -->
    <section class="pm-band pm-band--paper pm-section pm-section--tight" aria-labelledby="email-outcomes-title">
      <div class="pm-container svc__outcomes-inner">
        <h2 id="email-outcomes-title" class="pm-h2" data-reveal>Resultaten die je mag verwachten</h2>
        <ul class="svc__pills">
          {outcomes.map((o, i) => (
            <li data-reveal style={`--d: ${i}`}><span class:list={["pm-tag", pillTones[i % pillTones.length]]}>{o}</span></li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Gerelateerde diensten -->
    <section class="pm-section pm-section--tight" aria-label="Gerelateerde diensten">
      <div class="pm-container">
        <span class="pm-label svc__reads-label">Gerelateerde diensten</span>
        <ul class="svc__reads">
          {reads.map((r, i) => (
            <li data-reveal style={`--d: ${i}`}>
              <a href={r.href} class="pm-card pm-card--milk svc__read">
                <span><strong>{r.title}</strong><small>{r.body}</small></span>
                <Icon name="arrow" />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- CTA -->
    <section class="pm-band svc__cta" id="contact" aria-labelledby="email-cta-title">
      <div class="pm-container svc__cta-inner">
        <h2 id="email-cta-title" class="pm-h2 pm-outline svc__cta-title" data-reveal>Klaar voor e-mailflows die 24/7 voor je werken?</h2>
        <p class="pm-opening svc__cta-text" data-reveal style="--d: 1">We analyseren jouw huidige e-mailsituatie en presenteren een concreet plan voor flows, segmentatie en verwachte resultaten.</p>
        <a href="#" class="pm-btn pm-btn--yellow" data-overlay-open data-reveal style="--d: 2">Plan kennismaking <Icon name="arrow" /></a>
      </div>
    </section>
  </main>

  <Footer />
  <ContactOverlay />
</BaseLayout>

<style>
  /* ── Hero: stacked plum panel + overlapping "at a glance" card ───────── */
  .svc__hero { position: relative; padding-top: 72px; }

  .svc__panel {
    padding: clamp(4.5rem, 8vw, 6.5rem) var(--pm-gutter) clamp(10rem, 17vw, 13rem);
  }

  .svc__hero-content {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 1.4rem;
    max-width: 920px;
    margin-inline: auto;
  }

  .svc__back {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--pm-milk);
    font-size: 0.875rem;
    font-weight: 700;
    text-decoration: none;
    opacity: 0.85;
    transition: opacity 0.25s ease;
  }
  .svc__back svg { transform: rotate(180deg); }
  @media (hover: hover) { .svc__back:hover { opacity: 1; } }

  .svc__title { color: var(--pm-milk); }
  .svc__sub { max-width: 640px; }

  .svc__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin-top: 0.4rem;
  }

  .svc__float-wrap {
    position: relative;
    margin-top: clamp(-9rem, -13vw, -7rem);
    z-index: 2;
  }

  .svc__float {
    max-width: 1120px;
    margin-inline: auto;
    padding: clamp(1.5rem, 3.5vw, 3rem);
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 3vw, 2.75rem);
    align-items: center;
  }

  .svc__metrics {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
  }
  .svc__metric {
    container-type: inline-size;
    height: 100%;
    padding: 1.1rem 1.15rem 1.2rem;
    border: var(--pm-border);
    border-radius: var(--pm-r);
    background: var(--pm-milk);
  }
  .svc__metric:nth-child(2) { background: var(--pm-yellow); }
  .svc__metric .pm-stat__value { font-size: clamp(1.1rem, 16cqi, 2.1rem); overflow-wrap: normal; hyphens: auto; }

  .svc__glance { display: grid; gap: 1rem; }
  .svc__glance-head { display: flex; align-items: center; gap: 0.85rem; }

  /* ── Generic section bits ─────────────────────────────────────────────── */
  .svc__intro-grid { align-items: center; gap: clamp(2rem, 5vw, 4.5rem); }
  .svc__intro-text { display: grid; gap: 1.1rem; justify-items: start; }
  .svc__intro-text .pm-text + .pm-text { margin-top: 0; }
  .svc__intro-text .pm-link { margin-top: 0.4rem; }

  /* readout card: monospace stat panel (tracking family) */
  .svc__readout {
    margin: 0;
    background: var(--pm-milk);
  }
  .svc__readout-bar {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.85rem 1.25rem;
    border-bottom: var(--pm-border);
    background: var(--pm-paper);
  }
  .svc__readout-bar i {
