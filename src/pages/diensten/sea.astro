---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import ContactOverlay from "../../components/ContactOverlay.astro";
import Icon from "../../components/pm/Icon.astro";

const siteOrigin = Astro.site?.toString() ?? "https://luminx.nl";
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin).toString();

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "SEA – Google Ads",
  description: "Google Ads campagnes die op het juiste moment zichtbaar zijn, gericht op conversie en een sterke ROAS.",
  serviceType: "Search Engine Advertising",
  url: canonicalUrl,
  areaServed: "NL",
  provider: {
    "@type": "Organization",
    "@id": `${siteOrigin}/#organization`,
    name: "LUMINX",
    url: siteOrigin,
  },
};

const heroMetrics = [
  { value: "4–8×", label: "Gemiddelde ROAS" },
  { value: "−20–40%", label: "Lagere kosten per lead" },
  { value: "2–4 wkn", label: "Eerste campagne live" },
];

const heroOutcomes = [
  "Lagere kosten per acquisitie bij hogere leadkwaliteit",
  "Volledige transparantie via realtime dashboarding",
  "Minder budgetverspilling door nauwkeurige doelgroepsegmentatie",
];

const resultStack = [
  { value: "4–8×", label: "Gemiddelde ROAS" },
  { value: "−40%", label: "Lagere kosten per lead" },
  { value: "vanaf dag 1", label: "Eerste klikken" },
];

const campaignTypes = [
  {
    icon: "search",
    tone: "",
    title: "Google Search Ads",
    description: "Tekstadvertenties bovenaan de zoekresultaten bij relevante zoekopdrachten. Bereikt gebruikers met hoge koopintentie en genereert directe conversies.",
  },
  {
    icon: "bag",
    tone: "pm-icon--yellow",
    title: "Google Shopping",
    description: "Productadvertenties met afbeelding, prijs en titel direct in de zoekresultaten. Het meest effectieve campagnetype voor e-commerce en productgerichte bedrijven.",
  },
  {
    icon: "eye",
    tone: "pm-icon--pink",
    title: "Display & Remarketing",
    description: "Visuele advertenties op het Google Display Netwerk. Display vergroot merkbekendheid; remarketing heractivert eerdere bezoekers met gepersonaliseerde boodschappen.",
  },
  {
    icon: "zap",
    tone: "pm-icon--wine",
    title: "Performance Max",
    description: "AI-gestuurd campagnetype dat automatisch het optimale kanaal, format en biedstrategie selecteert. Levert doorgaans de hoogste conversie-output binnen het Google Ads ecosysteem.",
  },
  {
    icon: "play",
    tone: "",
    title: "YouTube Ads",
    description: "Videoadvertenties vóór en tijdens YouTube-content. Effectief voor merkbekendheid en overweging, met volledig meetbare resultaten op weergave- en conversieniveau.",
  },
  {
    icon: "globe",
    tone: "pm-icon--yellow",
    title: "Microsoft Advertising",
    description: "Aanvullend zoeknetwerk via Bing, Yahoo en DuckDuckGo. Kenmerkt zich door lagere CPC's en minder concurrentie, met een doorgaans hoger converterend zakelijk publiek.",
  },
] as const;

const benefits = [
  {
    title: "Direct resultaat zonder leercurve",
    body: "Een ervaren SEA-specialist beschikt over kennis uit honderden campagnes. Die ervaring vertaalt zich naar snellere resultaten en minder budgetverlies in de opstartfase.",
  },
  {
    title: "Toegang tot professionele tooling",
    body: "Professioneel SEA-beheer omvat tooling als SEMrush, Google Keyword Planner, Search Ads 360 en geavanceerde biedalgoritmen. Voor individuele bedrijven zijn deze tools zelden rendabel om zelfstandig aan te schaffen.",
  },
  {
    title: "Continu bijgesteld op data",
    body: "SEA vereist doorlopende aandacht. Dagelijkse monitoring, wekelijkse optimalisatie en maandelijkse strategische evaluatie zijn noodzakelijk om het rendement structureel te verbeteren.",
  },
  {
    title: "Volledige transparantie en eigenaarschap",
    body: "Bij professioneel beheer behoudt de opdrachtgever volledige toegang tot het eigen Google Ads-account. Rapportage over kosten, conversies en ROAS is helder, zonder verborgen marges op het advertentiebudget.",
  },
  {
    title: "Schaalbaar zonder extra overhead",
    body: "SEA schaalt mee met de organisatie. Uitbreiding naar nieuwe producten, regio's of hogere budgetten vereist geen extra personeel, enkel strategische aanpassingen in de campagnestructuur.",
  },
];

const steps = [
  {
    icon: "compass",
    title: "Audit & strategie",
    body: "Het bestaande account wordt geanalyseerd (of vanaf nul opgebouwd). Zoekwoordonderzoek, concurrentieanalyse en het vaststellen van doelstellingen, KPI's en budgetallocatie vormen de basis.",
  },
  {
    icon: "layers",
    title: "Opzet & creatie",
    body: "De campagnestructuur wordt opgebouwd, advertentieteksten geschreven, conversietracking via GTM en GA4 geinstalleerd, en remarketingdoelgroepen ingericht.",
  },
  {
    icon: "chart",
    title: "Livegang & monitoring",
    body: "Na livegang volgt dagelijkse monitoring op kwaliteitsscore, impressieshare, CTR en conversies. Snel bijsturen in de eerste weken is cruciaal voor campagnesucces.",
  },
  {
    icon: "trending-up",
    title: "Optimalisatie & schaling",
    body: "Op basis van data worden biedstrategieën geoptimaliseerd, verliesgevende zoekwoorden uitgesloten, nieuwe advertentieformats getest en bewezen campagnes opgeschaald.",
  },
] as const;

const pains = [
  "Advertentiebudget verdwijnt zonder aantoonbaar rendement",
  "Campagnes draaien te breed, zonder focus op de juiste doelgroepsegmenten",
  "Zwakke aansluiting tussen advertentie, zoekwoord en landingspagina",
  "Ontbrekende structurele optimalisatie op basis van data en conversies",
  "Geen inzicht in welke campagnes daadwerkelijk omzet genereren",
  "Onoverzichtelijke accountstructuur die bijsturing bemoeilijkt",
];

const gains = [
  "Campagnestructuur gebaseerd op zoekintentie en fase in de klantreis",
  "Geoptimaliseerde advertentieteksten met doorlopende A/B-tests voor hogere CTR",
  "Conversiegerichte landingspagina-analyse en concrete verbeterpunten",
  "Wekelijkse optimalisatie op ROAS, CPL en kwaliteitsscore",
  "Volledige conversietracking via GA4 en Google Tag Manager",
  "Maandelijkse rapportage met conclusies en strategische aanbevelingen",
];

const outcomes = [
  "Lagere kosten per acquisitie",
  "Hogere leadkwaliteit",
  "Realtime inzicht via dashboard",
  "Snelle schaalbaarheid",
  "Minder budgetverspilling",
  "Voorspelbare leadinstroom",
  "Volledig accounteigenaarschap",
  "Geïntegreerde kanaalstrategie",
];

const related = [
  { href: "/vergelijk/seo-vs-sea", title: "SEO vs. SEA", desc: "Wanneer kies je organisch, wanneer betaald?" },
  { href: "/tracking-audit", title: "Gratis Tracking-audit", desc: "Ontdek of je Google Ads conversies correct meet." },
  { href: "/diensten/online-marketing", title: "Online Marketing", desc: "SEA als onderdeel van een samenhangende marketingaanpak." },
  { href: "/diensten/seo", title: "SEO", desc: "Structurele zichtbaarheid naast betaalde campagnes." },
  { href: "/diensten/social-advertising", title: "Social Advertising", desc: "Bereik op Meta en LinkedIn naast Google Ads." },
];

const faq = [
  {
    q: "Wat doet een SEA specialist precies?",
    a: "Een SEA specialist beheert betaalde advertentiecampagnes via platformen als Google Ads en Microsoft Advertising. Dat omvat zoekwoordonderzoek, campagne-opzet, advertentieteksten schrijven, biedstrategieën instellen en dagelijkse optimalisatie op basis van data. Het doel is altijd hetzelfde: zo veel mogelijk resultaat halen uit elk advertentie-euro.",
  },
  {
    q: "Wat kost Google Ads beheer?",
    a: "De kosten bestaan uit twee onderdelen: het advertentiebudget dat rechtstreeks naar Google gaat, en de beheervergoeding aan LuminX. De beheervergoeding is afhankelijk van de campagnecomplexiteit en het maandbudget. We werken altijd met een helder voorstel zodat je precies weet wat je betaalt, en wat je terugkrijgt.",
  },
  {
    q: "Hoe snel zie ik resultaat met SEA?",
    a: "Dat is één van de grootste voordelen van SEA ten opzichte van SEO: resultaat is snel zichtbaar. Zodra een campagne live gaat, kunnen eerste klikken en conversies al op dag één binnenkomen. De eerste twee tot vier weken gebruiken we voor optimalisatie. Na acht tot twaalf weken zijn we in staat om op basis van data consistente prognoses te maken.",
  },
  {
    q: "Wat is het verschil tussen SEO en SEA?",
    a: "SEO richt zich op organische (gratis) posities in Google via techniek, content en linkbuilding. Dat kost tijd maar heeft een duurzame impact. SEA werkt met betaalde advertenties die direct bovenaan de zoekresultaten verschijnen. Ideaal voor snelle resultaten, seizoensacties of terwijl je SEO nog wordt opgebouwd. De meeste bedrijven profiteren van een combinatie van beide.",
  },
  {
    q: "Behouden we toegang tot ons eigen Google Ads account?",
    a: "Altijd. We werken in jouw eigen Google Ads account, nooit in een gedeeld agentschapsaccount. Volledige transparantie en eigenaarschap staan bij ons centraal. Als de samenwerking ooit eindigt, neem jij het account gewoon mee.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map(({ q, a }) => ({
    "@type": "Question",
    name: q,
    acceptedAnswer: { "@type": "Answer", text: a },
  })),
};
---

<BaseLayout
  title="SEA Uitbesteden – Google Ads Specialist | LuminX"
  description="Google Ads campagnes die op het juiste moment zichtbaar zijn, gericht op conversie en een sterke ROAS. Professioneel SEA beheer door LuminX."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(serviceSchema)}></script>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
  <Nav basePath="/" />

  <main class="svc">

    <!-- Hero -->
    <section class="svc__hero" aria-labelledby="svc-title">
      <div class="pm-stack">
        <span class="pm-stack__layer" aria-hidden="true"></span>
        <span class="pm-stack__layer" aria-hidden="true"></span>
        <span class="pm-stack__layer" aria-hidden="true"></span>

        <div class="pm-stack__panel svc__panel">
          <img class="pm-obj pm-obj--right" src="/images/3d/google-ads.webp" width="1252" height="1316" alt="" aria-hidden="true" decoding="async" />
          <div class="svc__hero-content">
            <a href="/diensten/online-marketing" class="svc__back" data-reveal>
              <Icon name="arrow" size={16} stroke={2.4} /> Online Marketing
            </a>
            <span class="pm-tag svc__tag" data-reveal style="--d: 1"><Icon name="megaphone" size={16} /> Specialisme · Google Ads</span>
            <h1 id="svc-title" class="pm-h1 svc__title" data-reveal style="--d: 2">SEA</h1>
            <p class="pm-opening svc__sub" data-reveal style="--d: 3">
              Betaald zoeken is een precisiemiddel: de juiste boodschap, op het juiste moment, voor de juiste doelgroep, met elke euro verantwoord.
            </p>
            <div class="svc__actions" data-reveal style="--d: 4">
              <a href="#contact" class="pm-btn pm-btn--yellow">Plan kennismaking <Icon name="arrow" /></a>
              <a href="#aanpak" class="pm-btn pm-btn--white">Bekijk aanpak</a>
            </div>
          </div>
        </div>
      </div>

      <div class="pm-container svc__float-wrap">
        <div class="pm-card pm-card--lift svc__float" data-reveal>
          <ul class="svc__metrics" aria-label="Kerncijfers">
            {heroMetrics.map((m, i) => (
              <li class="pm-stat svc__metric" data-reveal style={`--d: ${i}`}>
                <span class="pm-stat__value">{m.value}</span>
                <span class="pm-stat__label">{m.label}</span>
              </li>
            ))}
          </ul>
          <div class="svc__float-side">
            <span class="pm-label">Meetbare uitkomsten</span>
            <ul class="pm-checks">
              {heroOutcomes.map((o) => <li>{o}</li>)}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Wat is SEA -->
    <section class="pm-section svc__what" aria-labelledby="what-title">
      <div class="pm-container pm-split svc__what-grid">
        <div class="svc__what-text">
          <header class="pm-head pm-head--left svc__head-left">
            <span class="pm-label" data-reveal>Wat is SEA?</span>
            <h2 id="what-title" class="pm-h2" data-reveal style="--d: 1">Search Engine Advertising: betaalde zichtbaarheid in zoekmachines</h2>
          </header>
          <p class="pm-text" data-reveal style="--d: 2">Search Engine Advertising (SEA) is het plaatsen van betaalde advertenties in zoekmachines zoals Google en Bing. Adverteerders betalen per klik (CPC) en verschijnen direct bovenaan de zoekresultaten, vóór organische posities, op exact de zoektermen die relevant zijn voor hun doelgroep.</p>
          <p class="pm-text" data-reveal style="--d: 3">Waar SEO maanden nodig heeft om posities op te bouwen, levert SEA directe zichtbaarheid. Dat maakt het bij uitstek geschikt voor leadgeneratie, het valideren van nieuwe markten en het ondersteunen van seizoensgebonden campagnes. Structureel geoptimaliseerd SEA-beheer vormt een voorspelbare groeimotor met meetbaar rendement.</p>
          <a href="#contact" class="pm-link svc__inline" data-overlay-open data-reveal style="--d: 4">Gratis adviesgesprek <Icon name="arrow" size={18} stroke={2.4} /></a>
        </div>

        <div class="pm-card pm-card--yellow pm-card--lift svc__stack" aria-hidden="true" data-reveal style="--d: 1">
          <div class="svc__stack-head">
            <span class="pm-icon pm-icon--sm pm-icon--milk"><Icon name="chart" /></span>
            <span>SEA Resultaten</span>
          </div>
          <ol class="svc__stack-list">
            {resultStack.map((r, i) => (
              <li>
                <span class="svc__stack-num">0{i + 1}</span>
                <span class="svc__stack-body">
                  <strong>{r.value}</strong>
                  <span>{r.label}</span>
                </span>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <!-- Campagnetypes -->
    <section class="pm-section pm-band--paper svc__types" aria-labelledby="types-title">
      <div class="pm-container">
        <header class="pm-head">
          <span class="pm-label" data-reveal>Campagnetypes</span>
          <h2 id="types-title" class="pm-h2" data-reveal style="--d: 1">Het Google Ads ecosysteem in zes campagneformats</h2>
          <p class="pm-opening" data-reveal style="--d: 2">Elk campagnetype bedient een ander moment in de klantreis. Effectief SEA-beheer combineert deze formats tot een samenhangende strategie met maximale dekking.</p>
        </header>
        <ul class="svc__grid">
          {campaignTypes.map((t, i) => (
            <li class="pm-card pm-card--milk pm-card--pad svc__tile" data-reveal style={`--d: ${i % 3}`}>
              <span class:list={["pm-icon", t.tone]}><Icon name={t.icon} /></span>
              <h3 class="pm-h3 svc__tile-title">{t.title}</h3>
              <p class="pm-text">{t.description}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Waarom uitbesteden -->
    <section class="pm-section svc__benefits" aria-labelledby="benefits-title">
      <div class="pm-container">
        <header class="pm-head">
          <span class="pm-label" data-reveal>Waarom uitbesteden?</span>
          <h2 id="benefits-title" class="pm-h2" data-reveal style="--d: 1">De impact van professioneel SEA-beheer</h2>
          <p class="pm-opening" data-reveal style="--d: 2">Google Ads is een vakgebied op zich. De interface verandert continu, biedstrategieën worden complexer en de concurrentie neemt toe. Professioneel beheer levert structureel betere resultaten dan intern management zonder dedicated expertise.</p>
        </header>
        <div class="pm-split">
          <div class="pm-card pm-card--pink pm-card--lift svc__statcard" data-reveal>
            <div class="pm-stat">
              <span class="pm-stat__value">95%</span>
              <span class="pm-stat__label">van onze klanten ziet binnen 60 dagen resultaatstijging</span>
            </div>
            <span class="pm-dots" aria-hidden="true"></span>
            <div class="pm-stat">
              <span class="pm-stat__value">100%</span>
              <span class="pm-stat__label">accounteigenaarschap bij de klant</span>
            </div>
            <span class="pm-icon pm-icon--yellow svc__statcard-badge" aria-hidden="true"><Icon name="shield" /></span>
          </div>
          <ul class="pm-accordion" data-reveal style="--d: 1">
            {benefits.map((b, i) => (
              <li>
                <details class="pm-acc" name="sea-benefits" open={i === 0}>
                  <summary>{b.title}</summary>
                  <div class="pm-acc__body"><p>{b.body}</p></div>
                </details>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- Aanpak -->
    <section class="pm-section pm-section--tight svc__approach" id="aanpak" aria-labelledby="approach-title">
      <div class="pm-container">
        <div class="pm-card pm-card--plum pm-card--lift svc__plum">
          <header class="pm-head svc__plum-head">
            <span class="pm-tag pm-tag--pink" data-reveal>Aanpak</span>
            <h2 id="approach-title" class="pm-h2" data-reveal style="--d: 1">Vier fases van analyse naar winstgevende campagnes.</h2>
          </header>
          <ol class="svc__steps">
            {steps.map((s, i) => (
              <li class="svc__step" data-reveal style={`--d: ${i}`}>
                <div class="svc__step-top">
                  <span class="pm-icon pm-icon--milk"><Icon name={s.icon} /></span>
                  <span class="svc__step-num">0{i + 1}</span>
                </div>
                <h3 class="svc__step-title">{s.title}</h3>
                <p>{s.body}</p>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <!-- Knelpunten vs oplevering -->
    <section class="pm-section svc__compare" aria-label="Knelpunten en oplossingen">
      <div class="pm-container pm-split">
        <article class="pm-card pm-card--pad svc__compare-card" data-reveal>
          <span class="pm-icon pm-icon--pink" aria-hidden="true"><Icon name="alert" /></span>
          <h2 class="pm-h3">Veelvoorkomende knelpunten bij SEA</h2>
          <ul class="pm-checks pm-checks--x">
            {pains.map((p) => <li>{p}</li>)}
          </ul>
        </article>
        <article class="pm-card pm-card--milk pm-card--lift pm-card--pad svc__compare-card" data-reveal style="--d: 1">
          <span class="pm-icon pm-icon--yellow" aria-hidden="true"><Icon name="check" /></span>
          <h2 class="pm-h3">Wat professioneel SEA-beheer oplevert</h2>
          <ul class="pm-checks">
            {gains.map((g) => <li>{g}</li>)}
          </ul>
        </article>
      </div>
    </section>

    <!-- FAQ -->
    <section class="pm-section pm-band--paper svc__faq" aria-labelledby="faq-title">
      <div class="pm-container svc__faq-grid">
        <header class="pm-head pm-head--left svc__faq-head">
          <span class="pm-label" data-reveal>Veelgestelde vragen</span>
          <h2 id="faq-title" class="pm-h2" data-reveal style="--d: 1">Alles over SEA uitbesteden</h2>
          <p class="pm-text" data-reveal style="--d: 2">Staat jouw vraag er niet bij? Neem gerust contact op voor een vrijblijvend gesprek.</p>
          <a href="#contact" class="pm-btn pm-btn--white pm-btn--sm" data-overlay-open data-reveal style="--d: 3">Stel je vraag <Icon name="arrow" /></a>
        </header>
        <ul class="pm-accordion" data-reveal style="--d: 1">
          {faq.map((item) => (
            <li>
              <details class="pm-acc" name="sea-faq">
                <summary>{item.q}</summary>
                <div class="pm-acc__body"><p>{item.a}</p></div>
              </details>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Resultaten -->
    <section class="pm-section pm-section--tight svc__outcomes" aria-labelledby="outcomes-title">
      <div class="pm-container">
        <header class="pm-head">
          <span class="pm-icon pm-icon--yellow" aria-hidden="true" data-reveal><Icon name="target" /></span>
          <h2 id="outcomes-title" class="pm-h2" data-reveal style="--d: 1">Resultaten die je mag verwachten</h2>
        </header>
        <ul class="svc__chips">
          {outcomes.map((o, i) => (
            <li class:list={["pm-tag", i % 3 === 0 ? "pm-tag--yellow" : i % 3 === 1 ? "pm-tag--paper" : "pm-tag--pink"]} data-reveal style={`--d: ${i % 4}`}>{o}</li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Gerelateerd -->
    <section class="pm-section pm-section--tight svc__related" aria-labelledby="related-title">
      <div class="pm-container">
        <header class="pm-head pm-head--left">
          <span id="related-title" class="pm-label">Gerelateerd</span>
        </header>
        <ul class="svc__related-grid">
          {related.map((r, i) => (
            <li data-reveal style={`--d: ${i}`}>
              <a href={r.href} class="pm-card svc__related-card">
                <span class="svc__related-text">
                  <strong>{r.title}</strong>
                  <span>{r.desc}</span>
                </span>
                <span class="svc__arrow" aria-hidden="true"><Icon name="arrow" size={18} stroke={2.4} /></span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- CTA -->
    <section class="pm-band svc__cta" id="contact" aria-labelledby="cta-title">
      <div class="pm-container svc__cta-inner">
        <span class="pm-icon pm-icon--yellow" aria-hidden="true" data-reveal><Icon name="megaphone" /></span>
        <h2 id="cta-title" class="pm-h2 pm-outline svc__cta-title" data-reveal style="--d: 1">Klaar voor winstgevende Google Ads campagnes?</h2>
        <p class="pm-opening svc__cta-text" data-reveal style="--d: 2">We vertalen jouw doelstellingen naar een concreet campagneplan met duidelijke KPI's, scope en verwachte resultaten.</p>
        <a href="#" class="pm-btn pm-btn--yellow" data-overlay-open data-reveal style="--d: 3">Plan kennismaking <Icon name="arrow" /></a>
      </div>
    </section>

    <Footer />
    <ContactOverlay />
  </main>
</BaseLayout>

<style>
  /* ── Hero ───────────────────────────────────────────────────────────── */
  .svc__hero { position: relative; padding-top: 72px; }

  .svc__panel {
    padding: clamp(4rem, 8vw, 6rem) var(--pm-gutter) clamp(12rem, 20vw, 15rem);
  }

  .svc__hero-content {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 1.4rem;
    max-width: 880px;
    margin-inline: auto;
  }

  .svc__back {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--pm-milk);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
