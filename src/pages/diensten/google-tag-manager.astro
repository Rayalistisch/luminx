---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import ContactOverlay from "../../components/ContactOverlay.astro";
import Icon from "../../components/pm/Icon.astro";

const siteOrigin = Astro.site?.toString() ?? "https://luminx.nl";
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin).toString();

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Google Tag Manager – Professionele implementatie & beheer",
  description: "Correcte GTM-implementatie met event tracking, conversie meting en Consent Mode v2 voor betrouwbare data en betere marketingbeslissingen.",
  serviceType: "Tag Management",
  url: canonicalUrl,
  areaServed: "NL",
  provider: {
    "@type": "Organization",
    "@id": `${siteOrigin}/#organization`,
    name: "LUMINX",
    url: siteOrigin,
  },
};

const metrics = [
  { value: "1–2 weken", label: "Volledige implementatie" },
  { value: "100%", label: "Betrouwbare conversiedata" },
  { value: "DMA-proof", label: "Consent Mode v2 inbegrepen" },
];

const direct = [
  "Inzicht in welke campagnes echt converteren",
  "Geen developer nodig bij trackingwijzigingen",
  "Juridisch compliant met GDPR en DMA",
];

const readout = [
  { value: "67%", label: "van besluitvormers vertrouwt eigen data niet" },
  { value: "+37%", label: "meer conversies na correcte GTM-setup" },
  { value: "–76%", label: "lagere cost per lead door data-gedreven bijsturing" },
];

const specialismen = [
  {
    icon: "layers",
    tone: "",
    title: "GTM-implementatie",
    description: "Een schone, gestructureerde GTM-container ingericht met duidelijke naamgeving, versiebeheer en gedocumenteerde tags voor GA4, Google Ads en overige pixels.",
  },
  {
    icon: "target",
    tone: "pm-icon--pink",
    title: "Event & conversie tracking",
    description: "Formulierinzendingen, klikken, scroll-diepte, videoweergaven en andere interacties nauwkeurig bijhouden: volledig aanpasbaar aan jouw funnel.",
  },
  {
    icon: "megaphone",
    tone: "pm-icon--yellow",
    title: "Google Ads conversietracking",
    description: "Correcte koppeling tussen Google Ads campagnes en daadwerkelijke conversies, zodat je biedstrategie op echte data optimaliseert en niet op schijnconversies.",
  },
  {
    icon: "shield",
    tone: "pm-icon--wine",
    title: "Consent Mode v2",
    description: "Regiogebaseerde GTM-configuratie die voldoet aan de DMA: EER-gebruikers standaard geweigerd, overige regio's standaard toegestaan, met behoud van maximale data.",
  },
  {
    icon: "code",
    tone: "",
    title: "DataLayer implementatie",
    description: "Gestructureerde dataLayer-opzet voor e-commerce, leadkwaliteit en gedragsdata, zodat jouw marketingdata altijd betrouwbaar en schaalbaar is.",
  },
  {
    icon: "search",
    tone: "pm-icon--pink",
    title: "GTM-audit & opschoning",
    description: "Beoordeling van bestaande containers: dubbele tags opsporen, verouderde pixels verwijderen, triggers controleren en de container opschonen voor betrouwbare rapportage.",
  },
];

const benefits = [
  {
    title: "Geen afhankelijkheid van development bij elke trackingwijziging",
    body: "Met GTM beheer je alle trackingcodes vanuit één centrale plek. Nieuwe campagne, nieuw formulier of nieuwe pixel: je voegt het zelf toe in minuten, zonder wachtrij bij het dev-team.",
  },
  {
    title: "Betrouwbare data als fundering voor marketingbeslissingen",
    body: "Slechte tracking leidt tot verkeerde beslissingen. Een correcte GTM-implementatie zorgt dat je precies weet welke kanalen, campagnes en zoekwoorden daadwerkelijk leads en omzet opleveren.",
  },
  {
    title: "Juridisch compliant met DMA en GDPR via Consent Mode v2",
    body: "Zonder correcte Consent Mode v2 riskeer je zowel dataverlies als non-compliance. We configureren een regiogebaseerde toestemmingsstructuur die zowel de privacy van bezoekers respecteert als je datakwaliteit beschermt.",
  },
  {
    title: "Volledige controle over welke data naar welk platform gaat",
    body: "Via GTM stuur je bewust welke informatie naar Google Ads, Meta, LinkedIn of andere platformen gaat. Zo behoud je eigenaarschap over je data en voorkom je ongewenste lekken.",
  },
  {
    title: "Sneller debuggen en problemen oplossen",
    body: "Met de GTM preview-modus en gelaagd versiebeheer kun je tracking issues snel lokaliseren en oplossen zonder de live site te raken. Alles is traceerbaar naar een specifieke containerversie.",
  },
];

const steps = [
  { title: "Audit & inventarisatie", body: "Analyse van de bestaande container (of een nulmeting bij nieuwe implementatie): welke tags, triggers en variabelen zijn aanwezig, kloppen ze, en wat ontbreekt?" },
  { title: "Structuur & opzet", body: "Inrichting van een schone container met logische naamgeving, versiebeheer en gedocumenteerde structuur. GA4, Google Ads en Consent Mode v2 als basis." },
  { title: "Implementatie & testen", body: "Tags live zetten via de preview-modus, testen op alle relevante apparaten en browsers, en valideren via GA4 DebugView en Google Ads Tag Diagnostics." },
  { title: "Overdracht & documentatie", body: "Volledige documentatie van de container, overdracht aan jouw team en optionele kennissessie. Daarna continue beschikbaarheid voor aanpassingen en uitbreidingen." },
];

const problemen = [
  "Dubbele GA4-tracking die conversies kunstmatig opblaast",
  "Triggers die vuren op de verkeerde momenten",
  "Container niet gepubliceerd na wijzigingen",
  "Geen Consent Mode v2 terwijl dit verplicht is",
  "Pixels van verlopen campagnes die nog steeds laden",
  "Geen inzicht in welke tags actief zijn en waarom",
];

const opleveringen = [
  "Schone, gedocumenteerde GTM-container met versiebeheer",
  "GA4 implementatie met correcte event- en conversietracking",
  "Google Ads conversietracking en remarketinglijsten",
  "Consent Mode v2 regiogebaseerd geconfigureerd",
  "Validatie via preview, DebugView en Tag Diagnostics",
  "Volledige overdracht en documentatie voor jouw team",
];

const related = [
  {
    href: "/diensten/ga4-implementatie",
    icon: "chart",
    tone: "pm-icon--pink",
    title: "GA4 Implementatie",
    body: "Volledige Google Analytics 4 inrichting met event tracking, conversies en rapportage afgestemd op jouw KPI's.",
    link: "Meer over GA4",
    variant: "pm-card--milk",
  },
  {
    href: "/diensten/consent-mode-v2",
    icon: "shield",
    tone: "pm-icon--wine",
    title: "Consent Mode v2",
    body: "DMA-compliant toestemmingsbeheer dat zowel juridisch waterdicht is als jouw datakwaliteit maximaliseert.",
    link: "Meer over Consent Mode",
    variant: "pm-card--milk",
  },
  {
    href: "/tracking-audit",
    icon: "sparkles",
    tone: "pm-icon--yellow",
    title: "Gratis Tracking-audit",
    body: "Laat ons jouw huidige tracking doorlichten en ontdek welke data je nu mist of verkeerd meet.",
    link: "Start gratis audit",
    variant: "pm-card--plum",
  },
];

const faq = [
  {
    q: "Wat is het verschil tussen Google Tag Manager en Google Analytics?",
    a: "Google Tag Manager is het beheersysteem: het laadt en stuurt alle trackingcodes op je website. Google Analytics is één van de tools die via GTM wordt geladen. GTM zelf verzamelt geen data, het regelt dat de juiste tools op het juiste moment actief zijn.",
  },
  {
    q: "Mijn website heeft al tracking. Waarom zou ik een audit laten doen?",
    a: "Veelgemaakte problemen zijn pas zichtbaar bij een audit: dubbele tags die conversies opblazen, triggers die op het verkeerde moment vuren, een niet-gepubliceerde container of pixels die al jaren ongebruikt in de container staan. Slechte tracking is vaak erger dan geen tracking.",
  },
  {
    q: "Wat is Consent Mode v2 en heb ik dat nodig?",
    a: "Consent Mode v2 is verplicht voor alle websites in de EU/EER die Google Ads of GA4 gebruiken. Zonder correcte implementatie worden geen remarketing-audiences aangevuld en ontvangt GA4 geen data van bezoekers die tracking weigeren. Dit is geen optie meer, het is een vereiste.",
  },
  {
    q: "Hoe snel is een GTM-implementatie gerealiseerd?",
    a: "Een volledige implementatie van GTM met GA4, Google Ads conversietracking en Consent Mode v2 is doorgaans binnen één tot twee werkweken gerealiseerd. Een audit en opschoning van een bestaande container kan sneller gaan.",
  },
  {
    q: "Kunnen jullie ook de koppeling met Google Ads maken?",
    a: "Ja. We richten niet alleen GTM in, maar verzorgen ook de volledige koppeling met Google Ads conversietracking en remarketinglijsten. Zo zijn jouw campagnes gebaseerd op betrouwbare data vanaf dag één.",
  },
];

const outcomes = [
  "Betrouwbare conversiedata",
  "Correcte Google Ads attributie",
  "DMA & GDPR-compliance",
  "Geen dubbele tags",
  "Snellere tracking-aanpassingen",
  "Volledig gedocumenteerde container",
  "Betere marketingbeslissingen",
  "Lager cost per lead",
];

const reads = [
  { href: "/diensten/ga4-implementatie", title: "GA4 Implementatie", body: "Betrouwbare analytics als basis voor betere beslissingen." },
  { href: "/diensten/consent-mode-v2", title: "Consent Mode v2", body: "GDPR-compliant meten zonder dataverlies." },
  { href: "/tracking-audit", title: "Gratis Tracking-audit", body: "Ontdek of jouw GTM-container correct is ingericht." },
];

const pillTones = ["pm-tag--yellow", "pm-tag--pink", "", "pm-tag--paper"];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map(({ q, a }) => ({
    "@type": "Question",
    name: q,
    acceptedAnswer: { "@type": "Answer", text: a },
  })),
};
---

<BaseLayout
  title="Google Tag Manager Implementatie & Beheer | LuminX Twente"
  description="Professionele GTM-implementatie met event tracking, conversie meting en Consent Mode v2. Betrouwbare data als basis voor betere marketingbeslissingen."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(serviceSchema)}></script>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
  <Nav basePath="/" />

  <main class="svc">

    <!-- Hero -->
    <section class="svc__hero" aria-labelledby="svc-title">
      <div class="pm-stack">
        <span class="pm-stack__layer" aria-hidden="true"></span>
        <span class="pm-stack__layer" aria-hidden="true"></span>
        <span class="pm-stack__layer" aria-hidden="true"></span>
        <div class="pm-stack__panel svc__panel">
          <div class="svc__hero-content">
            <a href="/diensten/online-marketing" class="svc__back" data-reveal><Icon name="arrow" size={16} /> Online Marketing</a>
            <span class="pm-tag pm-tag--pink" data-reveal style="--d: 1">Specialisme</span>
            <h1 id="svc-title" class="pm-h1 svc__title" data-reveal style="--d: 2">Google Tag Manager</h1>
            <p class="pm-opening svc__sub" data-reveal style="--d: 3">Wij richten GTM in als een betrouwbaar datasysteem: gestructureerd, gedocumenteerd en volledig afgestemd op jouw funnel, campagnes en privacyvereisten.</p>
            <div class="svc__actions" data-reveal style="--d: 4">
              <a href="#contact" class="pm-btn pm-btn--yellow" data-overlay-open>Gratis tracking-audit <Icon name="arrow" /></a>
              <a href="#aanpak" class="pm-btn pm-btn--white">Bekijk aanpak</a>
            </div>
          </div>
        </div>
      </div>

      <div class="pm-container svc__float-wrap">
        <div class="pm-card pm-card--lift svc__float" data-reveal>
          <ul class="svc__metrics">
            {metrics.map((m) => (
              <li class="pm-stat svc__metric">
                <strong class="pm-stat__value">{m.value}</strong>
                <span class="pm-stat__label">{m.label}</span>
              </li>
            ))}
          </ul>
          <div class="svc__glance">
            <div class="svc__glance-head">
              <span class="pm-icon pm-icon--sm" aria-hidden="true"><Icon name="code" /></span>
              <span class="pm-label">Wat je direct merkt</span>
            </div>
            <ul class="pm-checks">
              {direct.map((d) => <li>{d}</li>)}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Wat is GTM -->
    <section class="pm-section" aria-labelledby="gtm-what-title">
      <div class="pm-container pm-split svc__intro-grid">
        <div class="svc__intro-text">
          <span class="pm-label" data-reveal>Wat is GTM?</span>
          <h2 id="gtm-what-title" class="pm-h2" data-reveal style="--d: 1">De fundering van elke data-gedreven marketingstrategie</h2>
          <p class="pm-text" data-reveal style="--d: 2">Google Tag Manager is het centrale beheersysteem voor alle trackingcodes op jouw website. In plaats van losse scripts verspreid door je broncode, beheer je via GTM alles vanuit één gestructureerde container: GA4, Google Ads, Meta Pixel, LinkedIn Tag en meer.</p>
          <p class="pm-text" data-reveal style="--d: 3">Maar GTM is meer dan gemak. Een correct ingericht systeem bepaalt of jouw marketingdata betrouwbaar is, en daarmee of jouw marketingbeslissingen op feiten of fictie zijn gebaseerd.</p>
          <a href="/tracking-audit" class="pm-link" data-reveal style="--d: 4">Controleer jouw tracking gratis <Icon name="arrow" size={18} /></a>
        </div>
        <figure class="pm-card pm-card--lift svc__readout" data-reveal style="--d: 2">
          <div class="svc__readout-bar" aria-hidden="true"><i></i><i></i><i></i><span>gtm.container</span></div>
          <ul class="svc__readout-list">
            {readout.map((r) => (
              <li><strong>{r.value}</strong><span>{r.label}</span></li>
            ))}
          </ul>
        </figure>
      </div>
    </section>

    <!-- Specialismen -->
    <section class="pm-section pm-section--tight" aria-labelledby="gtm-services-title">
      <div class="pm-container">
        <header class="pm-head">
          <span class="pm-label" data-reveal>Specialismen</span>
          <h2 id="gtm-services-title" class="pm-h2" data-reveal style="--d: 1">Wat wij voor je implementeren</h2>
          <p class="pm-opening" data-reveal style="--d: 2">Van een schone container-opzet tot complexe e-commerce datalagen: we beheersen het volledige GTM-spectrum en stemmen elk onderdeel af op jouw marketingstrategie.</p>
        </header>
        <ul class="svc__grid">
          {specialismen.map((item, i) => (
            <li data-reveal style={`--d: ${i % 3}`}>
              <article class="pm-card svc__tile">
                <span class:list={["pm-icon", item.tone]} aria-hidden="true"><Icon name={item.icon} /></span>
                <h3 class="pm-h3">{item.title}</h3>
                <p class="pm-text">{item.description}</p>
              </article>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Voordelen -->
    <section class="pm-section" aria-labelledby="gtm-benefits-title">
      <div class="pm-container pm-split">
        <div class="pm-card pm-card--yellow pm-card--lift svc__feature" data-reveal>
          <span class="pm-label">Waarom uitbesteden?</span>
          <h2 id="gtm-benefits-title" class="pm-h2">Voordelen van een correcte GTM-implementatie</h2>
          <p class="pm-text">Een GTM-container die niet klopt werkt net als een kapotte meetlat: alles ziet er gemeten uit, maar de uitkomsten kloppen niet. Dit zijn de voordelen van een professioneel ingerichte container.</p>
          <div class="svc__feature-stats">
            <div class="pm-stat"><strong class="pm-stat__value">1–2 wkn</strong><span class="pm-stat__label">Van audit naar live implementatie</span></div>
            <div class="pm-stat"><strong class="pm-stat__value">100%</strong><span class="pm-stat__label">Eigenaarschap van jouw data</span></div>
          </div>
        </div>
        <ul class="pm-accordion" data-reveal style="--d: 1">
          {benefits.map((b, i) => (
            <li>
              <details class="pm-acc" name="gtm-benefits" open={i === 0}>
                <summary>{b.title}</summary>
                <div class="pm-acc__body"><p>{b.body}</p></div>
              </details>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Aanpak -->
    <section class="pm-section pm-section--tight" id="aanpak" aria-labelledby="gtm-approach-title">
      <div class="pm-container">
        <div class="pm-card pm-card--plum pm-card--lift svc__steps-card">
          <header class="pm-head">
            <span class="pm-tag pm-tag--pink" data-reveal>Aanpak</span>
            <h2 id="gtm-approach-title" class="pm-h2" data-reveal style="--d: 1">Van rommelige container naar betrouwbaar datasysteem in vier stappen.</h2>
          </header>
          <ol class="svc__steps" style="--steps: 4">
            {steps.map((s, i) => (
              <li class="svc__step" data-reveal style={`--d: ${i}`}>
                <span class="pm-icon pm-icon--yellow svc__step-num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
                <h3 class="pm-h3">{s.title}</h3>
                <p>{s.body}</p>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <!-- Context -->
    <section class="pm-section" aria-label="Knelpunten en oplevering">
      <div class="pm-container pm-split svc__duo">
        <article class="pm-card" data-reveal>
          <div class="svc__duo-head">
            <span class="pm-icon pm-icon--pink" aria-hidden="true"><Icon name="alert" /></span>
            <h2 class="pm-h2">Waar organisaties op vastlopen</h2>
          </div>
          <ul class="pm-checks pm-checks--x">
            {problemen.map((p) => <li>{p}</li>)}
          </ul>
        </article>
        <article class="pm-card pm-card--milk pm-card--lift" data-reveal style="--d: 1">
          <div class="svc__duo-head">
            <span class="pm-icon pm-icon--yellow" aria-hidden="true"><Icon name="check" /></span>
            <h2 class="pm-h2">Wat wij concreet opleveren</h2>
          </div>
          <ul class="pm-checks">
            {opleveringen.map((o) => <li>{o}</li>)}
          </ul>
        </article>
      </div>
    </section>

    <!-- Gerelateerde diensten -->
    <section class="pm-section pm-section--tight" aria-labelledby="gtm-related-title">
      <div class="pm-container">
        <header class="pm-head pm-head--left">
          <span class="pm-label" data-reveal>Gerelateerde diensten</span>
          <h2 id="gtm-related-title" class="pm-h2" data-reveal style="--d: 1">Combineer GTM met de juiste analytics-strategie</h2>
        </header>
        <ul class="svc__related">
          {related.map((r, i) => (
            <li data-reveal style={`--d: ${i}`}>
              <a href={r.href} class:list={["pm-card", r.variant, "svc__rel"]}>
                <span class:list={["pm-icon", r.tone]} aria-hidden="true"><Icon name={r.icon} /></span>
                <h3 class="pm-h3">{r.title}</h3>
                <p class="pm-text">{r.body}</p>
                <span class="pm-link">{r.link} <Icon name="arrow" size={18} /></span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- FAQ -->
    <section class="pm-section" aria-labelledby="gtm-faq-title">
      <div class="pm-container pm-container--narrow">
        <header class="pm-head svc__faq-head">
          <span class="pm-label" data-reveal>Veelgestelde vragen</span>
          <h2 id="gtm-faq-title" class="pm-h2" data-reveal style="--d: 1">Alles over Google Tag Manager</h2>
          <p class="pm-opening" data-reveal style="--d: 2">Staat jouw vraag er niet bij? Neem gerust contact op voor een vrijblijvend gesprek.</p>
          <a href="#contact" class="pm-link" data-overlay-open data-reveal style="--d: 3">Stel je vraag <Icon name="arrow" size={18} /></a>
        </header>
        <ul class="pm-accordion" data-reveal>
          {faq.map((item, i) => (
            <li>
              <details class="pm-acc" name="gtm-faq" open={i === 0}>
                <summary>{item.q}</summary>
                <div class="pm-acc__body"><p>{item.a}</p></div>
              </details>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Resultaten -->
    <section class="pm-band pm-band--paper pm-section pm-section--tight" aria-labelledby="gtm-outcomes-title">
      <div class="pm-container svc__outcomes-inner">
        <h2 id="gtm-outcomes-title" class="pm-h2" data-reveal>Resultaten die je mag verwachten</h2>
        <ul class="svc__pills">
          {outcomes.map((o, i) => (
            <li data-reveal style={`--d: ${i}`}><span class:list={["pm-tag", pillTones[i % pillTones.length]]}>{o}</span></li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Gerelateerde links -->
    <section class="pm-section pm-section--tight" aria-label="Gerelateerde diensten">
      <div class="pm-container">
        <span class="pm-label svc__reads-label">Gerelateerde diensten</span>
        <ul class="svc__reads">
          {reads.map((r, i) => (
            <li data-reveal style={`--d: ${i}`}>
              <a href={r.href} class="pm-card pm-card--milk svc__read">
                <span><strong>{r.title}</strong><small>{r.body}</small></span>
                <Icon name="arrow" />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- CTA -->
    <section class="pm-band svc__cta" id="contact" aria-labelledby="gtm-cta-title">
      <div class="pm-container svc__cta-inner">
        <h2 id="gtm-cta-title" class="pm-h2 pm-outline svc__cta-title" data-reveal>Weet jij zeker dat jouw tracking klopt?</h2>
        <p class="pm-opening svc__cta-text" data-reveal style="--d: 1">We analyseren jouw GTM-container en trackingopzet, en presenteren concreet wat er beter kan, inclusief directe fixes en prioriteiten.</p>
        <a href="#" class="pm-btn pm-btn--yellow" data-overlay-open data-reveal style="--d: 2">Plan gratis tracking-audit <Icon name="arrow" /></a>
      </div>
    </section>
  </main>

  <Footer />
  <ContactOverlay />
</BaseLayout>

<style>
  /* ── Hero: stacked plum panel + overlapping "at a glance" card ───────── */
  .svc__hero { position: relative; padding-top: 72px; }

  .svc__panel {
    padding: clamp(4.5rem, 8vw, 6.5rem) var(--pm-gutter) clamp(10rem, 17vw, 13rem);
  }

  .svc__hero-content {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 1.4rem;
    max-width: 920px;
    margin-inline: auto;
  }

  .svc__back {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--pm-milk);
    font-size: 0.875rem;
    font-weight: 700;
    text-decoration: none;
    opacity: 0.85;
    transition: opacity 0.25s ease;
  }
  .svc__back svg { transform: rotate(180deg); }
  @media (hover: hover) { .svc__back:hover { opacity: 1; } }

  .svc__title { color: var(--pm-milk); }
  .svc__sub { max-width: 640px; }

