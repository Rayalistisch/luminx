---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import ContactOverlay from "../../components/ContactOverlay.astro";
import Icon from "../../components/pm/Icon.astro";

const siteOrigin = Astro.site?.toString() ?? "https://luminx.nl";
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin).toString();

const faq = [
  {
    q: "Wat is het verschil tussen SEO en SEA?",
    a: "SEO genereert organisch verkeer door hoger te ranken in zoekmachines zonder per klik te betalen. SEA is betaald adverteren in zoekmachines, waarbij je per klik betaalt voor directe zichtbaarheid. SEO is een langetermijninvestering, SEA levert direct verkeer maar stopt zodra het budget op is.",
  },
  {
    q: "Wat is goedkoper: SEO of SEA?",
    a: "Op korte termijn is SEA vaak effectiever qua directe resultaten, maar elke klik kost geld. SEO vereist een hogere initiële investering maar levert op termijn verkeer zonder klikkosten. De meeste bedrijven halen het beste rendement uit een combinatie van beide.",
  },
  {
    q: "Kan ik beginnen met SEA en later overstappen naar SEO?",
    a: "Ja, dat is een veelgebruikte strategie. SEA levert direct verkeer en data over welke zoekwoorden converteren. Die data gebruik je vervolgens om een gerichte SEO-strategie op te bouwen. Zodra organische posities groeien, verschuif je budget van SEA naar andere kanalen.",
  },
  {
    q: "Hoe snel levert SEO resultaat op vergeleken met SEA?",
    a: "SEA levert binnen een dag verkeer op na het activeren van campagnes. SEO heeft doorgaans drie tot zes maanden nodig voor zichtbare resultaten, en zes tot twaalf maanden voor structurele posities. Het verschil: SEA-verkeer stopt bij budgetstop, SEO-verkeer loopt door.",
  },
  {
    q: "Heeft SEA invloed op mijn SEO-posities?",
    a: "Niet direct. Google heeft bevestigd dat betaalde advertenties geen invloed hebben op organische rankings. Indirect kan SEA wel bijdragen: meer verkeer naar je site kan leiden tot hogere merkbekendheid en meer branded searches, wat weer positief is voor SEO.",
  },
  {
    q: "Wanneer is alleen SEO voldoende?",
    a: "Als je een langetermijnhorizon hebt, beperkt budget voor advertenties, en opereert in een niche waar organische concurrentie beheersbaar is. Voor bedrijven die direct omzet moeten draaien of in zeer competitieve markten opereren, is een combinatie met SEA vrijwel altijd effectiever.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map(({ q, a }) => ({
    "@type": "Question",
    name: q,
    acceptedAnswer: { "@type": "Answer", text: a },
  })),
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: "SEO vs. SEA: wat is het verschil en wanneer kies je wat?",
  description: "Een feitelijke vergelijking van Search Engine Optimization (SEO) en Search Engine Advertising (SEA). Kosten, doorlooptijd, rendement en wanneer je welke strategie inzet.",
  url: canonicalUrl,
  author: {
    "@type": "Organization",
    "@id": `${siteOrigin}/#organization`,
    name: "LUMINX",
    url: siteOrigin,
  },
};

const stats = [
  { value: "70%", label: "Van alle klikken gaat naar organische resultaten" },
  { value: "Direct", label: "SEA levert verkeer vanaf dag 1" },
  { value: "2x tot 5x", label: "ROI van SEO op lange termijn vs. SEA" },
];

const contenders = [
  {
    tone: "pink",
    icon: "search",
    short: "SEO",
    title: "Search Engine Optimization",
    body: "SEO is het optimaliseren van websites om organisch hoger te ranken in zoekmachines. Het omvat technische optimalisatie, contentcreatie en linkbuilding. Verkeer via SEO is gratis per klik, maar vereist een structurele investering in content en autoriteit.",
    points: [
      "Geen klikkosten na het behalen van posities",
      "Resultaat groeit over tijd en is cumulatief",
      "Vereist doorlopende investering in content en techniek",
      "Doorlooptijd: 3 tot 12 maanden voor structurele posities",
    ],
  },
  {
    tone: "yellow",
    icon: "megaphone",
    short: "SEA",
    title: "Search Engine Advertising",
    body: "SEA is betaald adverteren in zoekmachines, voornamelijk via Google Ads. Advertenties verschijnen bovenaan de zoekresultaten op basis van zoekwoorden, biedingen en kwaliteitsscore. Verkeer stopt zodra het budget op is of campagnes worden gepauzeerd.",
    points: [
      "Direct verkeer vanaf de eerste dag",
      "Volledige controle over targeting en budget",
      "Betaling per klik, kosten stijgen met concurrentie",
      "Meetbaar tot op conversieniveau",
    ],
  },
] as const;

const rows = [
  ["Kosten", "Investering in content en techniek, geen klikkosten", "Betaling per klik, budget bepaalt bereik"],
  ["Snelheid", "3 tot 12 maanden voor structurele posities", "Direct verkeer na activatie campagne"],
  ["Duurzaamheid", "Verkeer loopt door na het stoppen van investering", "Verkeer stopt bij budgetstop"],
  ["Controle", "Beperkt, Google bepaalt de ranking", "Volledig: targeting, biedingen, planning"],
  ["Vertrouwen", "Organische resultaten genieten meer vertrouwen", "Gebruikers herkennen advertenties als betaald"],
  ["Data", "Beperkte keyword-data via Search Console", "Gedetailleerde data per zoekwoord en doelgroep"],
  ["Schaalbaarheid", "Schaalt met contentproductie en autoriteit", "Schaalt met budget, maar kosten stijgen mee"],
  ["Beste voor", "Langetermijn merkopbouw en organisch bereik", "Directe verkoop, lanceringen en seizoenspieken"],
];

const when = [
  {
    title: "Wanneer is SEA het startpunt?",
    paras: [
      "SEA is de logische keuze wanneer snelheid belangrijk is. Bij een productlancering, seizoenscampagne of wanneer een bedrijf direct omzet moet genereren, levert SEA resultaat vanaf dag een. Daarnaast is SEA waardevol voor het testen van marktvraag: welke zoekwoorden converteren? Welke productpagina's presteren? Die inzichten zijn goud waard voor de SEO-strategie die erachteraan komt.",
      "Concrete situaties: een nieuwe webshop die direct verkopen nodig heeft, een B2B-bedrijf dat wil testen welke dienst het meeste interesse genereert, of een seizoensgebonden bedrijf dat alleen in piekperiodes adverteert.",
    ],
  },
  {
    title: "Wanneer weegt SEO zwaarder?",
    paras: [
      "SEO weegt zwaarder wanneer een bedrijf langetermijnwaarde wil opbouwen. Organisch verkeer is cumulatief: een artikel dat vandaag goed rankt, levert morgen, volgende maand en volgend jaar verkeer op. Die eigenschap maakt SEO bijzonder rendabel voor bedrijven met een langetermijnhorizon.",
      "Daarnaast geldt: hoe hoger de klikprijs in een branche, hoe waardevoller organisch verkeer wordt. In branches als verzekeringen, juridisch advies of financiele dienstverlening kan een enkele organische positie tienduizenden euros per maand aan advertentiekosten besparen.",
    ],
  },
  {
    title: "De data-feedback loop",
    paras: [
      "Een van de sterkste argumenten voor het combineren van SEO en SEA is de data-feedback loop. SEA-campagnes genereren gedetailleerde data: welke zoekwoorden leiden tot conversies, welke advertentieteksten presteren en welke landingspagina's het beste werken. Die informatie is direct bruikbaar voor SEO-optimalisatie.",
      "Andersom geldt hetzelfde. Pagina's die organisch goed presteren, zijn sterke kandidaten voor SEA-campagnes. De kwaliteitsscore in Google Ads stijgt wanneer de landingspagina relevant en goed geoptimaliseerd is, wat resulteert in lagere klikprijzen. SEO en SEA versterken elkaar op dataniveau.",
    ],
  },
];

const verdict = {
  title: "SEO en SEA vullen elkaar aan",
  paras: [
    "De meest effectieve zoekmachinestrategie combineert beide kanalen. SEA levert direct verkeer en waardevolle data over welke zoekwoorden converteren. Die data vormt de basis voor een gerichte SEO-strategie. Zodra organische posities groeien, verschuift het gewicht van betaald naar organisch verkeer.",
    "Bedrijven die uitsluitend op SEA vertrouwen, zijn kwetsbaar: stijgende klikprijzen eten de marge op, en zodra het budget stopt, stopt het verkeer. Bedrijven die uitsluitend op SEO inzetten, missen direct rendement en de data die SEA oplevert. De optimale verhouding verschuift over tijd, maar vrijwel geen enkel bedrijf vaart het beste bij een exclusieve keuze voor een van beide.",
  ],
};

const scenarios = [
  {
    title: "Startend bedrijf",
    body: "Begin met SEA voor directe zichtbaarheid en data. Investeer parallel in SEO-fundamenten: techniek, structuur en initiële content. Verschuif budget naar SEO zodra organische posities groeien.",
    rec: ["SEA", "+ SEO-basis"],
    tone: "yellow",
  },
  {
    title: "Gevestigd bedrijf",
    body: "Focus op SEO voor structureel organisch verkeer. Gebruik SEA selectief voor campagnes, productlanceringen of het verdedigen van merkzoekwoorden tegen concurrenten.",
    rec: ["SEO", "+ tactische SEA"],
    tone: "pink",
  },
  {
    title: "E-commerce",
    body: "Combineer beide zwaar. SEA voor Shopping-campagnes en directe verkoop. SEO voor categoriepagina's, productbeschrijvingen en long-tail zoekwoorden die op termijn gratis verkeer leveren.",
    rec: ["SEO + SEA", "beide essentieel"],
    tone: "red",
  },
  {
    title: "B2B dienstverlener",
    body: "SEO is het primaire kanaal: thought leadership, pillar content en autoriteitsopbouw. SEA voor het testen van nieuwe diensten, evenementpromotie en retargeting van websitebezoekers.",
    rec: ["SEO", "+ gerichte SEA"],
    tone: "pink",
  },
] as const;

const services = [
  { href: "/diensten/seo", short: "SEO", title: "Meer over SEO", desc: "Bekijk ons SEO specialisme", tone: "pink", icon: "search" },
  { href: "/diensten/sea", short: "SEA", title: "Meer over SEA", desc: "Bekijk ons SEA specialisme", tone: "yellow", icon: "megaphone" },
] as const;
---

<BaseLayout
  title="SEO vs. SEA: wat is het verschil? | LuminX"
  description="Feitelijke vergelijking van SEO en SEA. Kosten, doorlooptijd, rendement en wanneer je welke strategie inzet. Inclusief keuzehulp en veelgestelde vragen."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)}></script>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
  <Nav basePath="/" />

  <main class="vgl">

    <!-- Hero: stacked plum panel -->
    <section class="vgl__hero" aria-labelledby="vgl-title">
      <div class="pm-stack">
        <span class="pm-stack__layer" aria-hidden="true"></span>
        <span class="pm-stack__layer" aria-hidden="true"></span>
        <span class="pm-stack__layer" aria-hidden="true"></span>
        <div class="pm-stack__panel vgl__panel">
          <div class="vgl__hero-content">
            <span class="pm-tag" data-reveal>Vergelijking</span>
            <h1 id="vgl-title" class="pm-h1 vgl__title" data-reveal style="--d: 1">
              SEO <span class="vgl__vs">vs.</span> SEA
            </h1>
            <p class="pm-opening" data-reveal style="--d: 2">Organisch of betaald? Langetermijn of direct resultaat? Dit is een feitelijke vergelijking van Search Engine Optimization en Search Engine Advertising: kosten, doorlooptijd, rendement en wanneer je welke strategie inzet.</p>
            <div class="vgl__actions" data-reveal style="--d: 3">
              <a href="#vergelijking" class="pm-btn pm-btn--yellow">Bekijk de vergelijking <Icon name="arrow" /></a>
              <a href="#" class="pm-btn pm-btn--white" data-overlay-open>Plan kennismaking</a>
            </div>
          </div>
        </div>
      </div>

      <!-- Head-to-head cards overlapping the panel -->
      <div class="pm-container vgl__duel-wrap">
        <div class="vgl__duel">
          {contenders.map((c, i) => (
            <article class:list={["pm-card", "pm-card--lift", "vgl__side", `vgl__side--${c.tone}`]} data-reveal style={`--d: ${i}`}>
              <header class="vgl__side-top">
                <span class:list={["pm-icon", c.tone === "yellow" ? "pm-icon--milk" : "pm-icon--wine"]}><Icon name={c.icon} /></span>
                <div>
                  <span class="vgl__side-short">{c.short}</span>
                  <h2 class="pm-h3">{c.title}</h2>
                </div>
              </header>
              <div class="vgl__side-body">
                <p class="pm-text">{c.body}</p>
                <ul class="pm-checks">
                  {c.points.map((p) => <li>{p}</li>)}
                </ul>
              </div>
            </article>
          ))}
          <span class="vgl__badge" aria-hidden="true">vs</span>
        </div>
      </div>
    </section>

    <!-- Intro + stats -->
    <section class="pm-section vgl__intro" aria-labelledby="vgl-intro-title">
      <div class="pm-container pm-split vgl__intro-grid">
        <div class="vgl__intro-text" data-reveal>
          <span class="pm-label">Het vraagstuk</span>
          <h2 id="vgl-intro-title" class="pm-h2">Het meest gestelde marketingvraagstuk</h2>
          <p class="pm-text">"Moeten we investeren in SEO of in SEA?" is een van de meest voorkomende vragen bij bedrijven die hun online zichtbaarheid willen vergroten. Het antwoord hangt af van budget, tijdshorizon, concurrentie en bedrijfsdoelen.</p>
          <p class="pm-text">SEO en SEA zijn geen concurrenten maar complementaire kanalen. Toch zijn er situaties waarin het ene kanaal duidelijk meer rendement oplevert dan het andere. Deze pagina legt beide naast elkaar met feitelijke informatie over kosten, doorlooptijd en effectiviteit.</p>
        </div>
        <ul class="vgl__stats">
          {stats.map((s, i) => (
            <li class="pm-card pm-card--milk vgl__stat" data-reveal style={`--d: ${i + 1}`}>
              <div class="pm-stat">
                <span class="pm-stat__value">{s.value}</span>
                <span class="pm-stat__label">{s.label}</span>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Comparison table -->
    <section class="pm-band pm-band--paper pm-section vgl__compare" id="vergelijking" aria-labelledby="vgl-compare-title">
      <div class="pm-container">
        <header class="pm-head">
          <span class="pm-label" data-reveal>Vergelijking</span>
          <h2 id="vgl-compare-title" class="pm-h2" data-reveal style="--d: 1">SEO en SEA naast elkaar</h2>
        </header>
        <div class="vgl__table-wrap" data-reveal style="--d: 2">
          <table class="vgl__table">
            <thead>
              <tr>
                <th scope="col">Aspect</th>
                <th scope="col"><span class="vgl__dot vgl__dot--pink" aria-hidden="true"></span>SEO</th>
                <th scope="col"><span class="vgl__dot vgl__dot--yellow" aria-hidden="true"></span>SEA</th>
              </tr>
            </thead>
            <tbody>
              {rows.map(([aspect, a, b]) => (
                <tr>
                  <th scope="row">{aspect}</th>
                  <td data-label="SEO">{a}</td>
                  <td data-label="SEA">{b}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- When to choose what + verdict -->
    <section class="pm-section vgl__when" aria-labelledby="vgl-when-title">
      <div class="pm-container">
        <header class="pm-head">
          <span class="pm-label" data-reveal>Wanneer kies je wat</span>
          <h2 id="vgl-when-title" class="pm-h2" data-reveal style="--d: 1">Organisch, betaald of allebei?</h2>
        </header>
        <div class="pm-split vgl__when-grid">
          <ul class="pm-accordion" data-reveal>
            {when.map((w, i) => (
              <li>
                <details class="pm-acc" name="vgl-when" open={i === 0}>
                  <summary><h3 class="vgl__acc-title">{w.title}</h3></summary>
                  <div class="pm-acc__body">{w.paras.map((p) => <p>{p}</p>)}</div>
                </details>
              </li>
            ))}
          </ul>
          <article class="pm-card pm-card--plum pm-card--lift pm-card--pad vgl__verdict" data-reveal style="--d: 1">
            <span class="pm-tag pm-tag--yellow"><Icon name="check" size={16} /> Ons oordeel</span>
            <h3 class="pm-h2 vgl__verdict-title">{verdict.title}</h3>
            {verdict.paras.map((p) => <p class="vgl__verdict-text">{p}</p>)}
            <a href="#" class="pm-btn pm-btn--yellow" data-overlay-open>Plan kennismaking <Icon name="arrow" /></a>
          </article>
        </div>
      </div>
    </section>

    <!-- Keuzehulp -->
    <section class="pm-band pm-band--plum pm-section vgl__scen" aria-labelledby="vgl-scen-title">
      <div class="pm-container">
        <header class="pm-head">
          <span class="pm-label vgl__on-dark" data-reveal>Keuzehulp</span>
          <h2 id="vgl-scen-title" class="pm-h2" data-reveal style="--d: 1">Welk kanaal past bij jouw situatie?</h2>
        </header>
        <div class="vgl__scen-grid">
          {scenarios.map((s, i) => (
            <article class="pm-card pm-card--milk vgl__scen-card" data-reveal style={`--d: ${i}`}>
              <div class:list={["vgl__scen-top", `vgl__scen-top--${s.tone}`]}>
                <h3 class="pm-h3">{s.title}</h3>
              </div>
              <div class="vgl__scen-body">
                <p class="pm-text">{s.body}</p>
                <p class="vgl__rec">
                  <span class="pm-tag pm-tag--yellow">{s.rec[0]}</span>
                  <span class="pm-tag pm-tag--paper">{s.rec[1]}</span>
                </p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="pm-section vgl__faq" aria-labelledby="vgl-faq-title">
      <div class="pm-container pm-split vgl__faq-grid">
        <header class="pm-head pm-head--left vgl__faq-head" data-reveal>
          <span class="pm-label">Veelgestelde vragen</span>
          <h2 id="vgl-faq-title" class="pm-h2">SEO vs. SEA: veelgestelde vragen</h2>
          <p class="pm-text">Staat jouw vraag er niet bij? Neem contact op voor een vrijblijvend gesprek.</p>
          <a href="#contact" class="pm-link" data-overlay-open>Stel je vraag <Icon name="arrow" size={18} /></a>
        </header>
        <ul class="pm-accordion" data-reveal style="--d: 1">
          {faq.map((item) => (
            <li>
              <details class="pm-acc" name="vgl-faq">
                <summary>{item.q}</summary>
                <div class="pm-acc__body"><p>{item.a}</p></div>
              </details>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Service links -->
    <section class="pm-section--tight vgl__more" aria-label="Meer over onze specialismen">
      <div class="pm-container pm-split" data-reveal>
        {services.map((s) => (
          <a href={s.href} class:list={["pm-card", "pm-card--lift", "vgl__more-card", `vgl__more-card--${s.tone}`]}>
            <span class:list={["pm-icon", s.tone === "yellow" ? "pm-icon--milk" : "pm-icon--wine"]}><Icon name={s.icon} /></span>
            <span class="vgl__more-text">
              <span class="pm-label">{s.short}</span>
              <h3 class="pm-h3">{s.title}</h3>
              <span class="pm-text">{s.desc}</span>
            </span>
            <span class="vgl__arrow" aria-hidden="true"><Icon name="arrow" size={18} stroke={2.4} /></span>
          </a>
        ))}
      </div>
    </section>

    <!-- Closing CTA -->
    <section class="pm-band vgl__cta" id="contact" aria-labelledby="vgl-cta-title">
      <div class="pm-container vgl__cta-inner">
        <h2 id="vgl-cta-title" class="pm-h2 pm-outline vgl__cta-title" data-reveal>SEO, SEA of beide?<br />We denken mee.</h2>
        <p class="pm-opening vgl__cta-text" data-reveal style="--d: 1">Vertel ons je situatie en we adviseren welke strategie het meeste rendement oplevert voor jouw bedrijf.</p>
        <div class="vgl__cta-actions" data-reveal style="--d: 2">
          <a href="#" class="pm-btn pm-btn--yellow" data-overlay-open>Plan kennismaking <Icon name="arrow" /></a>
        </div>
      </div>
    </section>

    <Footer />
    <ContactOverlay />
  </main>
</BaseLayout>

<style>
  /* ── Hero ─────────────────────────────────────────── */
  .vgl__hero { position: relative; padding-top: 72px; }
  .vgl__panel { padding: clamp(4.5rem, 8vw, 6.5rem) var(--pm-gutter) clamp(12rem, 20vw, 15rem); }
  .vgl__hero-content {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 1.5rem;
    max-width: 880px;
    margin-inline: auto;
  }
  .vgl__title { color: var(--pm-milk); }
  .vgl__vs { color: var(--pm-yellow); }
  .vgl__actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 1rem; margin-top: 0.5rem; }

  /* ── Head-to-head ─────────────────────────────────── */
  .vgl__duel-wrap { position: relative; z-index: 2; margin-top: clamp(-10rem, -16vw, -8rem); }
  .vgl__duel {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 2.5vw, 2rem);
    max-width: 1180px;
    margin-inline: auto;
  }
  .vgl__side { display: flex; flex-direction: column; background: var(--pm-milk); }
  .vgl__side-top {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border-bottom: var(--pm-border);
  }
  .vgl__side--pink .vgl__side-top { background: var(--pm-pink); }
  .vgl__side--yellow .vgl__side-top { background: var(--pm-yellow); }
  .vgl__side-short {
    display: block;
    font-family: var(--pm-display);
    font-size: clamp(2rem, 3.4vw, 2.75rem);
    line-height: 1;
  }
  .vgl__side-top .pm-h3 { font-family: var(--pm-body); font-size: 1rem; font-weight: 700; margin-top: 0.3rem; }
  .vgl__side-body { display: grid; gap: 1.5rem; padding: clamp(1.5rem, 3vw, 2.25rem); }
  .vgl__badge {
    position: absolute;
    left: 50%;
    top: clamp(2.5rem, 4vw, 3.25rem);
    translate: -50% 0;
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border: var(--pm-border);
    border-radius: 50%;
    background: var(--pm-red);
    color: var(--pm-milk);
    box-shadow: 0 4px 0 var(--pm-ink);
    font-family: var(--pm-display);
    font-size: 1.6rem;
    line-height: 1;
    z-index: 3;
  }

  /* ── Intro ────────────────────────────────────────── */
  .vgl__intro-grid { align-items: center; gap: clamp(2rem, 5vw, 5rem); }
  .vgl__intro-text { display: grid; gap: 1rem; }
  .vgl__intro-text .pm-text + .pm-text { margin-top: 0; }
