---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import ContactOverlay from "../../components/ContactOverlay.astro";
import Icon from "../../components/pm/Icon.astro";

const siteOrigin = Astro.site?.toString() ?? "https://luminx.nl";
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin).toString();

const faq = [
  {
    q: "Wat is het verschil tussen GEO en SEO?",
    a: "SEO optimaliseert voor posities in zoekmachines zoals Google. GEO optimaliseert voor zichtbaarheid in AI-gegenereerde antwoorden van tools als ChatGPT, Gemini en Perplexity. SEO draait om klikposities, GEO draait om geciteerd worden als bron.",
  },
  {
    q: "Moet ik kiezen tussen GEO en SEO?",
    a: "Nee. GEO en SEO versterken elkaar. Content die helder, gestructureerd en citeerbaar is, presteert beter in zowel Google als AI-antwoorden. De meeste bedrijven combineren beide disciplines binnen dezelfde contentstrategie.",
  },
  {
    q: "Vervangt GEO uiteindelijk SEO?",
    a: "Niet op korte termijn. Google verwerkt nog steeds het overgrote deel van alle zoekopdrachten. Maar het aandeel van AI-zoekopdrachten groeit elk kwartaal. Bedrijven die nu alleen op SEO inzetten, missen een groeiend kanaal. De optimale aanpak combineert beide.",
  },
  {
    q: "Hoe meet je resultaten van GEO?",
    a: "GEO-resultaten worden gemeten door systematisch te monitoren of een merk verschijnt in AI-antwoorden. Dit omvat het testen van relevante prompts in ChatGPT, Gemini en Perplexity, en het bijhouden van citatiefrequentie en context.",
  },
  {
    q: "Welke bedrijven hebben het meeste baat bij GEO?",
    a: "Bedrijven die afhankelijk zijn van kennisgedreven vindingheid profiteren het meest. Denk aan B2B-dienstverleners, adviesbureaus, SaaS-bedrijven en specialisten in nichemarkten. Hoe specifieker de expertise, hoe groter de kans op citatie door AI.",
  },
  {
    q: "Hoe snel levert GEO resultaat op?",
    a: "De eerste AI-citaties zijn doorgaans zichtbaar na drie tot zes maanden. Structurele zichtbaarheid als vaste bron binnen een branche kost zes tot twaalf maanden. GEO is vergelijkbaar met SEO qua doorlooptijd, maar de concurrentie is nu nog aanzienlijk lager.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map(({ q, a }) => ({
    "@type": "Question",
    name: q,
    acceptedAnswer: { "@type": "Answer", text: a },
  })),
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: "GEO vs. SEO: wat is het verschil en wat heb je nodig?",
  description: "Een feitelijke vergelijking van Generative Engine Optimization (GEO) en Search Engine Optimization (SEO). Wanneer kies je welke strategie, en hoe versterken ze elkaar?",
  url: canonicalUrl,
  author: {
    "@type": "Organization",
    "@id": `${siteOrigin}/#organization`,
    name: "LUMINX",
    url: siteOrigin,
  },
};

const stats = [
  { value: "85%+", label: "Van alle zoekopdrachten gaat nog via Google" },
  { value: "Elk kwartaal", label: "Groeit het aandeel AI-zoekopdrachten" },
  { value: "33%", label: "Van AI-citaties komt uit vergelijkingscontent" },
];

const contenders = [
  {
    tone: "pink",
    icon: "search",
    short: "SEO",
    title: "Search Engine Optimization",
    body: "SEO is het optimaliseren van websites en content om hoger te ranken in zoekmachines, met name Google. Het omvat technische optimalisatie, contentcreatie en linkbuilding. Het doel is organisch verkeer genereren door zichtbaar te zijn wanneer mensen zoeken.",
    points: [
      "Optimaliseert voor Google, Bing en andere zoekmachines",
      "Resultaat is een klikpositie in de zoekresultaten",
      "Meetbaar via rankings, organisch verkeer en conversies",
      "Bestaat al 25+ jaar als discipline",
    ],
  },
  {
    tone: "yellow",
    icon: "sparkles",
    short: "GEO",
    title: "Generative Engine Optimization",
    body: "GEO is het optimaliseren van content, autoriteit en structuur zodat AI-tools een merk opnemen als bron in hun antwoorden. Waar SEO draait om klikposities, draait GEO om geciteerd worden. AI selecteert bronnen op basis van helderheid, feitelijkheid en autoriteit.",
    points: [
      "Optimaliseert voor ChatGPT, Gemini, Perplexity en andere AI-tools",
      "Resultaat is een citatie of vermelding in een AI-antwoord",
      "Meetbaar via AI-monitoring en citatiefrequentie",
      "Nieuwe discipline, weinig concurrentie",
    ],
  },
] as const;

const rows = [
  ["Doel", "Hoger ranken in zoekresultaten", "Geciteerd worden in AI-antwoorden"],
  ["Platform", "Google, Bing, Yahoo", "ChatGPT, Gemini, Perplexity"],
  ["Contentfocus", "Keyword-geoptimaliseerde pagina's", "Citeerbare, feitelijke expertise"],
  ["Technisch", "Core Web Vitals, crawlbaarheid, indexatie", "Structured data, entiteitsherkenning, schema"],
  ["Linkbuilding", "Backlinks als rankingsignaal", "Vermeldingen als autoriteitssignaal"],
  ["Meting", "Rankings, CTR, organisch verkeer", "Citatiefrequentie, AI-zichtbaarheid"],
  ["Concurrentie", "Hoog in de meeste branches", "Laag, de meeste bedrijven zijn nog niet bezig"],
  ["Doorlooptijd", "3 tot 12 maanden voor structurele posities", "3 tot 6 maanden voor eerste citaties"],
];

const when = [
  {
    title: "SEO en GEO zijn geen concurrenten",
    paras: [
      "De meest voorkomende misvatting is dat GEO een vervanging is voor SEO. Dat is niet het geval. SEO en GEO delen dezelfde fundering: kwalitatieve content, technische structuur en autoriteit. Het verschil zit in het eindpunt. SEO leidt naar een klikpositie in Google. GEO leidt naar een citatie in een AI-antwoord. Beide kanalen vragen om content die helder, feitelijk en goed gestructureerd is.",
      "In de praktijk betekent dit dat een investering in het ene kanaal ook het andere versterkt. Content die geoptimaliseerd is voor AI-citatie presteert doorgaans beter in Google, en andersom. Bedrijven die beide disciplines combineren, bouwen een bredere en veerkrachtigere online zichtbaarheid op dan bedrijven die uitsluitend op Google focussen.",
    ],
  },
  {
    title: "Wanneer is GEO belangrijker dan SEO?",
    paras: [
      "Voor bedrijven in kennisintensieve branches is GEO bijzonder relevant. AI-tools worden het vaakst geraadpleegd voor adviesvragen, vergelijkingen en specialistische informatie. Een advocatenkantoor, technologiebedrijf of gespecialiseerd bureau heeft meer baat bij AI-citaties dan een lokale bakker.",
      "De vuistregel: hoe complexer de vraag die een potentiele klant stelt, hoe groter de kans dat die vraag aan AI wordt gesteld in plaats van aan Google. Bedrijven die antwoord geven op complexe vragen, zijn de bedrijven die het meest profiteren van GEO.",
    ],
  },
  {
    title: "Wanneer is SEO onmisbaar?",
    paras: [
      "SEO blijft essentieel voor transactionele zoekopdrachten. Wanneer iemand zoekt naar \"schoenen kopen\" of \"loodgieter Amsterdam\", is Google nog steeds het primaire kanaal. E-commerce, lokale dienstverlening en direct-response marketing zijn branches waar SEO het zwaarst weegt.",
      "Daarnaast is een sterke SEO-basis een voorwaarde voor effectieve GEO. AI-systemen gebruiken dezelfde signalen als Google om betrouwbaarheid te beoordelen: domeinautoriteit, backlinks, technische gezondheid en contentstructuur. Zonder solide SEO-fundament is de kans op AI-citatie kleiner.",
    ],
  },
];

const verdict = {
  title: "De optimale strategie combineert beide",
  paras: [
    "Bedrijven die het meeste rendement halen uit hun online zichtbaarheid, zetten in op zowel SEO als GEO. De contentstrategie is gericht op feitelijkheid en citeerbare helderheid. De technische basis voldoet aan de eisen van zoekmachines en AI-systemen. Autoriteit wordt opgebouwd via publicaties die zowel als backlink als als vermeldingssignaal functioneren.",
    "Het resultaat is zichtbaarheid op twee fronten: in Google voor directe zoekopdrachten, en in AI-antwoorden voor advies- en kennisgerichte vragen. Dat is geen dubbelwerk. Het is dezelfde investering met twee rendementkanalen.",
  ],
};

const services = [
  { href: "/diensten/seo", short: "SEO", title: "Meer over SEO", desc: "Bekijk ons SEO specialisme", tone: "pink", icon: "search" },
  { href: "/diensten/geo", short: "GEO", title: "Meer over GEO", desc: "Bekijk ons GEO specialisme", tone: "yellow", icon: "sparkles" },
] as const;
---

<BaseLayout
  title="GEO vs. SEO: wat is het verschil? | LuminX"
  description="Feitelijke vergelijking van GEO en SEO. Wanneer kies je voor Generative Engine Optimization, wanneer voor Search Engine Optimization, en hoe combineer je beide?"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)}></script>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
  <Nav basePath="/" />

  <main class="vgl">

    <!-- Hero: stacked plum panel -->
    <section class="vgl__hero" aria-labelledby="vgl-title">
      <div class="pm-stack">
        <span class="pm-stack__layer" aria-hidden="true"></span>
        <span class="pm-stack__layer" aria-hidden="true"></span>
        <span class="pm-stack__layer" aria-hidden="true"></span>
        <div class="pm-stack__panel vgl__panel">
          <div class="vgl__hero-content">
            <span class="pm-tag" data-reveal>Vergelijking</span>
            <h1 id="vgl-title" class="pm-h1 vgl__title" data-reveal style="--d: 1">
              GEO <span class="vgl__vs">vs.</span> SEO
            </h1>
            <p class="pm-opening" data-reveal style="--d: 2">Twee disciplines, twee kanalen, dezelfde fundering. Dit is een feitelijke vergelijking van Generative Engine Optimization en Search Engine Optimization: wat ze zijn, waar ze verschillen en hoe ze elkaar versterken.</p>
            <div class="vgl__actions" data-reveal style="--d: 3">
              <a href="#vergelijking" class="pm-btn pm-btn--yellow">Bekijk de vergelijking <Icon name="arrow" /></a>
              <a href="#" class="pm-btn pm-btn--white" data-overlay-open>Plan kennismaking</a>
            </div>
          </div>
        </div>
      </div>

      <!-- Head-to-head cards overlapping the panel -->
      <div class="pm-container vgl__duel-wrap">
        <div class="vgl__duel">
          {contenders.map((c, i) => (
            <article class:list={["pm-card", "pm-card--lift", "vgl__side", `vgl__side--${c.tone}`]} data-reveal style={`--d: ${i}`}>
              <header class="vgl__side-top">
                <span class:list={["pm-icon", c.tone === "yellow" ? "pm-icon--milk" : "pm-icon--wine"]}><Icon name={c.icon} /></span>
                <div>
                  <span class="vgl__side-short">{c.short}</span>
                  <h2 class="pm-h3">{c.title}</h2>
                </div>
              </header>
              <div class="vgl__side-body">
                <p class="pm-text">{c.body}</p>
                <ul class="pm-checks">
                  {c.points.map((p) => <li>{p}</li>)}
                </ul>
              </div>
            </article>
          ))}
          <span class="vgl__badge" aria-hidden="true">vs</span>
        </div>
      </div>
    </section>

    <!-- Intro + stats -->
    <section class="pm-section vgl__intro" aria-labelledby="vgl-intro-title">
      <div class="pm-container pm-split vgl__intro-grid">
        <div class="vgl__intro-text" data-reveal>
          <span class="pm-label">Waarom nu</span>
          <h2 id="vgl-intro-title" class="pm-h2">Waarom deze vergelijking relevant is</h2>
          <p class="pm-text">Het zoeklandschap verandert structureel. Google is nog steeds dominant, maar een groeiend deel van de zoekopdrachten wordt beantwoord door AI-tools als ChatGPT, Gemini en Perplexity. Dat heeft directe gevolgen voor online vindbaarheid.</p>
          <p class="pm-text">SEO en GEO worden vaak als losse strategieen gepresenteerd. In de praktijk overlappen ze voor een groot deel. Toch zijn er fundamentele verschillen in doel, aanpak en meetbaarheid. Deze pagina legt beide naast elkaar.</p>
        </div>
        <ul class="vgl__stats">
          {stats.map((s, i) => (
            <li class="pm-card pm-card--milk vgl__stat" data-reveal style={`--d: ${i + 1}`}>
              <div class="pm-stat">
                <span class="pm-stat__value">{s.value}</span>
                <span class="pm-stat__label">{s.label}</span>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Comparison table -->
    <section class="pm-band pm-band--paper pm-section vgl__compare" id="vergelijking" aria-labelledby="vgl-compare-title">
      <div class="pm-container">
        <header class="pm-head">
          <span class="pm-label" data-reveal>Vergelijking</span>
          <h2 id="vgl-compare-title" class="pm-h2" data-reveal style="--d: 1">SEO en GEO naast elkaar</h2>
        </header>
        <div class="vgl__table-wrap" data-reveal style="--d: 2">
          <table class="vgl__table">
            <thead>
              <tr>
                <th scope="col">Aspect</th>
                <th scope="col"><span class="vgl__dot vgl__dot--pink" aria-hidden="true"></span>SEO</th>
                <th scope="col"><span class="vgl__dot vgl__dot--yellow" aria-hidden="true"></span>GEO</th>
              </tr>
            </thead>
            <tbody>
              {rows.map(([aspect, a, b]) => (
                <tr>
                  <th scope="row">{aspect}</th>
                  <td data-label="SEO">{a}</td>
                  <td data-label="GEO">{b}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- When to choose what + verdict -->
    <section class="pm-section vgl__when" aria-labelledby="vgl-when-title">
      <div class="pm-container">
        <header class="pm-head">
          <span class="pm-label" data-reveal>Wanneer kies je wat</span>
          <h2 id="vgl-when-title" class="pm-h2" data-reveal style="--d: 1">Google, AI of allebei?</h2>
        </header>
        <div class="pm-split vgl__when-grid">
          <ul class="pm-accordion" data-reveal>
            {when.map((w, i) => (
              <li>
                <details class="pm-acc" name="vgl-when" open={i === 0}>
                  <summary><h3 class="vgl__acc-title">{w.title}</h3></summary>
                  <div class="pm-acc__body">{w.paras.map((p) => <p>{p}</p>)}</div>
                </details>
              </li>
            ))}
          </ul>
          <article class="pm-card pm-card--plum pm-card--lift pm-card--pad vgl__verdict" data-reveal style="--d: 1">
            <span class="pm-tag pm-tag--yellow"><Icon name="check" size={16} /> Ons oordeel</span>
            <h3 class="pm-h2 vgl__verdict-title">{verdict.title}</h3>
            {verdict.paras.map((p) => <p class="vgl__verdict-text">{p}</p>)}
            <a href="#" class="pm-btn pm-btn--yellow" data-overlay-open>Plan kennismaking <Icon name="arrow" /></a>
          </article>
        </div>
      </div>
    </section>


    <!-- FAQ -->
    <section class="pm-section vgl__faq" aria-labelledby="vgl-faq-title">
      <div class="pm-container pm-split vgl__faq-grid">
        <header class="pm-head pm-head--left vgl__faq-head" data-reveal>
          <span class="pm-label">Veelgestelde vragen</span>
          <h2 id="vgl-faq-title" class="pm-h2">GEO vs. SEO: veelgestelde vragen</h2>
          <p class="pm-text">Staat jouw vraag er niet bij? Neem contact op voor een vrijblijvend gesprek.</p>
          <a href="#contact" class="pm-link" data-overlay-open>Stel je vraag <Icon name="arrow" size={18} /></a>
        </header>
        <ul class="pm-accordion" data-reveal style="--d: 1">
          {faq.map((item) => (
            <li>
              <details class="pm-acc" name="vgl-faq">
                <summary>{item.q}</summary>
                <div class="pm-acc__body"><p>{item.a}</p></div>
              </details>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Service links -->
    <section class="pm-section--tight vgl__more" aria-label="Meer over onze specialismen">
      <div class="pm-container pm-split" data-reveal>
        {services.map((s) => (
          <a href={s.href} class:list={["pm-card", "pm-card--lift", "vgl__more-card", `vgl__more-card--${s.tone}`]}>
            <span class:list={["pm-icon", s.tone === "yellow" ? "pm-icon--milk" : "pm-icon--wine"]}><Icon name={s.icon} /></span>
            <span class="vgl__more-text">
              <span class="pm-label">{s.short}</span>
              <h3 class="pm-h3">{s.title}</h3>
              <span class="pm-text">{s.desc}</span>
            </span>
            <span class="vgl__arrow" aria-hidden="true"><Icon name="arrow" size={18} stroke={2.4} /></span>
          </a>
        ))}
      </div>
    </section>

    <!-- Closing CTA -->
    <section class="pm-band vgl__cta" id="contact" aria-labelledby="vgl-cta-title">
      <div class="pm-container vgl__cta-inner">
        <h2 id="vgl-cta-title" class="pm-h2 pm-outline vgl__cta-title" data-reveal>SEO, GEO of beide?<br />We denken mee.</h2>
        <p class="pm-opening vgl__cta-text" data-reveal style="--d: 1">Vertel ons je situatie en we adviseren welke strategie het meeste rendement oplevert voor jouw bedrijf.</p>
        <div class="vgl__cta-actions" data-reveal style="--d: 2">
          <a href="#" class="pm-btn pm-btn--yellow" data-overlay-open>Plan kennismaking <Icon name="arrow" /></a>
        </div>
      </div>
    </section>

    <Footer />
    <ContactOverlay />
  </main>
</BaseLayout>

<style>
  /* ── Hero ─────────────────────────────────────────── */
  .vgl__hero { position: relative; padding-top: 72px; }
  .vgl__panel { padding: clamp(4.5rem, 8vw, 6.5rem) var(--pm-gutter) clamp(12rem, 20vw, 15rem); }
  .vgl__hero-content {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 1.5rem;
    max-width: 880px;
    margin-inline: auto;
  }
  .vgl__title { color: var(--pm-milk); }
  .vgl__vs { color: var(--pm-yellow); }
  .vgl__actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 1rem; margin-top: 0.5rem; }

  /* ── Head-to-head ─────────────────────────────────── */
  .vgl__duel-wrap { position: relative; z-index: 2; margin-top: clamp(-10rem, -16vw, -8rem); }
  .vgl__duel {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 2.5vw, 2rem);
    max-width: 1180px;
    margin-inline: auto;
  }
  .vgl__side { display: flex; flex-direction: column; background: var(--pm-milk); }
  .vgl__side-top {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border-bottom: var(--pm-border);
  }
  .vgl__side--pink .vgl__side-top { background: var(--pm-pink); }
  .vgl__side--yellow .vgl__side-top { background: var(--pm-yellow); }
  .vgl__side-short {
    display: block;
    font-family: var(--pm-display);
    font-size: clamp(2rem, 3.4vw, 2.75rem);
    line-height: 1;
  }
  .vgl__side-top .pm-h3 { font-family: var(--pm-body); font-size: 1rem; font-weight: 700; margin-top: 0.3rem; }
  .vgl__side-body { display: grid; gap: 1.5rem; padding: clamp(1.5rem, 3vw, 2.25rem); }
  .vgl__badge {
    position: absolute;
    left: 50%;
    top: clamp(2.5rem, 4vw, 3.25rem);
    translate: -50% 0;
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border: var(--pm-border);
    border-radius: 50%;
    background: var(--pm-red);
    color: var(--pm-milk);
    box-shadow: 0 4px 0 var(--pm-ink);
    font-family: var(--pm-display);
    font-size: 1.6rem;
    line-height: 1;
    z-index: 3;
  }

  /* ── Intro ────────────────────────────────────────── */
  .vgl__intro-grid { align-items: center; gap: clamp(2rem, 5vw, 5rem); }
  .vgl__intro-text { display: grid; gap: 1rem; }
  .vgl__intro-text .pm-text + .pm-text { margin-top: 0; }
  .vgl__stats { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; }
  .vgl__stat { padding: 1.5rem 1.75rem; box-shadow: var(--pm-drop); }
  .vgl__stat:nth-child(2) { background: var(--pm-yellow); }
  .vgl__stat:nth-child(2) .pm-stat__label { color: var(--pm-ink); }

  /* ── Table ────────────────────────────────────────── */
  .vgl__table-wrap { max-width: 1080px; margin-inline: auto; }
  .vgl__table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    border: var(--pm-border);
    border-radius: var(--pm-r);
    overflow: hidden;
    background: var(--pm-milk);
    box-shadow: var(--pm-drop-lg);
    font-size: 1rem;
  }
  .vgl__table th, .vgl__table td {
    padding: 1rem 1.25rem;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--pm-ink-line);
  }
  .vgl__table tbody tr:last-child > * { border-bottom: 0; }
  .vgl__table thead th {
    background: var(--pm-paper);
    border-bottom: var(--pm-border);
    font-family: var(--pm-display);
    font-weight: 400;
    font-size: 1.5rem;
    line-height: 1.1;
  }
  .vgl__table thead th:first-child {
    font-family: var(--pm-body);
    font-size: var(--pm-fs-label);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    vertical-align: middle;
  }
  .vgl__table tbody th { width: 22%; font-weight: 800; color: var(--pm-ink); }
  .vgl__table td { color: var(--pm-ink-soft); }
  .vgl__dot {
    display: inline-block;
    width: 14px;
    height: 14px;
    margin-right: 0.55rem;
    border: var(--pm-border);
    border-radius: 50%;
    vertical-align: 0.05em;
  }
  .vgl__dot--pink { background: var(--pm-pink); }
  .vgl__dot--yellow { background: var(--pm-yellow); }

  /* ── When + verdict ───────────────────────────────── */
  .vgl__when-grid { align-items: stretch; }
  .vgl__acc-title { font: inherit; margin: 0; }
  .vgl__verdict { display: grid; align-content: start; justify-items: start; gap: 1.1rem; }
  .vgl__verdict-title { color: var(--pm-milk); }
  .vgl__verdict-text { margin: 0; color: rgba(255, 250, 240, 0.85); }

  /* ── FAQ ──────────────────────────────────────────── */
  .vgl__faq-grid { gap: clamp(2rem, 5vw, 4rem); }
  .vgl__faq-head { margin-bottom: 0; position: sticky; top: 120px; }

  /* ── More cards ───────────────────────────────────── */
