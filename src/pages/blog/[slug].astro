---
import { getCollection, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import ContactOverlay from '../../components/ContactOverlay.astro';
import Icon from '../../components/pm/Icon.astro';
import rayAvatar from '../../assets/images/ray_avatar.png';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

type Props = { post: CollectionEntry<'blog'> };
const { post } = Astro.props;
const { Content, headings } = await post.render();

const formatDate = (date: Date) =>
  date.toLocaleDateString('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' });

const wordCount = post.body.trim().split(/\s+/).length;
const readingTime = Math.max(1, Math.round(wordCount / 220));
const toc = headings.filter((h) => h.depth === 2);

const morePosts = (await getCollection('blog'))
  .filter((p) => p.slug !== post.slug)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);

const siteOrigin = (Astro.site?.toString() ?? 'https://luminx.nl').replace(/\/$/, '');
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin).toString();

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: post.data.pubDate.toISOString(),
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl },
  author: { '@type': 'Person', '@id': `${siteOrigin}/#ray`, name: 'Ray Huffenreuter' },
  publisher: {
    '@type': 'Organization',
    '@id': `${siteOrigin}/#organization`,
    name: 'LuminX',
  },
  url: canonicalUrl,
  ...(post.data.image ? { image: new URL(post.data.image, siteOrigin).toString() } : {}),
  ...(post.data.category ? { keywords: post.data.category } : {}),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteOrigin },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: `${siteOrigin}/blog` },
    { '@type': 'ListItem', position: 3, name: post.data.title, item: canonicalUrl },
  ],
};
---

<BaseLayout
  title={`${post.data.title} | LuminX Blog`}
  description={post.data.description}
  ogImage={post.data.image ?? '/images/luminx-founder.png'}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)}></script>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
  <Nav basePath="/" />

  <main class="post">
    <section class="post__hero" aria-labelledby="post-title">
      <div class="pm-stack pm-stack--light">
        <span class="pm-stack__layer" aria-hidden="true"></span>
        <span class="pm-stack__layer" aria-hidden="true"></span>
        <span class="pm-stack__layer" aria-hidden="true"></span>

        <div class="pm-stack__panel post__panel">
          <div class="post__hero-content">
            <nav class="post__crumbs" aria-label="Kruimelpad" data-reveal>
              <a href="/">Home</a>
              <span aria-hidden="true">/</span>
              <a href="/blog">Blog</a>
            </nav>
            {post.data.category && (
              <span class="pm-tag pm-tag--yellow" data-reveal style="--d: 1">{post.data.category}</span>
            )}
            <h1 id="post-title" class="pm-h1 post__title" data-reveal style="--d: 2">{post.data.title}</h1>
            <ul class="post__meta" data-reveal style="--d: 3">
              <li><Icon name="calendar" size={16} /> <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time></li>
              <li><Icon name="clock" size={16} /> {readingTime} min leestijd</li>
              <li><Icon name="users" size={16} /> {post.data.author}</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    {post.data.image && (
      <div class="pm-container pm-container--narrow post__cover-wrap">
        <figure class="pm-card pm-card--lift pm-media post__cover" data-reveal>
          <img src={post.data.image} alt={post.data.title} loading="eager" decoding="async" />
        </figure>
      </div>
    )}

    <article class="pm-section post__article">
      <div class="pm-container pm-container--narrow">
        {toc.length > 2 && (
          <details class="pm-acc post__toc">
            <summary>In dit artikel</summary>
            <div class="pm-acc__body">
              <ol>
                {toc.map((h) => (
                  <li><a href={`#${h.slug}`}>{h.text}</a></li>
                ))}
              </ol>
            </div>
          </details>
        )}

        <div class="pm-prose post__prose">
          <Content />
        </div>

        <aside class="pm-card pm-card--milk post__author" aria-label="Over de auteur">
          <Image src={rayAvatar} alt="Ray Huffenreuter" width={128} height={128} class="post__author-img" />
          <div>
            <span class="pm-label">Geschreven door</span>
            <p class="post__author-name">{post.data.author}</p>
            <p class="pm-text post__author-role">Oprichter &amp; Digital Strategist bij LuminX</p>
          </div>
        </aside>
      </div>
    </article>

    {post.data.relatedLinks && post.data.relatedLinks.length > 0 && (
      <section class="pm-band pm-band--paper post__related" aria-labelledby="related-title">
        <div class="pm-container pm-container--narrow">
          <span id="related-title" class="pm-label">Gerelateerde diensten</span>
          <div class="post__related-grid">
            {post.data.relatedLinks.map((link, i) => (
              <a href={link.href} class="pm-card pm-card--milk post__related-card" data-reveal style={`--d: ${i}`}>
                <strong class="pm-h3">{link.label}</strong>
                {link.description && <span class="pm-text">{link.description}</span>}
                <span class="pm-link">Bekijk dienst <Icon name="arrow" size={18} /></span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    {morePosts.length > 0 && (
      <section class="pm-section pm-section--tight post__more" aria-labelledby="more-title">
        <div class="pm-container">
          <header class="pm-head">
            <span class="pm-label">Verder lezen</span>
            <h2 id="more-title" class="pm-h2">Meer uit de blog</h2>
          </header>
          <ul class="post__more-grid">
            {morePosts.map((p, i) => (
              <li data-reveal style={`--d: ${i}`}>
                <a href={`/blog/${p.slug}`} class="pm-card post__more-card">
                  {p.data.image && (
                    <div class="pm-media post__more-media">
                      <img src={p.data.image} alt={p.data.title} loading="lazy" decoding="async" />
                    </div>
                  )}
                  <div class="post__more-body">
                    {p.data.category && <span class="pm-tag pm-tag--paper post__more-cat">{p.data.category}</span>}
                    <h3 class="pm-h3">{p.data.title}</h3>
                    <span class="pm-link">Lees artikel <Icon name="arrow" size={18} /></span>
                  </div>
                </a>
              </li>
            ))}
          </ul>
          <div class="post__more-all">
            <a href="/blog" class="pm-btn pm-btn--white">Alle artikelen</a>
          </div>
        </div>
      </section>
    )}

    <section class="pm-band post__cta" aria-labelledby="post-cta-title">
      <div class="pm-container post__cta-inner">
        <h2 id="post-cta-title" class="pm-h2 pm-outline" data-reveal>Hulp nodig met online marketing?</h2>
        <p class="pm-opening" data-reveal style="--d: 1">Plan een vrijblijvend gesprek en ontdek wat LuminX voor jouw bedrijf kan betekenen.</p>
        <a href="#" class="pm-btn pm-btn--yellow" data-overlay-open data-reveal style="--d: 2">Plan een gesprek <Icon name="arrow" /></a>
      </div>
    </section>

    <Footer />
    <ContactOverlay />
  </main>
</BaseLayout>

<style>
  .post { background: var(--pm-cream); }

  /* ─── Hero ─── */
  .post__hero { padding-top: 72px; }

  .post__panel {
    padding: clamp(3rem, 6vw, 4.5rem) var(--pm-gutter) clamp(7rem, 12vw, 9rem);
  }

  .post__hero-content {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 1.25rem;
    max-width: 900px;
    margin-inline: auto;
  }

  .post__title {
    color: var(--pm-milk);
    font-size: clamp(2.4rem, 5.2vw, 4.5rem);
    line-height: 1.02;
  }

  .post__crumbs {
    display: flex;
    gap: 0.5rem;
    color: var(--pm-pink);
    font-size: var(--pm-fs-label);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .post__crumbs a { color: inherit; text-decoration: none; }
  @media (hover: hover) { .post__crumbs a:hover { color: var(--pm-milk); } }

  .post__meta {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
  }
  .post__meta li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.9rem;
    border: 2px solid rgba(255, 250, 240, 0.35);
    border-radius: var(--pm-pill);
    color: rgba(255, 250, 240, 0.9);
    font-size: 0.875rem;
    font-weight: 600;
  }

  /* ─── Cover ─── */
  .post__cover-wrap {
    position: relative;
    z-index: 2;
    margin-top: clamp(-6rem, -10vw, -4.5rem);
  }
  .post__cover {
    margin: 0;
    aspect-ratio: 16 / 9;
  }

  /* ─── Article ─── */
  .post__article { padding-top: clamp(3rem, 6vw, 4.5rem); }

  .post__toc { margin-bottom: clamp(2rem, 4vw, 3rem); }
  .post__toc ol {
    margin: 0;
    padding-left: 1.25em;
    display: grid;
    gap: 0.45rem;
  }
  .post__toc a {
    color: var(--pm-ink);
    font-weight: 600;
    text-decoration: none;
  }
  @media (hover: hover) { .post__toc a:hover { color: var(--pm-wine); text-decoration: underline; } }

  /* markdown elements pm-prose doesn't cover */
  .post__prose :global(h2),
  .post__prose :global(h3) { scroll-margin-top: 110px; }
  .post__prose :global(> :first-child) { margin-top: 0; }
  .post__prose :global(p) { margin-block: 0; }
  .post__prose :global(> * + p) { margin-top: 1.1em; }
  .post__prose :global(h2 + *),
  .post__prose :global(h3 + *) { margin-top: 0.6em; }
  .post__prose :global(ul),
  .post__prose :global(ol) { margin-bottom: 0; }
  .post__prose :global(li::marker) { color: var(--pm-red); font-weight: 700; }
  .post__prose :global(hr) {
    border: 0;
    height: 2px;
    margin-block: 2.5em;
    background: repeating-linear-gradient(90deg, var(--pm-ink-mute) 0 3px, transparent 3px 9px);
  }
  .post__prose :global(blockquote) {
    font-family: var(--pm-display);
    font-size: clamp(1.3rem, 2vw, 1.6rem);
    line-height: 1.3;
    box-shadow: var(--pm-drop);
  }
  .post__prose :global(blockquote p) { margin: 0; }
  .post__prose :global(blockquote em) { font-style: normal; }
  .post__prose :global(table) {
    display: block;
    max-width: 100%;
    overflow-x: auto;
    background: var(--pm-milk);
    -webkit-overflow-scrolling: touch;
  }
  .post__prose :global(th) {
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border-bottom: var(--pm-border);
  }
  .post__prose :global(td) { vertical-align: top; color: var(--pm-ink-soft); }
  .post__prose :global(tbody tr:last-child td) { border-bottom: 0; }
  .post__prose :global(tbody tr:nth-child(even)) { background: rgba(247, 239, 223, 0.6); }

  /* inline CTA button used inside markdown (class="cta-button") */
  .post__prose :global(a.cta-button) {
    display: inline-flex;
    align-items: center;
    min-height: 56px;
    padding: 0 1.75rem;
    border: var(--pm-border);
    border-radius: var(--pm-pill);
    background: var(--pm-yellow);
    color: var(--pm-ink);
    box-shadow: var(--pm-drop);
    font-size: 0.875rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    transition: transform 0.4s var(--pm-ease), box-shadow 0.4s var(--pm-ease);
  }
  @media (hover: hover) {
    .post__prose :global(a.cta-button:hover) { transform: translateY(-3px); box-shadow: 0 9px 0 var(--pm-ink); }
  }

  /* ─── Author ─── */
  .post__author {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-top: clamp(3rem, 6vw, 4.5rem);
    padding: 1.25rem 1.5rem;
  }
  .post__author :global(.post__author-img) {
    width: 72px;
    height: 72px;
    flex: none;
    border: var(--pm-border);
    border-radius: 50%;
    object-fit: cover;
    background: var(--pm-pink);
  }
  .post__author-name {
    margin: 0.15rem 0 0;
    font-family: var(--pm-display);
    font-size: 1.5rem;
    line-height: 1.1;
  }
  .post__author-role { font-size: 0.95rem; }

  /* ─── Related services ─── */
  .post__related { padding-block: clamp(3rem, 6vw, 4.5rem); }
  .post__related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
    margin-top: 1.25rem;
  }
  .post__related-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.5rem;
  }
  .post__related-card .pm-text { font-size: 0.95rem; flex: 1; }
  .post__related-card .pm-link { margin-top: 0.5rem; }

  /* ─── More posts ─── */
  .post__more-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 1.5rem);
    max-width: 1040px;
    margin-inline: auto;
  }
  .post__more-card {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    height: 100%;
  }
  .post__more-media { border-right: var(--pm-border); min-height: 200px; }
  .post__more-body {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.5rem;
  }
  .post__more-body .pm-h3 { font-size: clamp(1.25rem, 1.7vw, 1.5rem); }
  .post__more-body .pm-link { margin-top: auto; }
  .post__more-cat { align-self: flex-start; background: var(--pm-milk); }
  .post__more-all { display: flex; justify-content: center; margin-top: clamp(2rem, 4vw, 3rem); }

  /* ─── CTA ─── */
  .post__cta { padding-block: clamp(4.5rem, 9vw, 7rem); }
  .post__cta-inner {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 1.25rem;
  }
  .post__cta-inner .pm-opening { color: var(--pm-ink); }
  .post__cta-inner .pm-btn { margin-top: 0.5rem; }

  @media (max-width: 860px) {
    .post__more-grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 560px) {
    .post__more-card { grid-template-columns: 1fr; }
    .post__more-media { border-right: 0; border-bottom: var(--pm-border); aspect-ratio: 16 / 9; min-height: 0; }
    .post__author { align-items: flex-start; }
    .post__author :global(.post__author-img) { width: 56px; height: 56px; }
    .post__cta-inner .pm-btn { width: 100%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .post__prose :global(a.cta-button) { transition: none; }
  }
</style>
