---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import ContactOverlay from '../../components/ContactOverlay.astro';
import Icon from '../../components/pm/Icon.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const [featured, ...rest] = posts;

const formatDate = (date: Date) =>
  date.toLocaleDateString('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout
  title="Blog | LuminX | Online Marketing & Digitale Groei"
  description="Praktische inzichten over online marketing, SEO, SEA en digitale strategie voor bedrijven in Twente."
>
  <Nav basePath="/" />

  <main class="blog">
    <section class="blog__hero" aria-labelledby="blog-title">
      <div class="pm-stack">
        <span class="pm-stack__layer" aria-hidden="true"></span>
        <span class="pm-stack__layer" aria-hidden="true"></span>
        <span class="pm-stack__layer" aria-hidden="true"></span>

        <div class="pm-stack__panel blog__panel">
          <div class="blog__hero-content">
            <a href="/" class="blog__back" data-reveal>
              <Icon name="arrow" size={16} class="blog__back-icon" /> Terug naar homepage
            </a>
            <span class="pm-tag pm-tag--yellow" data-reveal style="--d: 1">Kennisbank</span>
            <h1 id="blog-title" class="pm-h1 blog__title" data-reveal style="--d: 2">Blog</h1>
            <p class="pm-opening" data-reveal style="--d: 3">
              Praktische inzichten over online marketing, SEO en digitale groei. Geschreven vanuit de praktijk.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="pm-section blog__list" aria-label="Artikelen">
      <div class="pm-container">
        {posts.length === 0 && (
          <p class="pm-opening blog__empty">Binnenkort verschijnen hier de eerste artikelen.</p>
        )}

        {featured && (
          <a href={`/blog/${featured.slug}`} class="pm-card pm-card--lift blog__featured" data-reveal>
            {featured.data.image && (
              <div class="pm-media blog__featured-media">
                <img src={featured.data.image} alt={featured.data.title} loading="eager" decoding="async" />
              </div>
            )}
            <div class="blog__featured-body">
              <div class="blog__tags">
                <span class="pm-tag pm-tag--yellow">Nieuwste artikel</span>
                {featured.data.category && <span class="pm-tag">{featured.data.category}</span>}
              </div>
              <h2 class="pm-h2 blog__featured-title">{featured.data.title}</h2>
              <p class="pm-text">{featured.data.description}</p>
              <div class="blog__card-foot">
                <time datetime={featured.data.pubDate.toISOString()}>{formatDate(featured.data.pubDate)}</time>
                <span class="pm-link">Lees artikel <Icon name="arrow" size={18} /></span>
              </div>
            </div>
          </a>
        )}

        {rest.length > 0 && (
          <ul class="blog__grid">
            {rest.map((post, i) => (
              <li data-reveal style={`--d: ${i % 3}`}>
                <a href={`/blog/${post.slug}`} class="pm-card blog__card">
                  {post.data.image && (
                    <div class="pm-media blog__card-media">
                      <img src={post.data.image} alt={post.data.title} loading="lazy" decoding="async" />
                    </div>
                  )}
                  <div class="blog__card-body">
                    {post.data.category && (
                      <span class="pm-tag pm-tag--paper blog__card-cat">{post.data.category}</span>
                    )}
                    <h2 class="pm-h3 blog__card-title">{post.data.title}</h2>
                    <p class="pm-text blog__card-desc">{post.data.description}</p>
                    <div class="blog__card-foot">
                      <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
                      <span class="pm-link">Lees artikel <Icon name="arrow" size={18} /></span>
                    </div>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>
    </section>

    <Footer />
    <ContactOverlay />
  </main>
</BaseLayout>

<style>
  .blog { background: var(--pm-cream); }

  .blog__hero { padding-top: 72px; }

  .blog__panel {
    padding: clamp(3.5rem, 7vw, 5.5rem) var(--pm-gutter) clamp(3.5rem, 7vw, 5rem);
  }

  .blog__hero-content {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 1.25rem;
    max-width: 760px;
    margin-inline: auto;
  }

  .blog__title { color: var(--pm-milk); }

  .blog__back {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--pm-pink);
    font-size: var(--pm-fs-label);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .blog__back :global(.blog__back-icon) { transform: rotate(180deg); }
  @media (hover: hover) { .blog__back:hover { color: var(--pm-milk); } }

  .blog__list { padding-top: clamp(3rem, 6vw, 5rem); }

  .blog__empty { margin-inline: auto; text-align: center; }

  /* featured: wide card, image + body side by side */
  .blog__featured {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
    background: var(--pm-milk);
  }
  .blog__featured-media {
    min-height: 320px;
    border-right: var(--pm-border);
  }
  .blog__featured-body {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    padding: clamp(1.5rem, 3.5vw, 3rem);
  }
  .blog__featured-title { font-size: clamp(2rem, 3.4vw, 3rem); }

  .blog__tags { display: flex; flex-wrap: wrap; gap: 0.5rem; }

  /* grid */
  .blog__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 1.5rem);
  }

  .blog__card {
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  .blog__card-media {
    aspect-ratio: 16 / 10;
    border-bottom: var(--pm-border);
  }
  .blog__card-media img { transition: transform 0.6s var(--pm-ease); }
  .blog__card-body {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    flex: 1;
    padding: 1.5rem;
  }
  .blog__card-cat { align-self: flex-start; background: var(--pm-milk); }
  .blog__card-desc { font-size: 0.975rem; flex: 1; }

  .blog__card-foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--pm-ink-line);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--pm-ink-mute);
  }

  @media (hover: hover) {
    .blog__card:hover .blog__card-media img,
    .blog__featured:hover .blog__featured-media img { transform: scale(1.04); }
    .blog__featured-media img { transition: transform 0.6s var(--pm-ease); }
  }

  @media (max-width: 1024px) {
    .blog__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 860px) {
    .blog__featured { grid-template-columns: 1fr; }
    .blog__featured-media {
      min-height: 0;
      aspect-ratio: 16 / 10;
      border-right: 0;
      border-bottom: var(--pm-border);
    }
  }

  @media (max-width: 640px) {
    .blog__grid { grid-template-columns: 1fr; }
  }

  @media (prefers-reduced-motion: reduce) {
    .blog__card-media img, .blog__featured-media img { transition: none; }
  }
</style>
