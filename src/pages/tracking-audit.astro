---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import ContactOverlay from "../components/ContactOverlay.astro";
import Icon from "../components/pm/Icon.astro";

const auditItems = [
  {
    icon: "layers",
    tone: "",
    title: "GTM-container controle",
    description: "We beoordelen jouw GTM-container op dubbele tags, onjuiste triggers, niet-gepubliceerde versies en verouderde pixels die de betrouwbaarheid van je data ondermijnen.",
  },
  {
    icon: "chart",
    tone: "pm-icon--pink",
    title: "GA4 event- & conversietracking",
    description: "Zijn de juiste events ingesteld? Worden formuliersubmissies, klikken en conversies correct gemeten? Of meet je alleen pageviews en sessies zonder zinvolle inzichten?",
  },
  {
    icon: "shield",
    tone: "pm-icon--yellow",
    title: "Consent Mode v2 check",
    description: "Controleren of jouw Consent Mode v2 correct is geconfigureerd: regiogebaseerde instellingen, alle vier parameters, Advanced Mode en technische koppeling met de cookiebanner.",
  },
  {
    icon: "target",
    tone: "pm-icon--wine",
    title: "Google Ads conversiekoppeling",
    description: "Is jouw Google Ads-account correct gekoppeld aan GA4 of een directe conversietag? Optimaliseert jouw biedstrategie op echte conversies of op schijndata?",
  },
  {
    icon: "copy",
    tone: "pm-icon--pink",
    title: "Dubbele tracking detectie",
    description: "Detectie van dubbele GA4-tags die sessies en conversies kunstmatig opblazen: een van de meest voorkomende en meest schadelijke trackingproblemen.",
  },
  {
    icon: "users",
    tone: "pm-icon--yellow",
    title: "Remarketingdoelgroepen",
    description: "Zijn er remarketingdoelgroepen aangemaakt op basis van gedrag? Worden ze gevuld met de juiste doelgroepen, inclusief EER-bezoekers via Consent Mode?",
  },
] as const;

const resultaten = [
  "Volledig overzicht van wat je nu mist in je trackingdata",
  "Concrete lijst van problemen gerangschikt op impact",
  "Directe aanbevelingen: wat als eerste op te lossen",
  "Inzicht of je Consent Mode v2 DMA-compliant is",
  "Advies over prioriteiten voor een correcte GTM-setup",
];

const stats = [
  { value: "67%", label: "van besluitvormers vertrouwt eigen data niet" },
  { value: "+37%", label: "meer conversies na correcte GTM-implementatie" },
  { value: "Verplicht", label: "Consent Mode v2 voor alle EER-websites met Google Ads" },
];

const steps = [
  { num: "01", title: "Aanvraag", body: "Je stuurt ons de URL van je website en geeft ons leesrechten op je GTM-container en GA4-property. Dat is alles wat we nodig hebben." },
  { num: "02", title: "Analyse", body: "We doorlichten jouw volledige trackingopzet: GTM-container, GA4-events, conversies, Consent Mode v2 en Google Ads koppeling. Binnen vijf werkdagen." },
  { num: "03", title: "Rapport & bespreking", body: "Je ontvangt een helder rapport met bevindingen gerangschikt op impact, plus concrete aanbevelingen. Optioneel bespreken we het rapport in een kort videogesprek." },
];

const related = [
  { href: "/diensten/google-tag-manager", icon: "layers", tone: "pink", title: "Google Tag Manager", body: "Complete GTM-implementatie of opschoning van bestaande container. Gestructureerd, gedocumenteerd en betrouwbaar.", link: "Meer over GTM" },
  { href: "/diensten/ga4-implementatie", icon: "chart", tone: "yellow", title: "GA4 Implementatie", body: "Correcte GA4-inrichting met events, conversies en remarketingdoelgroepen. Van lege property naar bruikbaar analytics-systeem.", link: "Meer over GA4" },
  { href: "/diensten/consent-mode-v2", icon: "shield", tone: "red", title: "Consent Mode v2", body: "DMA-compliant Consent Mode v2 implementatie die zowel juridisch waterdicht is als jouw datakwaliteit maximaliseert.", link: "Meer over Consent Mode" },
] as const;
---

<BaseLayout
  title="Gratis Tracking-audit | Ontdek wat jouw website nu mist | LuminX"
  description="Laat jouw tracking gratis doorlichten. Wij checken GTM, GA4, Consent Mode v2 en Google Ads conversiekoppeling, en laten zien wat je nu mist."
>
  <Nav basePath="/" />

  <main class="aud">

    <!-- Hero -->
    <section class="aud__hero" aria-labelledby="aud-title">
      <div class="pm-stack">
        <span class="pm-stack__layer" aria-hidden="true"></span>
        <span class="pm-stack__layer" aria-hidden="true"></span>
        <span class="pm-stack__layer" aria-hidden="true"></span>
        <div class="pm-stack__panel aud__panel">
          <div class="aud__hero-content">
            <span class="pm-tag" data-reveal>Gratis dienst</span>
            <h1 id="aud-title" class="pm-h1 aud__title" data-reveal style="--d: 1">Tracking-audit</h1>
            <p class="pm-opening" data-reveal style="--d: 2">Je website heeft tracking. Maar klopt het? Wij doorlichten jouw GTM-container, GA4-implementatie en Consent Mode v2, gratis, zonder verplichtingen, met een concreet rapport.</p>
            <div class="aud__actions" data-reveal style="--d: 3">
              <a href="#contact" class="pm-btn pm-btn--yellow" data-overlay-open>Start gratis audit <Icon name="arrow" /></a>
              <a href="#wat-checken" class="pm-btn pm-btn--white">Wat checken we?</a>
            </div>
            <ul class="aud__badges" data-reveal style="--d: 4">
              <li><Icon name="check" size={16} stroke={2.6} /> Gratis &amp; vrijblijvend</li>
              <li><Icon name="check" size={16} stroke={2.6} /> Rapport binnen 5 werkdagen</li>
              <li><Icon name="check" size={16} stroke={2.6} /> Concreet &amp; actionable</li>
            </ul>
          </div>
        </div>
      </div>

      <div class="pm-container aud__float-wrap">
        <aside class="pm-card pm-card--lift aud__float" aria-labelledby="aud-receive" data-reveal>
          <div class="aud__float-head">
            <span class="pm-icon pm-icon--yellow" aria-hidden="true"><Icon name="clipboard" /></span>
            <h2 id="aud-receive" class="pm-h3">Wat je ontvangt</h2>
          </div>
          <ul class="pm-checks aud__receive">
            {resultaten.map((r) => <li>{r}</li>)}
          </ul>
        </aside>
      </div>
    </section>

    <!-- Why -->
    <section class="pm-section aud__why" aria-labelledby="aud-why-title">
      <div class="pm-container pm-split aud__why-grid">
        <div class="aud__why-text" data-reveal>
          <span class="pm-label">Waarom een audit?</span>
          <h2 id="aud-why-title" class="pm-h2">De meeste websites meten, maar meten niet wat er toe doet</h2>
          <p class="pm-text">GA4 geïnstalleerd, GTM aanwezig, een cookiebanner op de site. Alles lijkt in orde. Maar bij een audit zien we keer op keer hetzelfde: conversies worden niet gemeten, tags vuren dubbel, Consent Mode is incorrect geconfigureerd, of de container staat niet gepubliceerd.</p>
          <p class="pm-text">Het gevolg: marketingbeslissingen gebaseerd op data die niet klopt. Budget dat naar de verkeerde kanalen gaat. Remarketing die niet werkt voor EER-bezoekers.</p>
          <p class="aud__punch">Een tracking-audit legt bloot wat er ontbreekt, zodat je kunt bijsturen voor het te laat is.</p>
        </div>
        <ul class="aud__stats">
          {stats.map((s, i) => (
            <li class:list={["pm-card", "aud__stat", `aud__stat--${i}`]} data-reveal style={`--d: ${i + 1}`}>
              <div class="pm-stat">
                <span class="pm-stat__value">{s.value}</span>
                <span class="pm-stat__label">{s.label}</span>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- What we check -->
    <section class="pm-band pm-band--paper pm-section aud__checks" id="wat-checken" aria-labelledby="aud-checks-title">
      <div class="pm-container">
        <header class="pm-head">
          <span class="pm-label" data-reveal>Wat wij checken</span>
          <h2 id="aud-checks-title" class="pm-h2" data-reveal style="--d: 1">Een volledig beeld van jouw trackingsituatie</h2>
          <p class="pm-opening" data-reveal style="--d: 2">We beoordelen alle lagen van je tracking, van GTM-container tot Google Ads koppeling, en geven je een duidelijk beeld van wat werkt, wat ontbreekt en wat prioriteit heeft.</p>
        </header>
        <ul class="aud__grid">
          {auditItems.map((item, i) => (
            <li class="pm-card pm-card--milk pm-card--pad aud__card" data-reveal style={`--d: ${i % 3}`}>
              <span class:list={["pm-icon", item.tone]}><Icon name={item.icon} /></span>
              <h3 class="pm-h3">{item.title}</h3>
              <p class="pm-text">{item.description}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Process -->
    <section class="pm-section aud__process" aria-labelledby="aud-process-title">
      <div class="pm-container">
        <div class="pm-card pm-card--plum pm-card--lift aud__process-card" data-reveal>
          <header class="pm-head aud__process-head">
            <span class="pm-label aud__on-dark">Hoe het werkt</span>
            <h2 id="aud-process-title" class="pm-h2">Van aanvraag naar rapport in drie stappen.</h2>
          </header>
          <ol class="aud__steps">
            {steps.map((s, i) => (
              <li class="aud__step" data-reveal style={`--d: ${i + 1}`}>
                <span class="aud__step-num">{s.num}</span>
                <h3 class="pm-h3">{s.title}</h3>
                <p>{s.body}</p>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <!-- Mid CTA -->
    <section class="pm-band pm-band--plum aud__band" aria-labelledby="aud-band-title">
      <div class="pm-container aud__band-inner">
        <div data-reveal>
          <h2 id="aud-band-title" class="pm-h2 aud__band-title">Klaar om te ontdekken wat jouw tracking nu mist?</h2>
          <p class="pm-opening">Gratis, vrijblijvend, concreet. Je weet binnen vijf werkdagen waar je staat.</p>
        </div>
        <div class="aud__band-action" data-reveal style="--d: 1">
          <a href="#contact" class="pm-btn pm-btn--yellow" data-overlay-open>Start gratis tracking-audit <Icon name="arrow" /></a>
        </div>
      </div>
    </section>

    <!-- Related services -->
    <section class="pm-section aud__related" aria-labelledby="aud-related-title">
      <div class="pm-container">
        <header class="pm-head">
          <span class="pm-label" data-reveal>Na de audit</span>
          <h2 id="aud-related-title" class="pm-h2" data-reveal style="--d: 1">Alles gevonden? Wij lossen het op.</h2>
          <p class="pm-opening" data-reveal style="--d: 2">Als de audit aantoonbare problemen blootlegt, helpen we je ze ook op te lossen. Dit zijn de diensten die het vaakst volgen op een tracking-audit.</p>
        </header>
        <div class="aud__rel-grid" data-reveal>
          {related.map((r) => (
            <a href={r.href} class:list={["pm-card", "pm-card--lift", "aud__rel"]}>
              <div class:list={["aud__rel-top", `aud__rel-top--${r.tone}`]}>
                <span class:list={["pm-icon", r.tone === "yellow" ? "pm-icon--milk" : "pm-icon--wine"]}><Icon name={r.icon} /></span>
                <h3 class="pm-h3">{r.title}</h3>
              </div>
              <div class="aud__rel-body">
                <p class="pm-text">{r.body}</p>
                <span class="pm-link">{r.link} <Icon name="arrow" size={18} /></span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Closing CTA -->
    <section class="pm-band aud__cta" id="contact" aria-labelledby="aud-cta-title">
      <div class="pm-container aud__cta-inner">
        <h2 id="aud-cta-title" class="pm-h2 pm-outline aud__cta-title" data-reveal>Start vandaag met<br />jouw gratis audit</h2>
        <p class="pm-opening aud__cta-text" data-reveal style="--d: 1">Stuur ons je website-URL en we laten je weten hoe je tracking ervoor staat, inclusief wat je nu mist en hoe je het oplost.</p>
        <div class="aud__cta-actions" data-reveal style="--d: 2">
          <a href="#" class="pm-btn pm-btn--yellow" data-overlay-open>Plan gratis tracking-audit <Icon name="arrow" /></a>
        </div>
      </div>
    </section>

    <Footer />
    <ContactOverlay />
  </main>
</BaseLayout>

<style>
  /* ── Hero ─────────────────────────────────────────── */
  .aud__hero { position: relative; padding-top: 72px; }
  .aud__panel { padding: clamp(4.5rem, 8vw, 6.5rem) var(--pm-gutter) clamp(11rem, 18vw, 14rem); }
  .aud__hero-content {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 1.5rem;
    max-width: 880px;
    margin-inline: auto;
  }
  .aud__title { color: var(--pm-milk); }
  .aud__actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 1rem; margin-top: 0.5rem; }
  .aud__badges {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.5rem;
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--pm-milk);
  }
  .aud__badges li { display: inline-flex; align-items: center; gap: 0.4rem; }
  .aud__badges :global(svg) { color: var(--pm-yellow); }

  .aud__float-wrap { position: relative; z-index: 2; margin-top: clamp(-9rem, -14vw, -7rem); }
  .aud__float {
    max-width: 880px;
    margin-inline: auto;
    padding: clamp(1.75rem, 3.5vw, 2.75rem);
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(1.25rem, 3vw, 2.5rem);
    align-items: start;
  }
  .aud__float-head { display: grid; justify-items: start; gap: 1rem; }

  /* ── Why ──────────────────────────────────────────── */
  .aud__why-grid { align-items: center; gap: clamp(2rem, 5vw, 5rem); }
  .aud__why-text { display: grid; gap: 1rem; }
  .aud__why-text .pm-text + .pm-text { margin-top: 0; }
  .aud__punch { margin: 0; font-weight: 700; color: var(--pm-ink); }
  .aud__stats { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; }
  .aud__stat { padding: 1.5rem 1.75rem; box-shadow: var(--pm-drop); background: var(--pm-milk); }
  .aud__stat--1 { background: var(--pm-pink); }
  .aud__stat--2 { background: var(--pm-yellow); }
  .aud__stat--1 .pm-stat__label, .aud__stat--2 .pm-stat__label { color: var(--pm-ink); }

  /* ── Checks ───────────────────────────────────────── */
  .aud__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }
  .aud__card { display: grid; align-content: start; gap: 1rem; }
  .aud__card .pm-icon { transition: transform 0.5s var(--pm-ease-spring); }
  @media (hover: hover) {
    .aud__card:hover .pm-icon { transform: rotate(-8deg) scale(1.06); }
  }

  /* ── Process ──────────────────────────────────────── */
  .aud__process-card { padding: clamp(2rem, 5vw, 4rem); }
  .aud__process-head { margin-bottom: clamp(2rem, 4vw, 3rem); }
  .aud__on-dark { color: var(--pm-yellow); }
  .aud__steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    counter-reset: none;
  }
  .aud__step {
    display: grid;
    align-content: start;
    gap: 0.75rem;
    padding: 1.5rem;
    border: var(--pm-border);
    border-radius: var(--pm-r);
    background: var(--pm-milk);
    color: var(--pm-ink);
  }
  .aud__step p { margin: 0; color: var(--pm-ink-soft); }
  .aud__step-num {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border: var(--pm-border);
    border-radius: 50%;
    background: var(--pm-yellow);
    box-shadow: 0 4px 0 var(--pm-ink);
    font-family: var(--pm-display);
    font-size: 1.35rem;
  }
  .aud__step:nth-child(2) .aud__step-num { background: var(--pm-pink); }
  .aud__step:nth-child(3) .aud__step-num { background: var(--pm-red); color: var(--pm-milk); }

  /* ── Band ─────────────────────────────────────────── */
  .aud__band { padding-block: clamp(3.5rem, 7vw, 5.5rem); border-block: var(--pm-border); }
  .aud__band-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem 3rem;
    flex-wrap: wrap;
  }
  .aud__band-inner > div:first-child { display: grid; gap: 0.75rem; max-width: 720px; }
  .aud__band-title { font-size: clamp(2rem, 3.6vw, 3rem); }

  /* ── Related ──────────────────────────────────────── */
  .aud__rel-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .aud__rel { display: flex; flex-direction: column; background: var(--pm-milk); }
  .aud__rel-top {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.5rem;
    border-bottom: var(--pm-border);
  }
  .aud__rel-top--pink { background: var(--pm-pink); }
  .aud__rel-top--yellow { background: var(--pm-yellow); }
  .aud__rel-top--red { background: var(--pm-red); color: var(--pm-milk); }
  .aud__rel-body { display: flex; flex-direction: column; gap: 1.25rem; flex: 1; padding: 1.5rem; }
  .aud__rel-body .pm-text { flex: 1; }

  /* ── Closing CTA ──────────────────────────────────── */
  .aud__cta { padding: clamp(5rem, 10vw, 8rem) 0; }
  .aud__cta-inner { display: grid; justify-items: center; text-align: center; gap: 1.5rem; }
  .aud__cta-title { font-size: clamp(2.6rem, 6vw, 4.75rem); }
  .aud__cta-text { color: var(--pm-ink); }

  /* ── Responsive ───────────────────────────────────── */
  @media (max-width: 1100px) {
    .aud__grid, .aud__rel-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 860px) {
    .aud__float { grid-template-columns: 1fr; }
    .aud__steps { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .aud__hero { padding-top: 64px; }
    .aud__actions { flex-direction: column; align-self: stretch; }
    .aud__actions .pm-btn, .aud__band-action, .aud__band-action .pm-btn, .aud__cta-actions, .aud__cta-actions .pm-btn { width: 100%; }
    .aud__grid, .aud__rel-grid { grid-template-columns: 1fr; }
    .pm-btn { white-space: normal; text-align: center; }
  }
</style>
