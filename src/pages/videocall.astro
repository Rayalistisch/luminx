---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import ContactOverlay from "../components/ContactOverlay.astro";
import Icon from "../components/pm/Icon.astro";

const calendarUrl = "https://calendar.google.com/calendar/appointments/schedules/AcZssZ0KnPaRiH37bvNSB0ta7HrOtyHk8wT8EUaAMULRWJcV8kywKhl-TEVeRu1YsOLCFd3vzfBt6dve?gv=true";
---

<BaseLayout
  title="Plan een Videocall | LuminX"
  description="Plan een gratis videocall met LuminX. Kies een moment dat jou uitkomt en bespreek je project via Google Meet."
>
  <Nav basePath="/" />

  <main class="vc">
    <!-- Hero -->
    <section class="vc__hero" aria-labelledby="vc-title">
      <div class="pm-stack">
        <span class="pm-stack__layer" aria-hidden="true"></span>
        <span class="pm-stack__layer" aria-hidden="true"></span>
        <span class="pm-stack__layer" aria-hidden="true"></span>
        <div class="pm-stack__panel vc__panel">
          <div class="vc__hero-content">
            <a href="/" class="pm-link vc__back" data-reveal><span class="vc__back-icon" aria-hidden="true"><Icon name="arrow" size={18} /></span> Terug naar homepage</a>
            <span class="pm-tag" data-reveal style="--d: 1"><Icon name="video" size={16} /> Videocall</span>
            <h1 id="vc-title" class="pm-h1 vc__title" data-reveal style="--d: 2">Plan een gesprek</h1>
            <p class="pm-opening" data-reveal style="--d: 3">Kies een moment dat jou uitkomt. We bespreken je project, beantwoorden je vragen en kijken samen naar de mogelijkheden, vrijblijvend via Google Meet.</p>
          </div>
        </div>
      </div>

      <!-- Booking card overlapping the panel -->
      <div class="pm-container vc__booking-wrap">
        <div class="pm-card pm-card--lift vc__booking" data-reveal>
          <header class="vc__booking-head">
            <span class="pm-icon pm-icon--yellow" aria-hidden="true"><Icon name="calendar" /></span>
            <h2 class="pm-h2 vc__booking-title">Kies direct je tijdslot</h2>
            <p class="pm-text">Plan je gratis kennismaking direct in onze agenda. Na het boeken ontvang je automatisch een bevestiging met Google Meet-link.</p>
          </header>

          <div class="vc__embed">
            <iframe
              src={calendarUrl}
              title="Plan een videocall met LuminX"
              loading="lazy"
              referrerpolicy="strict-origin-when-cross-origin"
              frameborder="0"
              allowfullscreen
            ></iframe>
          </div>

          <p class="vc__fallback">
            Werkt de kalender niet op jouw device?
            <a href={calendarUrl} target="_blank" rel="noopener noreferrer">Open de planner in een nieuw tabblad</a>.
          </p>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="pm-band vc__cta" aria-labelledby="vc-cta-title">
      <div class="pm-container vc__cta-inner">
        <h2 id="vc-cta-title" class="pm-h2 pm-outline vc__cta-title" data-reveal>Liever direct contact?</h2>
        <p class="pm-opening vc__cta-text" data-reveal style="--d: 1">Stuur ons een bericht via het contactformulier of app ons op WhatsApp.</p>
        <div class="vc__cta-actions" data-reveal style="--d: 2">
          <a href="#" class="pm-btn pm-btn--yellow" data-overlay-open>Neem contact op <Icon name="arrow" /></a>
        </div>
      </div>
    </section>

    <Footer />
    <ContactOverlay />
  </main>
</BaseLayout>

<style>
  /* ── Hero ─────────────────────────────────────────── */
  .vc__hero { position: relative; padding-top: 72px; }
  .vc__panel { padding: clamp(4rem, 7vw, 6rem) var(--pm-gutter) clamp(11rem, 18vw, 14rem); }
  .vc__hero-content {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 1.4rem;
    max-width: 820px;
    margin-inline: auto;
  }
  .vc__title { color: var(--pm-milk); }
  .vc__back { color: var(--pm-milk); }
  .vc__back-icon { display: inline-flex; transform: scaleX(-1); }
  @media (hover: hover) {
    .vc__back:hover { color: var(--pm-yellow); }
  }

  /* ── Booking card ─────────────────────────────────── */
  .vc__booking-wrap { position: relative; z-index: 2; margin-top: clamp(-9rem, -14vw, -7rem); }
  .vc__booking {
    max-width: 1120px;
    margin-inline: auto;
    padding: clamp(1.5rem, 4vw, 3rem);
  }
  .vc__booking-head {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 1rem;
    max-width: 640px;
    margin: 0 auto clamp(1.75rem, 3.5vw, 2.5rem);
  }
  .vc__embed {
    width: 100%;
    border: var(--pm-border);
    border-radius: var(--pm-r);
    overflow: hidden;
    background: var(--pm-milk);
  }
  .vc__embed iframe {
    display: block;
    width: 100%;
    min-height: 860px;
    border: 0;
  }
  .vc__fallback {
    margin: 1.1rem 0 0;
    text-align: center;
    font-size: 0.95rem;
    color: var(--pm-ink-soft);
  }
  .vc__fallback a {
    color: var(--pm-wine);
    font-weight: 700;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  /* ── CTA ──────────────────────────────────────────── */
  .vc__cta { padding: clamp(5rem, 10vw, 8rem) 0; margin-top: var(--pm-section); }
  .vc__cta-inner { display: grid; justify-items: center; text-align: center; gap: 1.5rem; }
  .vc__cta-title { font-size: clamp(2.6rem, 6vw, 4.75rem); }
  .vc__cta-text { color: var(--pm-ink); }

  @media (max-width: 640px) {
    .vc__hero { padding-top: 64px; }
    .vc__booking { padding: 1rem; border-radius: var(--pm-r); }
    .vc__booking-head { padding: 0.75rem 0.5rem 0; }
    .vc__embed { border-radius: var(--pm-r-sm); }
    .vc__embed iframe { min-height: 740px; }
    .vc__cta-actions, .vc__cta-actions .pm-btn { width: 100%; }
  }
</style>
