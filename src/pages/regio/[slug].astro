---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ServicePage from "../../components/ServicePage.astro";
import { cities, services } from "../../data/regional";
import type { City, ServiceDef } from "../../data/regional";

export function getStaticPaths() {
  const paths = [];
  for (const city of cities) {
    for (const [serviceKey, service] of Object.entries(services)) {
      paths.push({
        params: { slug: `${serviceKey}-${city.slug}` },
        props: { city, service, serviceKey },
      });
    }
  }
  return paths;
}

interface Props {
  city: City;
  service: ServiceDef;
  serviceKey: string;
}

const { city, service, serviceKey } = Astro.props;

const siteOrigin = Astro.site?.toString() ?? "https://luminx.nl";

const parentServiceMap: Record<string, { label: string; href: string }> = {
  seo: { label: "Online Marketing", href: "/diensten/online-marketing" },
  sea: { label: "Online Marketing", href: "/diensten/online-marketing" },
  emailmarketing: { label: "Online Marketing", href: "/diensten/online-marketing" },
  "social-advertising": { label: "Online Marketing", href: "/diensten/online-marketing" },
  "online-marketing": { label: "Online Marketing", href: "/diensten/online-marketing" },
};

const otherCities = cities.filter((c) => c.slug !== city.slug);

const localBusinessSchema = {
  "@type": "ProfessionalService",
  name: "LuminX",
  url: siteOrigin,
  email: "hello@luminx.nl",
  areaServed: {
    "@type": "City",
    name: city.name,
    containedInPlace: {
      "@type": "AdministrativeArea",
      name: "Twente",
    },
  },
  serviceType: service.label,
};
---

<BaseLayout
  title={service.metaTitle(city.name)}
  description={service.metaDesc(city.name)}
  structuredData={localBusinessSchema}
>
  <ServicePage
    title={`${service.label} in ${city.name}`}
    icon={service.icon}
    intro={service.intro(city.name, city.context)}
    metrics={service.metrics}
    painPoints={service.painPoints}
    highlights={service.highlights}
    process={service.process}
    outcomes={service.outcomes}
    parentService={parentServiceMap[serviceKey]}
  >
    {serviceKey === "online-marketing" && (
      <div slot="body" class={`regional-body regional-body--${city.layout ?? 'cols'}`}>
        {city.layout === "highlight" ? (
          <>
            <div class="regional-highlight">
              <p class="regional-highlight-label">De markt in {city.name}</p>
              <p class="regional-highlight-note">{city.marketNote}</p>
              <p>LuminX is het <a href="/diensten/online-marketing">online marketing bureau</a> dat voor bedrijven in {city.name} meetbare groei realiseert via de kanalen die echt bijdragen.</p>
            </div>
            <div class="regional-channels">
              <h2>Kanalen die we inzetten</h2>
              <ul>
                <li><a href="/diensten/seo">SEO</a>: structurele zichtbaarheid zonder doorlopende advertentiekosten</li>
                <li><a href="/diensten/sea">Google Ads</a>: direct bovenaan bij actieve zoekopdrachten</li>
                <li><a href="/diensten/social-advertising">Social Advertising</a>: bereik op Meta en LinkedIn</li>
                <li><a href="/diensten/emailmarketing">E-mailmarketing</a>: leads nurturen en klanten activeren</li>
              </ul>
              <p class="regional-other">
                Ook actief in:
                {otherCities.map((c, i) => (
                  <>
                    <a href={`/regio/online-marketing-${c.slug}`}>{c.name}</a>{i < otherCities.length - 1 ? ", " : ""}
                  </>
                ))}
              </p>
            </div>
          </>
        ) : city.layout === "cards" ? (
          <>
            <div class="regional-card">
              <h2>De markt in {city.name}</h2>
              <p>{city.marketNote}</p>
              <p>LuminX is het <a href="/diensten/online-marketing">online marketing bureau</a> dat voor bedrijven in {city.name} meetbare groei realiseert.</p>
            </div>
            <div class="regional-card">
              <h2>Kanalen die we inzetten</h2>
              <ul>
                <li><a href="/diensten/seo">SEO</a>: structurele zichtbaarheid zonder doorlopende advertentiekosten</li>
                <li><a href="/diensten/sea">Google Ads</a>: direct bovenaan bij actieve zoekopdrachten</li>
                <li><a href="/diensten/social-advertising">Social Advertising</a>: bereik op Meta en LinkedIn</li>
                <li><a href="/diensten/emailmarketing">E-mailmarketing</a>: leads nurturen en klanten activeren</li>
              </ul>
              <p class="regional-other">
                Ook actief in:
                {otherCities.map((c, i) => (
                  <>
                    <a href={`/regio/online-marketing-${c.slug}`}>{c.name}</a>{i < otherCities.length - 1 ? ", " : ""}
                  </>
                ))}
              </p>
            </div>
          </>
        ) : (
          <>
            <div class="regional-col">
              <h2>De markt in {city.name}</h2>
              <p>{city.marketNote}</p>
              <p>LuminX is het <a href="/diensten/online-marketing">online marketing bureau</a> dat voor bedrijven in {city.name} meetbare groei realiseert via de kanalen die echt bijdragen.</p>
            </div>
            <div class="regional-col">
              <h2>Kanalen die we inzetten</h2>
              <ul>
                <li><a href="/diensten/seo">SEO</a>: structurele zichtbaarheid zonder doorlopende advertentiekosten</li>
                <li><a href="/diensten/sea">Google Ads</a>: direct bovenaan bij actieve zoekopdrachten</li>
                <li><a href="/diensten/social-advertising">Social Advertising</a>: bereik op Meta en LinkedIn</li>
                <li><a href="/diensten/emailmarketing">E-mailmarketing</a>: leads nurturen en klanten activeren</li>
              </ul>
              <p class="regional-other">
                Ook actief in:
                {otherCities.map((c, i) => (
                  <>
                    <a href={`/regio/online-marketing-${c.slug}`}>{c.name}</a>{i < otherCities.length - 1 ? ", " : ""}
                  </>
                ))}
              </p>
            </div>
          </>
        )}
      </div>
    )}
  </ServicePage>
</BaseLayout>

<style>
  /* Rendered inside ServicePage's .pm-prose body band. Four city layouts keep
     their own rhythm, all in the pm card language. */
  .regional-body {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.25rem, 3vw, 2.5rem);
    align-items: start;
  }
  .regional-body h2 { margin-top: 0; font-size: clamp(1.6rem, 2.4vw, 2.1rem); }
  .regional-body p { margin: 0 0 1em; }
  .regional-body ul { margin: 0 0 1em; }

  /* cols (Enschede): plain columns, second column carded */
  .regional-col:last-child,
  .regional-card,
  .regional-highlight {
    background: var(--pm-milk);
    border: var(--pm-border);
    border-radius: var(--pm-r-lg);
    padding: clamp(1.5rem, 3vw, 2.25rem);
  }

  /* cols-reverse (Hengelo) */
  .regional-body--cols-reverse > :first-child { order: 2; }

  /* cards (Almelo): both columns carded, second lifted */
  .regional-body--cards .regional-card:last-child {
    box-shadow: var(--pm-drop-lg);
    background: var(--pm-cream);
  }

  /* highlight (Oldenzaal): a pink note card */
  .regional-highlight {
    background: var(--pm-pink);
    box-shadow: var(--pm-drop-lg);
    color: var(--pm-ink);
  }
  .regional-highlight p { color: var(--pm-ink); }
  .regional-highlight a { color: var(--pm-ink); }
  .regional-highlight-label {
    font-family: var(--pm-body);
    font-size: var(--pm-fs-label);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 0.75rem !important;
  }
  .regional-highlight-note {
    font-family: var(--pm-display);
    font-size: clamp(1.4rem, 2.2vw, 1.85rem);
    line-height: 1.2;
    margin-bottom: 1.25rem !important;
  }

  .regional-other {
    font-size: 0.95rem;
    color: var(--pm-ink-mute);
    margin-top: 1.25rem !important;
  }

  @media (max-width: 768px) {
    .regional-body { grid-template-columns: 1fr; }
    .regional-body--cols-reverse > :first-child { order: 0; }
  }
</style>
