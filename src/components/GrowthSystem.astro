---
import Icon from "./pm/Icon.astro";

const steps = [
  { label: "Website", note: "Het fundament", icon: "globe" },
  { label: "SEO", note: "Gevonden worden", icon: "search" },
  { label: "Ads", note: "Versnellen", icon: "megaphone" },
  { label: "CRM", note: "Leads opvolgen", icon: "users" },
  { label: "Automatisering", note: "Werk eruit", icon: "workflow" },
  { label: "AI", note: "Slimmer schalen", icon: "bot" },
] as const;
---

<section class="pm-section pm-section--tight growth" id="systeem" aria-labelledby="growth-title">
  <div class="pm-container">
    <div class="pm-card pm-card--plum pm-card--lift growth__card">
      <header class="pm-head growth__head">
        <span class="pm-tag pm-tag--pink" data-reveal>Hoe het samenkomt</span>
        <h2 id="growth-title" class="pm-h2" data-reveal style="--d: 1">Eén doorlopend signaal, van eerste klik tot omzet.</h2>
        <p class="pm-opening" data-reveal style="--d: 2">Elke schakel versterkt de volgende. Daarom bouwen we ze als één systeem, niet als losse projecten.</p>
      </header>

      <ol class="growth__chain">
        {steps.map((s, i) => (
          <li class="growth__step" data-reveal style={`--d: ${i}`}>
            <span class="pm-icon pm-icon--milk"><Icon name={s.icon} /></span>
            <strong>{s.label}</strong>
            <span>{s.note}</span>
          </li>
        ))}
        <li class="growth__step growth__step--goal" data-reveal style={`--d: ${steps.length}`}>
          <span class="pm-icon pm-icon--yellow"><Icon name="heart" /></span>
          <strong>Omzet</strong>
          <span>Het enige dat telt</span>
        </li>
      </ol>
    </div>
  </div>
</section>

<style>
  .growth__card {
    padding: clamp(3rem, 7vw, 5.5rem) clamp(1.25rem, 4vw, 3.5rem);
  }
  .growth__head .pm-opening { color: rgba(255, 250, 240, 0.85); }

  .growth__chain {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 0.75rem;
  }

  /* dotted thread behind the icons */
  .growth__chain::before {
    content: "";
    position: absolute;
    left: 7%;
    right: 7%;
    top: 27px;
    height: 2px;
    background: repeating-linear-gradient(90deg, var(--pm-pink) 0 4px, transparent 4px 10px);
  }

  .growth__step {
    position: relative;
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 0.35rem;
  }
  .growth__step .pm-icon { margin-bottom: 0.6rem; }
  .growth__step strong {
    font-family: var(--pm-display);
    font-weight: 400;
    font-size: clamp(1.15rem, 1.5vw, 1.4rem);
    letter-spacing: 0.01em;
    line-height: 1.1;
  }
  .growth__step span:last-child { font-size: 0.85rem; color: rgba(255, 250, 240, 0.7); }
  .growth__step--goal strong { color: var(--pm-yellow); }

  @media (max-width: 960px) {
    .growth__chain { grid-template-columns: repeat(4, minmax(0, 1fr)); row-gap: 2rem; }
    .growth__chain::before { display: none; }
  }
  @media (max-width: 560px) {
    .growth__chain { grid-template-columns: 1fr; gap: 0; }
    .growth__chain::before {
      display: block;
      left: 27px;
      right: auto;
      top: 28px;
      bottom: 28px;
      width: 2px;
      height: auto;
      background: repeating-linear-gradient(180deg, var(--pm-pink) 0 4px, transparent 4px 10px);
    }
    .growth__step {
      grid-template-columns: 56px 1fr;
      justify-items: start;
      text-align: left;
      column-gap: 1rem;
      row-gap: 0;
      padding-block: 0.6rem;
    }
    .growth__step .pm-icon { grid-row: span 2; margin: 0; }
  }
</style>
