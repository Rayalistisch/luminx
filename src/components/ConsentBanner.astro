---
import Icon from "./pm/Icon.astro";
---

<div class="consent-widget" data-consent-widget hidden>
  <div class="consent-banner" role="dialog" aria-live="polite" aria-label="Cookievoorkeuren">
    <div class="consent-banner__head">
      <span class="pm-icon pm-icon--sm pm-icon--yellow" aria-hidden="true"><Icon name="cookie" /></span>
      <h3 class="consent-banner__title">Deze website gebruikt cookies</h3>
    </div>
    <p class="consent-banner__text">We gebruiken cookies voor analytics en marketing om de website te verbeteren.</p>

    <div class="consent-preferences" data-consent-preferences hidden>
      <label class="consent-pref-item">
        <span>
          <strong>Analytics</strong>
          <small>Helpt ons prestaties en gebruik te meten.</small>
        </span>
        <input type="checkbox" class="consent-switch" data-consent-analytics />
      </label>

      <label class="consent-pref-item">
        <span>
          <strong>Marketing</strong>
          <small>Voor advertentie-metingen en personalisatie.</small>
        </span>
        <input type="checkbox" class="consent-switch" data-consent-marketing />
      </label>
    </div>

    <div class="consent-actions">
      <button type="button" class="pm-btn pm-btn--white pm-btn--sm consent-btn" data-consent-customize>Aanpassen</button>
      <button type="button" class="pm-btn pm-btn--white pm-btn--sm consent-btn" data-consent-save hidden>Opslaan</button>
      <button type="button" class="pm-btn pm-btn--yellow pm-btn--sm consent-btn" data-consent-accept>Alles toestaan</button>
    </div>
  </div>

  <button type="button" class="consent-manage" data-consent-manage aria-label="Cookie-instellingen" hidden>
    <Icon name="cookie" size={22} />
  </button>
</div>

<script is:inline>
  (() => {
    const CONSENT_KEY = "luminx_consent_v1";
    const root = document.querySelector("[data-consent-widget]");
    if (!root) return;

    const banner = root.querySelector(".consent-banner");
    const acceptBtn = root.querySelector("[data-consent-accept]");
    const customizeBtn = root.querySelector("[data-consent-customize]");
    const saveBtn = root.querySelector("[data-consent-save]");
    const prefWrap = root.querySelector("[data-consent-preferences]");
    const analyticsInput = root.querySelector("[data-consent-analytics]");
    const marketingInput = root.querySelector("[data-consent-marketing]");
    const manageBtn = root.querySelector("[data-consent-manage]");

    function getStoredConsent() {
      try {
        const raw = localStorage.getItem(CONSENT_KEY);
        if (!raw) return null;
        if (raw === "granted") return { analytics: true, marketing: true };
        if (raw === "denied") return { analytics: false, marketing: false };
        return JSON.parse(raw);
      } catch (_e) {
        return null;
      }
    }

    function persistConsent(prefs) {
      try {
        localStorage.setItem(CONSENT_KEY, JSON.stringify(prefs));
      } catch (_e) {
        // ignore storage failures
      }
    }

    function toPayload(prefs) {
      const analytics = prefs?.analytics ? "granted" : "denied";
      const marketing = prefs?.marketing ? "granted" : "denied";
      return {
        ad_storage: marketing,
        analytics_storage: analytics,
        ad_user_data: marketing,
        ad_personalization: marketing,
        functionality_storage: "granted",
        security_storage: "granted",
      };
    }

    function updateConsent(prefs, mode) {
      const payload = toPayload(prefs);
      window.dataLayer = window.dataLayer || [];
      window.gtag =
        window.gtag ||
        function () {
          window.dataLayer.push(arguments);
        };
      window.gtag("consent", "update", payload);
      window.dataLayer.push({
        event: "consent_update",
        consent_mode: mode,
      });
    }

    function syncInputs(prefs) {
      if (analyticsInput) analyticsInput.checked = !!prefs?.analytics;
      if (marketingInput) marketingInput.checked = !!prefs?.marketing;
    }

    function openPreferences() {
      if (analyticsInput) analyticsInput.checked = true;
      if (marketingInput) marketingInput.checked = true;
      if (prefWrap) prefWrap.hidden = false;
      if (saveBtn) saveBtn.hidden = false;
      if (customizeBtn) customizeBtn.hidden = true;
    }

    function closePreferences() {
      if (prefWrap) prefWrap.hidden = true;
      if (saveBtn) saveBtn.hidden = true;
      if (customizeBtn) customizeBtn.hidden = false;
    }

    function openBanner() {
      root.hidden = false;
      banner?.classList.add("is-open");
      if (manageBtn) manageBtn.hidden = true;
      closePreferences();
    }

    function closeBanner() {
      banner?.classList.remove("is-open");
      if (manageBtn) manageBtn.hidden = false;
      closePreferences();
    }

    function applyChoice(prefs, mode) {
      persistConsent(prefs);
      updateConsent(prefs, mode);
      closeBanner();
    }

    const stored = getStoredConsent() || { analytics: false, marketing: false };
    syncInputs(stored);
    root.hidden = false;
    if (getStoredConsent()) {
      closeBanner();
    } else {
      openBanner();
    }

    acceptBtn?.addEventListener("click", () => applyChoice({ analytics: true, marketing: true }, "granted"));
    customizeBtn?.addEventListener("click", openPreferences);
    saveBtn?.addEventListener("click", () => {
      const prefs = {
        analytics: !!analyticsInput?.checked,
        marketing: !!marketingInput?.checked,
      };
      applyChoice(prefs, "custom");
    });
    manageBtn?.addEventListener("click", () => {
      syncInputs(getStoredConsent() || { analytics: false, marketing: false });
      openBanner();
    });
  })();
</script>

<style>
  .consent-widget {
    position: fixed;
    left: 1rem;
    bottom: 1rem;
    z-index: 100000;
    pointer-events: none;
    max-width: calc(100vw - 2rem);
  }
  .consent-widget[hidden] { display: none; }

  .consent-banner {
    pointer-events: auto;
    width: min(440px, calc(100vw - 2rem));
    display: none;
    gap: 0.9rem;
    padding: 1.4rem 1.5rem 1.5rem;
    background: var(--pm-milk);
    color: var(--pm-ink);
    border: var(--pm-border);
    border-radius: var(--pm-r);
    box-shadow: var(--pm-drop);
  }
  .consent-banner.is-open {
    display: grid;
    animation: consent-in 0.6s var(--pm-ease) both;
  }
  @keyframes consent-in {
    from { opacity: 0; transform: translateY(24px); }
    to { opacity: 1; transform: none; }
  }

  .consent-banner__head { display: flex; align-items: center; gap: 0.8rem; }
  .consent-banner__title {
    margin: 0;
    font-family: var(--pm-display);
    font-weight: 400;
    font-size: 1.5rem;
    line-height: 1.1;
    letter-spacing: 0.01em;
  }
  .consent-banner__text {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--pm-ink-soft);
  }

  .consent-preferences {
    display: grid;
    gap: 0.6rem;
  }
  .consent-preferences[hidden] { display: none; }

  .consent-pref-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 0.9rem;
    background: var(--pm-paper);
    border: var(--pm-border);
    border-radius: var(--pm-r-sm);
    cursor: pointer;
  }
  .consent-pref-item strong { display: block; font-size: 0.95rem; font-weight: 800; }
  .consent-pref-item small { display: block; margin-top: 0.12rem; font-size: 0.8rem; color: var(--pm-ink-soft); }

  /* checkbox rendered as a chunky switch */
  .consent-switch {
    appearance: none;
    -webkit-appearance: none;
    flex: none;
    position: relative;
    width: 48px;
    height: 28px;
    margin: 0;
    border: var(--pm-border);
    border-radius: var(--pm-pill);
    background: var(--pm-milk);
    cursor: pointer;
    transition: background-color 0.25s ease;
  }
  .consent-switch::after {
    content: "";
    position: absolute;
    top: 3px;
    left: 3px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--pm-ink);
    transition: transform 0.35s var(--pm-ease-spring);
  }
  .consent-switch:checked { background: var(--pm-yellow); }
  .consent-switch:checked::after { transform: translateX(20px); }

  .consent-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 0.25rem;
  }
  .consent-btn { flex: 1 1 auto; }
  .consent-btn[hidden] { display: none; }

  .consent-manage {
    pointer-events: auto;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: var(--pm-border);
    border-radius: 50%;
    background: var(--pm-milk);
    color: var(--pm-ink);
    box-shadow: 0 4px 0 var(--pm-ink);
    cursor: pointer;
    transition: transform 0.4s var(--pm-ease), box-shadow 0.4s var(--pm-ease);
  }
  .consent-manage[hidden] { display: none; }
  .consent-manage:active { transform: translateY(3px); box-shadow: 0 1px 0 var(--pm-ink); }
  @media (hover: hover) {
    .consent-manage:hover { transform: translateY(-2px) rotate(-12deg); box-shadow: 0 6px 0 var(--pm-ink); }
  }

  @media (max-width: 768px) {
    /* banner sits above the mobile bottom bar */
    .consent-widget {
      left: 16px;
      right: 16px;
      bottom: calc(88px + env(safe-area-inset-bottom));
      max-width: none;
    }
    .consent-banner { width: 100%; box-sizing: border-box; }
    .consent-actions { display: grid; grid-template-columns: 1fr; }
    .consent-btn { width: 100%; }

    /* manage button: beside the bottom bar, vertically centred on it */
    .consent-manage {
      position: fixed;
      left: 16px;
      bottom: calc(16px + 9px + env(safe-area-inset-bottom));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .consent-banner.is-open { animation: none; }
    .consent-switch::after, .consent-manage { transition: none; }
  }
</style>
