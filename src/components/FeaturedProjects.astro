---
import Icon from "./pm/Icon.astro";

const projects = [
  {
    title: "DG Rubber Profiles",
    result: "PageSpeed 100 over alle secties",
    tag: "Custom WordPress",
    description: "Volledig custom WordPress-website met eigen huisstijl in front-end én back-end, met nagenoeg geen plugins.",
    image: "/images/dg-rubber-profiles.png",
    href: "/cases/dg-rubber-profiles",
  },
  {
    title: "GSM Team",
    result: "40% snellere laadtijd, 0 dagen downtime",
    tag: "Migratie",
    description: "WordPress → Shopify-migratie met volledig behoud van SEO-waarde.",
    image: "/images/website-gsmteam.png",
    href: "/cases/migraties",
  },
  {
    title: "ReservaX / ActifAid",
    result: "5+ uur per week teruggewonnen",
    tag: "Websites · Procesautomation",
    description: "Custom afsprakensysteem dat handmatige planning volledig vervangt.",
    image: "/images/reservaxactifaid.png",
    href: "/cases/custom-applicaties",
  },
  {
    title: "Ascendio",
    result: "3× meer organisch verkeer",
    tag: "SEO · AI-automation",
    description: "AI-gedreven contentclusters die autoriteit en verkeer laten samenkomen.",
    image: "/images/ascendio seo automation.jpg",
    href: "/cases/digital-marketing",
  },
];
---

<section class="pm-section projects" id="werk" aria-labelledby="projects-title">
  <div class="pm-container">
    <header class="pm-head">
      <span class="pm-label" data-reveal>Geselecteerd werk</span>
      <h2 id="projects-title" class="pm-h2" data-reveal style="--d: 1">Bewijs, geen beloftes.</h2>
      <p class="pm-opening" data-reveal style="--d: 2">Vier projecten, vier meetbare uitkomsten.</p>
    </header>

    <div class="projects__grid">
      {projects.map((p, i) => (
        <a class="pm-card pm-card--lift projects__card" href={p.href} data-reveal style={`--d: ${i % 2}`}>
          <span class="pm-media projects__media">
            <img src={p.image} alt={`Project ${p.title}`} loading="lazy" decoding="async" />
          </span>
          <span class="projects__body">
            <span class="pm-tag projects__tag">{p.tag}</span>
            <span class="pm-h3 projects__title">{p.title}</span>
            <span class="projects__desc">{p.description}</span>
            <span class="projects__foot">
              <span class="projects__result"><Icon name="trending-up" size={18} /> {p.result}</span>
              <span class="projects__arrow" aria-hidden="true"><Icon name="arrow-up-right" size={20} stroke={2.4} /></span>
            </span>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .projects__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 2.25rem);
  }

  /* offset the right column for a less template-y rhythm */
  @media (min-width: 861px) {
    .projects__card:nth-child(even) { margin-top: 4rem; }
  }

  .projects__card { display: flex; flex-direction: column; background: var(--pm-milk); }

  .projects__media {
    aspect-ratio: 16 / 10;
    border-bottom: var(--pm-border);
    overflow: hidden;
  }
  .projects__media img { transition: transform 0.9s var(--pm-ease); }
  @media (hover: hover) {
    .projects__card:hover .projects__media img { transform: scale(1.04); }
  }

  .projects__body {
    display: grid;
    gap: 0.75rem;
    padding: clamp(1.5rem, 2.5vw, 2rem);
    flex: 1;
    align-content: start;
  }
  .projects__tag { justify-self: start; }
  .projects__desc { color: var(--pm-ink-soft); }

  .projects__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.5rem;
    padding-top: 1rem;
    border-top: 2px dashed var(--pm-ink-line);
  }
  .projects__result { display: inline-flex; align-items: center; gap: 0.5rem; font-weight: 700; }
  .projects__result :global(svg) { color: var(--pm-red); flex: none; }

  .projects__arrow {
    display: grid;
    place-items: center;
    flex: none;
    width: 44px;
    height: 44px;
    border: var(--pm-border);
    border-radius: 50%;
    background: var(--pm-yellow);
    transition: transform 0.45s var(--pm-ease);
  }
  @media (hover: hover) {
    .projects__card:hover .projects__arrow { transform: rotate(45deg); }
  }

  @media (max-width: 860px) {
    .projects__grid { grid-template-columns: 1fr; }
  }
</style>
