---
import Logo from "./pm/Logo.astro";
const columns = [
  {
    title: "Navigatie",
    links: [
      { label: "Werk", href: "/#werk" },
      { label: "Diensten", href: "/#diensten" },
      { label: "Over", href: "/#over" },
      { label: "Contact", href: "/#contact" },
      { label: "Blog", href: "/blog" },
    ],
  },
  {
    title: "Diensten",
    links: [
      { label: "Procesautomation", href: "/diensten/procesautomation" },
      { label: "Websites", href: "/diensten/websites" },
      { label: "Webshops", href: "/diensten/webshops" },
      { label: "Strategie", href: "/diensten/strategy" },
      { label: "Online marketing", href: "/diensten/online-marketing" },
    ],
  },
  {
    title: "Vergelijk",
    links: [
      { label: "SEO vs. SEA", href: "/vergelijk/seo-vs-sea" },
      { label: "GEO vs. SEO", href: "/vergelijk/geo-vs-seo" },
      { label: "Gratis tracking-audit", href: "/tracking-audit" },
      { label: "Plan een videocall", href: "/videocall" },
    ],
  },
  {
    title: "Contact",
    links: [
      { label: "hello@luminx.nl", href: "mailto:hello@luminx.nl" },
      { label: "+31 6 1369 8596", href: "tel:+31613698596" },
    ],
  },
];
---

<footer class="footer pm-band">
  <div class="pm-container">
    <div class="footer__top">
      <div class="footer__brand">
        <Logo as="a" href="/" class="footer__logo" aria-label="LuminX – home" />
        <p>Strategie, automatisering en digitale producten die merken laten groeien. Vanuit Enschede, voor heel Twente.</p>
      </div>

      <nav class="footer__cols" aria-label="Footer">
        {columns.map((c) => (
          <div class="footer__col">
            <p class="footer__title">{c.title}</p>
            <ul>
              {c.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
            </ul>
          </div>
        ))}
      </nav>
    </div>

    <div class="footer__bar">
      <a href="/privacy">Privacyverklaring</a>
      <p>&copy; {new Date().getFullYear()} LuminX. Alle rechten voorbehouden.</p>
      <a href="/algemene-voorwaarden">Algemene voorwaarden</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding: clamp(4rem, 8vw, 6rem) 0 clamp(1.5rem, 3vw, 2.5rem);
  }

  .footer__top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
    gap: clamp(2.5rem, 5vw, 5rem);
    padding-bottom: clamp(3rem, 6vw, 4.5rem);
  }

  .footer__logo { font-size: clamp(2rem, 3.6vw, 2.75rem); }

  .footer__brand p {
    max-width: 360px;
    margin: 1.5rem 0 0;
    color: var(--pm-ink);
    font-weight: 600;
  }

  .footer__cols {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2rem;
  }

  .footer__title {
    margin: 0 0 1rem;
    font-size: var(--pm-fs-label);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--pm-ink);
  }

  .footer__col ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.55rem; }
  .footer__col a {
    color: var(--pm-milk);
    font-weight: 600;
    text-decoration: none;
    overflow-wrap: anywhere;
    transition: color 0.2s ease;
  }
  @media (hover: hover) { .footer__col a:hover { color: var(--pm-ink); } }

  .footer__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    flex-wrap: wrap;
    padding: 1.6rem clamp(1.25rem, 3vw, 2.25rem);
    background: var(--pm-wine);
    border: var(--pm-border);
    border-radius: var(--pm-r);
    box-shadow: var(--pm-drop-lg);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .footer__bar p { margin: 0; letter-spacing: 0; text-transform: none; }
  .footer__bar a { color: var(--pm-milk); text-decoration: none; }
  @media (hover: hover) { .footer__bar a:hover { color: var(--pm-yellow); } }

  @media (max-width: 960px) {
    .footer__top { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .footer__cols { grid-template-columns: 1fr 1fr; }
    .footer__bar { justify-content: center; text-align: center; }
    .footer__bar p { order: 3; width: 100%; }
  }
</style>
