---
import Logo from "./pm/Logo.astro";
---

<section class="cs-hero" aria-labelledby="cs-title">
  <div class="pm-stack cs-hero__stack">
    <span class="pm-stack__layer" aria-hidden="true"></span>
    <span class="pm-stack__layer" aria-hidden="true"></span>
    <span class="pm-stack__layer" aria-hidden="true"></span>

    <div class="pm-stack__panel cs-hero__panel">
      <div class="cs-hero__content">
        <span class="pm-tag cs-hero__tag" data-reveal>Digital marketing solutions</span>
        <Logo as="h1" id="cs-title" class="cs-hero__title" aria-label="LuminX" data-reveal style="--d: 1" />
        <p class="pm-h2 cs-hero__sub" data-reveal style="--d: 2">Coming Soon</p>
        <a href="#wat-wij-bouwen" class="pm-scrollcue cs-hero__cue" data-reveal style="--d: 3">
          Scroll
          <span class="pm-scrollcue__thread" aria-hidden="true"><span class="pm-scrollcue__mouse"></span></span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .cs-hero { padding-top: clamp(16px, 3vw, 32px); }

  .cs-hero__panel {
    min-height: calc(100svh - 160px);
    display: grid;
    place-items: center;
    padding: clamp(4rem, 8vw, 6rem) var(--pm-gutter);
  }

  .cs-hero__content {
    display: grid;
    justify-items: center;
    gap: 1.6rem;
    text-align: center;
  }

  .cs-hero__tag { letter-spacing: 0.08em; text-transform: uppercase; font-size: 0.8rem; font-weight: 700; }

  .cs-hero__title {
    font-size: clamp(2.5rem, 9vw, 6.5rem);
  }

  .cs-hero__sub { color: var(--pm-yellow); }

  .cs-hero__cue { margin-top: 1rem; }

  @media (max-width: 640px) {
    .cs-hero__panel { min-height: calc(100svh - 120px); }
  }
</style>
