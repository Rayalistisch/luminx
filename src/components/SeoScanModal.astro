---
import Icon from "./pm/Icon.astro";
const psiKey = import.meta.env.PUBLIC_PSI_KEY || '';
---

<div class="seo-overlay" id="seoScanOverlay" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Gratis SEO scan" data-psi-key={psiKey}>
  <div class="pm-card pm-card--milk pm-card--lift seo-modal">
    <button class="seo-close" id="seoClose" aria-label="Sluiten"><Icon name="x" size={20} stroke={2.5} /></button>

    <!-- Step 1: Form -->
    <div class="seo-step" id="seoStepForm">
      <span class="pm-tag pm-tag--yellow">Gratis</span>
      <h2 class="pm-h2 seo-title">SEO Scan</h2>
      <p class="pm-text seo-intro">Ontdek in 30 seconden hoe jouw website scoort op SEO. Vul je gegevens in en wij analyseren je site.</p>
      <form id="seoForm" class="seo-form" novalidate>
        <div class="seo-field">
          <label for="seoUrl">Website URL</label>
          <input type="url" id="seoUrl" name="url" placeholder="https://jouwsite.nl" required autocomplete="url" />
        </div>
        <div class="seo-field">
          <label for="seoName">Jouw naam</label>
          <input type="text" id="seoName" name="name" placeholder="Voornaam" required autocomplete="given-name" />
        </div>
        <div class="seo-field">
          <label for="seoEmail">E-mailadres</label>
          <input type="email" id="seoEmail" name="email" placeholder="jij@bedrijf.nl" required autocomplete="email" />
        </div>
        <p class="seo-error" id="seoError" role="alert" hidden></p>
        <button type="submit" class="pm-btn pm-btn--yellow seo-submit">
          <span id="seoSubmitLabel">Scan starten →</span>
        </button>
      </form>
    </div>

    <!-- Step 2: Loading -->
    <div class="seo-step" id="seoStepLoading" hidden>
      <div class="seo-loader" aria-live="polite">
        <div class="seo-radar" aria-hidden="true">
          <span></span><span></span><span></span>
          <i class="seo-radar__core"><Icon name="search" size={22} stroke={2.5} /></i>
        </div>
        <p id="seoLoadingMsg">Website ophalen…</p>
        <small id="seoLoadingUrl"></small>
      </div>
    </div>

    <!-- Step 3: Results -->
    <div class="seo-step" id="seoStepResults" hidden>
      <div class="seo-results-header">
        <h2 class="pm-h3 seo-results-title">Resultaten <span id="seoScoreSite"></span></h2>
        <p id="seoScoreLabel" class="pm-text seo-score-sublabel"></p>
      </div>

      <div class="seo-columns">
        <div class="seo-col seo-col--good">
          <h3 class="seo-col__title">
            <span class="pm-icon pm-icon--sm pm-icon--yellow" aria-hidden="true"><Icon name="check" /></span>
            Goed gedaan
          </h3>
          <ul id="seoGoodList" class="pm-checks seo-list"></ul>
        </div>
        <div class="seo-col seo-col--bad">
          <h3 class="seo-col__title">
            <span class="pm-icon pm-icon--sm" aria-hidden="true"><Icon name="alert" /></span>
            Verbeterpunten
          </h3>
          <ul id="seoBadList" class="seo-list seo-list--bad"></ul>
          <p class="seo-more-note">Dit zijn maximaal 4 van de gevonden verbeterpunten. Voor een volledige SEO + GEO analyse zijn er mogelijk meer aandachtspunten.</p>
        </div>
      </div>

      <div class="seo-upsell">
        <p>Wil je weten <strong>alle</strong> verbeterpunten, inclusief GEO-optimalisatie voor AI-zoekmachines?</p>
        <button type="button" class="pm-btn pm-btn--yellow pm-btn--sm seo-upsell-btn" id="seoUpsellBtn">Vraag uitgebreide scan aan →</button>
      </div>
    </div>

    <!-- Step 4: Error -->
    <div class="seo-step" id="seoStepError" hidden>
      <div class="seo-error-state">
        <span class="pm-icon pm-icon--pink seo-error-state__icon" aria-hidden="true"><Icon name="alert" /></span>
        <h3 class="pm-h3">Scan mislukt</h3>
        <p id="seoErrorMsg" class="pm-text">De URL kon niet worden gescand. Controleer of de URL correct is en probeer opnieuw.</p>
        <button type="button" class="pm-btn pm-btn--white pm-btn--sm seo-retry" id="seoRetry">Opnieuw proberen</button>
      </div>
    </div>
  </div>
</div>

<script is:inline>
(() => {
  const AUDITS = {
    'document-title':     { good: 'Paginatitel aanwezig en correct',            bad: 'Paginatitel ontbreekt of is niet optimaal' },
    'meta-description':   { good: 'Meta-omschrijving gevonden',                 bad: 'Meta-omschrijving ontbreekt of is te kort' },
    'viewport':           { good: 'Mobiele viewport correct ingesteld',         bad: 'Mobiele viewport niet correct ingesteld' },
    'robots-txt':         { good: 'Robots.txt correct geconfigureerd',          bad: 'Robots.txt ontbreekt of blokkeert crawlers' },
    'canonical':          { good: 'Canonical tag aanwezig',                     bad: 'Geen canonical tag gevonden: duplicate content risico' },
    'http-status-code':   { good: 'Pagina geeft correcte HTTP-statuscode',      bad: 'Pagina geeft een foutieve HTTP-statuscode' },
    'crawlable-anchors':  { good: 'Links zijn goed crawlbaar voor Google',      bad: 'Sommige links zijn niet crawlbaar voor Google' },
    'link-text':          { good: 'Links hebben beschrijvende ankertekst',      bad: 'Links missen beschrijvende ankertekst' },
    'image-alt':          { good: 'Afbeeldingen hebben alt-teksten',            bad: 'Afbeeldingen missen alt-teksten' },
    'structured-data':    { good: 'Gestructureerde data (schema.org) aanwezig', bad: 'Geen gestructureerde data gevonden' },
    'hreflang':           { good: 'Hreflang correct ingesteld',                 bad: 'Hreflang ontbreekt of is incorrect' },
    'plugins':            { good: 'Geen verouderde browser-plugins gebruikt',   bad: 'Verouderde plugins gevonden die SEO schaden' },
    'tap-targets':        { good: 'Knoppen groot genoeg voor mobiel gebruik',   bad: 'Knoppen te klein voor mobiel: slechte gebruikservaring' },
    'font-size':          { good: 'Lettergrootte leesbaar op mobiel',           bad: 'Tekst te klein op mobiel' },
  };

  const overlay    = document.getElementById('seoScanOverlay');
  const closeBtn   = document.getElementById('seoClose');
  const form       = document.getElementById('seoForm');
  const stepForm   = document.getElementById('seoStepForm');
  const stepLoad   = document.getElementById('seoStepLoading');
  const stepRes    = document.getElementById('seoStepResults');
  const stepErr    = document.getElementById('seoStepError');
  const errorBox   = document.getElementById('seoError');
  const loadMsg    = document.getElementById('seoLoadingMsg');
  const loadUrl    = document.getElementById('seoLoadingUrl');
  const scoreSite  = document.getElementById('seoScoreSite');
  const scoreLbl   = document.getElementById('seoScoreLabel');
  const goodList   = document.getElementById('seoGoodList');
  const badList    = document.getElementById('seoBadList');
  const upsellBtn  = document.getElementById('seoUpsellBtn');
  const retryBtn   = document.getElementById('seoRetry');
  const errMsg     = document.getElementById('seoErrorMsg');

  function show(el) { el.hidden = false; }
  function hide(el) { el.hidden = true; }

  function openModal() {
    overlay.classList.add('is-open');
    overlay.setAttribute('aria-hidden', 'false');
    document.documentElement.style.overflow = 'hidden';
    document.getElementById('seoUrl')?.focus();
  }

  function closeModal() {
    overlay.classList.remove('is-open');
    overlay.setAttribute('aria-hidden', 'true');
    document.documentElement.style.overflow = '';
  }

  function showStep(step) {
    [stepForm, stepLoad, stepRes, stepErr].forEach(s => hide(s));
    show(step);
  }

  function scoreLabel(score) {
    if (score >= 90) return 'Uitstekend: je website staat er goed voor op SEO-gebied.';
    if (score >= 70) return 'Goed, maar er is nog ruimte voor verbetering.';
    if (score >= 50) return 'Matig: er zijn meerdere aandachtspunten die verkeer kosten.';
    return 'Kritisch: je website mist belangrijke SEO-fundamenten.';
  }

function renderList(ul, items) {
    ul.innerHTML = '';
    items.forEach(text => {
      const li = document.createElement('li');
      li.textContent = text;
      ul.appendChild(li);
    });
  }

  function normalizeUrl(raw) {
    const trimmed = raw.trim();
    if (!trimmed.startsWith('http://') && !trimmed.startsWith('https://')) {
      return 'https://' + trimmed;
    }
    return trimmed;
  }

  async function runScan(url, name, email) {
    showStep(stepLoad);
    loadUrl.textContent = url;

    const messages = ['Website ophalen…', 'Titels en meta-tags controleren…', 'Crawlbaarheid analyseren…', 'Mobiele prestaties meten…', 'Resultaten verwerken…'];
    let mi = 0;
    const ticker = setInterval(() => { loadMsg.textContent = messages[Math.min(++mi, messages.length - 1)]; }, 4000);

    try {
      const apiKey = overlay.dataset.psiKey || '';
      const apiUrl = `https://www.googleapis.com/pagespeedonline/v5/runPagespeed?url=${encodeURIComponent(url)}&strategy=mobile&category=seo${apiKey ? '&key=' + apiKey : ''}`;
      const res = await fetch(apiUrl);
      clearInterval(ticker);

      const data = await res.json();

      if (!res.ok) {
        const msg = data?.error?.message || '';
        if (msg.includes('Quota') || res.status === 429) {
          throw new Error('QUOTA');
        }
        throw new Error('API fout ' + res.status + (msg ? ': ' + msg : ''));
      }

      const lhr = data.lighthouseResult;
      if (!lhr) throw new Error('Geen resultaten ontvangen');

      const seoScore = Math.round((lhr.categories?.seo?.score ?? 0) * 100);
      const audits   = lhr.audits || {};

      const good = [], bad = [];
      const order = Object.keys(AUDITS);

      order.forEach(id => {
        if (!audits[id]) return;
        const score = audits[id].score;
        if (score === null) return; // n/a
        if (score >= 0.9) good.push(AUDITS[id].good);
        else bad.push(AUDITS[id].bad);
      });

      // Fill to 4 if needed with generic fallbacks
      const goodFallbacks = ['HTTPS beveiligd: pagina laadt via een veilige verbinding', 'Pagina is bereikbaar voor zoekmachines', 'Basisstructuur van de pagina is correct', 'Geen blokkerende redirect-ketens gevonden'];
      const badFallbacks  = ['Paginasnelheid kan worden verbeterd voor betere rankings', 'Interne linkstructuur kan worden geoptimaliseerd', 'Content kan specifieker worden afgestemd op zoekintentie', 'GEO-optimalisatie voor AI-zoekmachines ontbreekt'];

      while (good.length < 4) good.push(goodFallbacks[good.length % goodFallbacks.length]);
      while (bad.length < 4)  bad.push(badFallbacks[bad.length % badFallbacks.length]);

      // GTM tracking
      try {
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ event: 'seo_scan_completed', scan_url: url, scan_name: name, scan_email: email, seo_score: seoScore });
      } catch(_) {}

      // Render
      const host = new URL(url).hostname.replace('www.', '');
      scoreSite.textContent = host;
      scoreLbl.textContent  = scoreLabel(seoScore);
renderList(goodList, good.slice(0, 4));
      renderList(badList, bad.slice(0, 4));
      showStep(stepRes);

    } catch (err) {
      clearInterval(ticker);
      errMsg.textContent = err.message === 'QUOTA'
        ? 'De scan service is tijdelijk niet beschikbaar (daglimiet bereikt). Probeer het later opnieuw of neem direct contact op.'
        : err.message?.includes('API')
          ? 'De scan kon niet worden uitgevoerd. Controleer of de URL bereikbaar is en probeer opnieuw.'
          : 'Er is iets misgegaan. Controleer de URL en probeer opnieuw.';
      showStep(stepErr);
    }
  }

  // Events
  document.querySelectorAll('[data-seoscan-open]').forEach(el => el.addEventListener('click', openModal));
  closeBtn?.addEventListener('click', closeModal);
  overlay?.addEventListener('click', e => { if (e.target === overlay) closeModal(); });
  document.addEventListener('keydown', e => { if (e.key === 'Escape' && overlay.classList.contains('is-open')) closeModal(); });

  retryBtn?.addEventListener('click', () => showStep(stepForm));

  upsellBtn?.addEventListener('click', () => {
    closeModal();
    document.querySelector('[data-overlay-open]')?.click();
  });

  form?.addEventListener('submit', async e => {
    e.preventDefault();
    const urlRaw   = document.getElementById('seoUrl').value;
    const name     = document.getElementById('seoName').value.trim();
    const email    = document.getElementById('seoEmail').value.trim();

    errorBox.hidden = true;

    if (!urlRaw || !name || !email) {
      errorBox.textContent = 'Vul alle velden in.';
      errorBox.hidden = false;
      return;
    }

    let url;
    try { url = normalizeUrl(urlRaw); new URL(url); }
    catch { errorBox.textContent = 'Voer een geldige URL in, bijv. https://jouwsite.nl'; errorBox.hidden = false; return; }

    await runScan(url, name, email);
  });
})();
</script>

<style>
  .seo-overlay {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 99998;
    align-items: center;
    justify-content: center;
    padding: 16px;
    background: rgba(58, 0, 29, 0.55);   /* ink scrim */
  }
  .seo-overlay.is-open { display: flex; animation: seo-fade 0.35s var(--pm-ease) both; }
  .seo-overlay.is-open .seo-modal { animation: seo-pop 0.7s var(--pm-ease) both; }
  @keyframes seo-fade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes seo-pop { from { opacity: 0; transform: translateY(32px) scale(0.96); } to { opacity: 1; transform: none; } }

  .seo-modal {
    width: 100%;
    max-width: 700px;
    max-height: calc(100dvh - 48px);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: clamp(1.5rem, 4vw, 2.75rem);
    color: var(--pm-ink);
  }

  .seo-close {
    position: absolute;
    top: 1.1rem;
    right: 1.1rem;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: var(--pm-border);
    border-radius: 50%;
    background: var(--pm-milk);
    color: var(--pm-ink);
    box-shadow: 0 3px 0 var(--pm-ink);
    cursor: pointer;
    transition: transform 0.4s var(--pm-ease), box-shadow 0.4s var(--pm-ease);
    z-index: 1;
  }
  .seo-close:active { transform: translateY(2px); box-shadow: 0 1px 0 var(--pm-ink); }

  .seo-step[hidden] { display: none; }
  #seoStepForm:not([hidden]) { display: grid; justify-items: start; gap: 0.9rem; }
  .seo-title { padding-right: 3rem; }
  .seo-intro { margin-bottom: 0.6rem; }

  /* form */
  .seo-form { display: grid; gap: 1rem; width: 100%; }
  .seo-field { display: grid; gap: 0.45rem; }
  .seo-field label {
    font-size: var(--pm-fs-label);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .seo-field input {
    width: 100%;
    box-sizing: border-box;
    padding: 0.85rem 1.1rem;
    border: var(--pm-border);
    border-radius: var(--pm-r-sm);
    background: var(--pm-milk);
    color: var(--pm-ink);
    font: inherit;
    font-size: 16px; /* min 16px voorkomt iOS auto-zoom */
    outline: none;
    transition: box-shadow 0.25s var(--pm-ease);
  }
  .seo-field input::placeholder { color: var(--pm-ink-mute); }
  .seo-field input:focus { background: #fff; box-shadow: 0 0 0 3px var(--pm-milk), 0 0 0 5px var(--pm-ink); }

  .seo-error {
    margin: 0;
    padding: 0.7rem 1rem;
    border: var(--pm-border);
    border-radius: var(--pm-r-sm);
    background: var(--pm-blush);
    font-size: 0.9rem;
    font-weight: 600;
  }
  .seo-error[hidden] { display: none; }
  .seo-submit { width: 100%; margin-top: 0.4rem; }

  /* loading */
  .seo-loader {
    display: grid;
    justify-items: center;
    gap: 1rem;
    padding: 3rem 0;
    text-align: center;
  }
  .seo-loader p { margin: 0; font-family: var(--pm-display); font-size: 1.6rem; line-height: 1.1; }
  .seo-loader small { color: var(--pm-ink-mute); font-weight: 600; word-break: break-all; }

  .seo-radar { position: relative; width: 96px; height: 96px; display: grid; place-items: center; }
  .seo-radar span {
    position: absolute;
    inset: 0;
    border: var(--pm-border);
    border-radius: 50%;
    background: var(--pm-pink);
    opacity: 0;
    animation: seo-radar 2s var(--pm-ease) infinite;
  }
  .seo-radar span:nth-child(2) { animation-delay: 0.6s; }
  .seo-radar span:nth-child(3) { animation-delay: 1.2s; }
  .seo-radar__core {
    position: relative;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border: var(--pm-border);
    border-radius: 50%;
    background: var(--pm-yellow);
    box-shadow: 0 4px 0 var(--pm-ink);
    font-style: normal;
  }
  @keyframes seo-radar {
    0% { transform: scale(0.4); opacity: 0.7; }
    100% { transform: scale(1); opacity: 0; }
  }

  /* results */
  .seo-results-header { display: grid; gap: 0.4rem; margin-bottom: 1.5rem; padding-right: 3rem; }
  .seo-results-title { overflow-wrap: anywhere; }

  .seo-columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-bottom: 1rem;
  }
  .seo-col {
    padding: 1.25rem;
    border: var(--pm-border);
    border-radius: var(--pm-r);
    background: var(--pm-paper);
  }
  .seo-col--bad { background: var(--pm-blush); }
  .seo-col__title {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin: 0 0 1rem;
    font-family: var(--pm-display);
    font-weight: 400;
    font-size: 1.4rem;
    line-height: 1.1;
  }
  .seo-list { font-size: 0.92rem; line-height: 1.45; }
  .seo-list--bad { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.85rem; }
  .seo-list--bad :global(li) {
    position: relative;
    padding-left: 2.1rem;
    color: var(--pm-ink-soft);
  }
  .seo-list--bad :global(li)::before {
    content: "!";
    position: absolute;
    left: 0;
    top: 0;
    display: grid;
    place-items: center;
    width: 1.3rem;
    height: 1.3rem;
    border: var(--pm-border);
    border-radius: 50%;
    background: var(--pm-red);
    color: var(--pm-milk);
    font-size: 0.75rem;
    font-weight: 900;
    line-height: 1;
  }
  .seo-more-note { margin: 1rem 0 0; font-size: 0.8rem; line-height: 1.5; color: var(--pm-ink-soft); }

  .seo-upsell {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 1.4rem;
    border: var(--pm-border);
    border-radius: var(--pm-r);
    background: var(--pm-plum);
    color: var(--pm-milk);
  }
  .seo-upsell p { flex: 1; min-width: 200px; margin: 0; font-size: 0.95rem; line-height: 1.5; }
  .seo-upsell strong { color: var(--pm-yellow); }

  /* error */
  .seo-error-state {
    display: grid;
    justify-items: center;
    gap: 0.85rem;
    padding: 2.5rem 0 1rem;
    text-align: center;
  }
  .seo-error-state p { max-width: 38ch; }
  .seo-error-state__icon { width: 72px; height: 72px; border-radius: 22px; }
  .seo-error-state__icon :global(svg) { width: 34px; height: 34px; }

  @media (hover: hover) {
    .seo-close:hover { transform: translateY(-2px) rotate(90deg); box-shadow: 0 5px 0 var(--pm-ink); }
  }

  @media (max-width: 600px) {
    .seo-columns { grid-template-columns: 1fr; }
    .seo-upsell { flex-direction: column; align-items: stretch; }
    .seo-upsell-btn { width: 100%; white-space: normal; }
  }

  @media (prefers-reduced-motion: reduce) {
    .seo-overlay.is-open, .seo-overlay.is-open .seo-modal { animation: none; }
    .seo-radar span { animation: none; opacity: 0.25; }
    .seo-close { transition: none; }
  }
</style>
