---
// Cream, card-based gallery: a native horizontal scroller with scroll-snap.
// Prev/next buttons simply scroll by one card; no auto-rotation.
import Icon from "./pm/Icon.astro";

interface Slide {
  src: string;
  alt: string;
  title?: string;
  desc?: string;
}

interface Props {
  slides: Slide[];
}

const { slides } = Astro.props;
const tones = ["", "cs__card--pink", "cs__card--yellow"];
---

<div class="cs" data-case-slider>
  <ol class="cs__track" tabindex="0" aria-label="Galerij met schermafbeeldingen" data-cs-track>
    {slides.map((slide, i) => (
      <li class:list={["pm-card", "cs__card", tones[i % tones.length]]} data-reveal style={`--d: ${i}`}>
        <span class="pm-media cs__media">
          <img src={slide.src} alt={slide.alt} loading="lazy" decoding="async" />
        </span>
        {(slide.title || slide.desc) && (
          <span class="cs__body">
            <span class="cs__index" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
            {slide.title && <strong class="cs__title">{slide.title}</strong>}
            {slide.desc && <span class="cs__desc">{slide.desc}</span>}
          </span>
        )}
      </li>
    ))}
  </ol>

  <div class="pm-container cs__nav">
    <button type="button" class="cs__btn cs__btn--prev" aria-label="Vorige afbeelding" data-cs-prev>
      <Icon name="arrow" size={20} stroke={2.4} />
    </button>
    <button type="button" class="cs__btn" aria-label="Volgende afbeelding" data-cs-next>
      <Icon name="arrow" size={20} stroke={2.4} />
    </button>
  </div>
</div>

<script>
  function initCaseSliders() {
    document.querySelectorAll<HTMLElement>("[data-case-slider]").forEach((root) => {
      if (root.dataset.ready) return;
      root.dataset.ready = "true";
      const track = root.querySelector<HTMLElement>("[data-cs-track]");
      const prev = root.querySelector<HTMLButtonElement>("[data-cs-prev]");
      const next = root.querySelector<HTMLButtonElement>("[data-cs-next]");
      if (!track || !prev || !next) return;

      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const step = () => {
        const card = track.querySelector<HTMLElement>(".cs__card");
        const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
        return card ? card.offsetWidth + gap : track.clientWidth * 0.8;
      };
      const update = () => {
        const max = track.scrollWidth - track.clientWidth - 2;
        prev.disabled = track.scrollLeft <= 2;
        next.disabled = track.scrollLeft >= max;
      };

      prev.addEventListener("click", () => track.scrollBy({ left: -step(), behavior: reduce ? "auto" : "smooth" }));
      next.addEventListener("click", () => track.scrollBy({ left: step(), behavior: reduce ? "auto" : "smooth" }));
      track.addEventListener("scroll", update, { passive: true });
      window.addEventListener("resize", update);
      update();
    });
  }

  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", initCaseSliders);
  else initCaseSliders();
</script>

<style>
  .cs { --cs-inset: max(var(--pm-gutter), calc((100vw - var(--pm-max)) / 2)); }

  .cs__track {
    list-style: none;
    margin: 0;
    padding: 0.5rem var(--cs-inset) 1.75rem;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(78vw, 520px);
    gap: clamp(1rem, 2vw, 1.5rem);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--cs-inset);
    scrollbar-width: none;
  }
  .cs__track::-webkit-scrollbar { display: none; }
  .cs__track:focus-visible { outline-offset: -3px; }

  .cs__card {
    scroll-snap-align: start;
    display: grid;
    grid-template-rows: auto 1fr;
    box-shadow: var(--pm-drop);
    background: var(--pm-milk);
  }
  .cs__card--pink .cs__body { background: var(--pm-blush); }
  .cs__card--yellow .cs__body { background: var(--pm-yellow); }

  .cs__media {
    aspect-ratio: 4 / 3;
    border-bottom: var(--pm-border);
    background: var(--pm-paper);
  }
  .cs__media img { object-fit: contain; object-position: top center; }

  .cs__body {
    display: grid;
    gap: 0.4rem;
    align-content: start;
    padding: 1.4rem 1.5rem 1.6rem;
    background: var(--pm-milk);
  }
  .cs__index { font-size: var(--pm-fs-label); font-weight: 700; letter-spacing: 0.08em; color: var(--pm-red); }
  .cs__title {
    font-family: var(--pm-display);
    font-weight: 400;
    font-size: var(--pm-fs-h3);
    line-height: 1.1;
    letter-spacing: 0.01em;
  }
  .cs__desc { color: var(--pm-ink-soft); line-height: 1.5; }

  .cs__nav { display: flex; justify-content: flex-end; gap: 0.75rem; }
  .cs__btn {
    display: inline-grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border: var(--pm-border);
    border-radius: 50%;
    background: var(--pm-yellow);
    color: var(--pm-ink);
    box-shadow: 0 4px 0 var(--pm-ink);
    cursor: pointer;
    transition: transform 0.4s var(--pm-ease), box-shadow 0.4s var(--pm-ease), opacity 0.25s ease;
  }
  .cs__btn--prev :global(svg) { transform: rotate(180deg); }
  .cs__btn:disabled { opacity: 0.4; cursor: default; }
  @media (hover: hover) {
    .cs__btn:not(:disabled):hover { transform: translateY(-2px); box-shadow: 0 6px 0 var(--pm-ink); }
  }
  .cs__btn:not(:disabled):active { transform: translateY(3px); box-shadow: 0 1px 0 var(--pm-ink); }

  @media (max-width: 640px) {
    .cs__track { grid-auto-columns: 84vw; }
    .cs__nav { justify-content: center; }
  }
  @media (prefers-reduced-motion: reduce) {
    .cs__btn { transition: none; }
  }
</style>
