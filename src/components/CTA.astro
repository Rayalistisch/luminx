---
import Logo from "./pm/Logo.astro";
import Icon from "./pm/Icon.astro";
---

<section class="pm-band cta" id="contact" aria-labelledby="cta-title">
  <div class="pm-container cta__inner">
    <Logo class="cta__mark" aria-hidden="true" data-reveal />
    <h2 id="cta-title" class="pm-h2 pm-outline cta__title" data-reveal style="--d: 1">Laten we bouwen.</h2>
    <p class="pm-opening cta__text" data-reveal style="--d: 2">
      Heb je een project in gedachten? We horen graag van je en reageren binnen 24 uur.
    </p>

    <div class="cta__actions" data-reveal style="--d: 3">
      <a href="#" class="pm-btn pm-btn--yellow" data-overlay-open>Stuur een bericht <Icon name="arrow" /></a>
      <div id="cta-calendar-button-slot" class="cta__calendar"></div>
    </div>

    <ul class="cta__contact" data-reveal style="--d: 4">
      <li><a href="mailto:hello@luminx.nl"><Icon name="mail" size={20} /> hello@luminx.nl</a></li>
      <li><a href="tel:+31613698596"><Icon name="phone" size={20} /> +31 6 1369 8596</a></li>
    </ul>
  </div>
</section>

<script is:inline>
  (function () {
    var calendarUrl = "https://calendar.google.com/calendar/appointments/schedules/AcZssZ0KnPaRiH37bvNSB0ta7HrOtyHk8wT8EUaAMULRWJcV8kywKhl-TEVeRu1YsOLCFd3vzfBt6dve?gv=true";
    var tries = 0;
    function initCtaCalendarButton() {
      var slot = document.getElementById("cta-calendar-button-slot");
      if (!slot || slot.dataset.initialized === "true") return;
      if (!window.calendar || !window.calendar.schedulingButton) return;
      window.calendar.schedulingButton.load({
        url: calendarUrl,
        color: "#FFFAF0",
        label: "Plan een videocall",
        target: slot,
      });
      slot.dataset.initialized = "true";
      slot.classList.add("is-ready");
    }
    function initWithRetry() {
      var timer = window.setInterval(function () {
        tries += 1;
        initCtaCalendarButton();
        var slot = document.getElementById("cta-calendar-button-slot");
        if ((slot && slot.dataset.initialized === "true") || tries >= 40) {
          window.clearInterval(timer);
        }
      }, 100);
    }
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initWithRetry);
    } else {
      initWithRetry();
    }
  })();
</script>

<style>
  .cta {
    padding: clamp(6rem, 12vw, 9rem) 0 clamp(2rem, 4vw, 3rem);
    margin-bottom: -1px;          /* no hairline seam into the red footer */
    position: relative;
    z-index: 1;
  }
  .cta__calendar:empty { display: none; }

  .cta__inner {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 1.5rem;
  }

  .cta__mark { font-size: clamp(1.75rem, 3vw, 2.25rem); }
  .cta__title { font-size: clamp(3rem, 7vw, 5.5rem); }
  .cta__text { max-width: 560px; color: var(--pm-ink); }

  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: 0.75rem;
  }

  /* restyle Google's scheduling button into a white pm-btn */
  .cta__actions :global(button) {
    min-height: 56px !important;
    padding: 0 1.75rem !important;
    border: 2px solid var(--pm-ink) !important;
    border-radius: 9999px !important;
    background: var(--pm-milk) !important;
    color: var(--pm-ink) !important;
    box-shadow: 0 6px 0 var(--pm-ink) !important;
    font-family: var(--pm-body) !important;
    font-size: 0.875rem !important;
    font-weight: 800 !important;
    letter-spacing: 0.08em !important;
    text-transform: uppercase !important;
    cursor: pointer;
    transition: transform 0.4s var(--pm-ease), box-shadow 0.4s var(--pm-ease) !important;
  }
  @media (hover: hover) {
    .cta__actions :global(button:hover) { transform: translateY(-3px); box-shadow: 0 9px 0 var(--pm-ink) !important; }
  }

  .cta__contact {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 2rem;
  }
  .cta__contact a {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--pm-milk);
    font-weight: 700;
    text-decoration: none;
  }
  @media (hover: hover) { .cta__contact a:hover { color: var(--pm-ink); } }

  @media (max-width: 560px) {
    .cta__actions { flex-direction: column; align-self: stretch; }
    .cta__actions .pm-btn { width: 100%; }
  }
</style>
