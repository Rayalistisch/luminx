---
import Icon from "./pm/Icon.astro";
---

<div id="contact-overlay" class="co" role="dialog" aria-modal="true" aria-labelledby="co-title">
  <div class="co__inner pm-container">
    <button type="button" class="co__close" data-overlay-close aria-label="Sluiten">
      <Icon name="x" size={22} stroke={2.5} />
    </button>

    <div class="co__grid">
      <div class="co__info">
        <span class="pm-label">Contact</span>
        <h2 id="co-title" class="pm-h1 co__title">Laten we praten</h2>
        <p class="pm-opening co__desc">Benieuwd wat ik voor je kan betekenen? <br />Praten is altijd gratis!</p>

        <ul class="co__details">
          <li>
            <a href="mailto:hello@luminx.nl" class="co__detail">
              <span class="pm-icon pm-icon--sm pm-icon--yellow"><Icon name="mail" /></span>
              <span>hello@luminx.nl</span>
            </a>
          </li>
          <li>
            <a href="tel:+31613698596" class="co__detail">
              <span class="pm-icon pm-icon--sm pm-icon--pink"><Icon name="phone" /></span>
              <span>+31 6 1369 8596</span>
            </a>
          </li>
          <li class="co__cal">
            <span class="pm-icon pm-icon--sm pm-icon--wine" aria-hidden="true"><Icon name="calendar" /></span>
            <div id="overlay-calendar-button-slot"></div>
          </li>
        </ul>
      </div>

      <div class="pm-card pm-card--lift pm-card--milk co__card">
        <form
          class="co__form"
          id="contact-form"
          method="POST"
          action="https://api.web3forms.com/submit"
        >
          <input type="hidden" name="access_key" value="fc8f918e-1c5c-44a4-acde-948f7f99eeae" />
          <input type="hidden" name="subject" value="Nieuw contactverzoek via luminx.nl" />
          <input type="hidden" name="from_name" value="luminx.nl" />
          <input type="text" name="botcheck" tabindex="-1" autocomplete="off" class="co__honeypot" aria-hidden="true" />
          <div class="co__field">
            <label for="contact-name">Naam</label>
            <input type="text" id="contact-name" name="name" required autocomplete="name" placeholder="Je naam" />
          </div>
          <div class="co__field">
            <label for="contact-email">Email</label>
            <input type="email" id="contact-email" name="email" required autocomplete="email" placeholder="naam@voorbeeld.nl" />
          </div>
          <div class="co__field">
            <label for="contact-message">Bericht</label>
            <textarea id="contact-message" name="message" rows="4" required placeholder="Vertel ons over je project..."></textarea>
          </div>
          <button type="submit" class="pm-btn pm-btn--yellow co__submit">
            <span class="form-submit-text">Verstuur Bericht</span>
            <Icon name="arrow" />
          </button>
        </form>
        <p class="co__error" id="form-error" role="alert">
          Er ging iets mis bij het verzenden. Probeer het opnieuw of mail naar hello@luminx.nl.
        </p>
        <div class="co__success" id="form-success">
          <span class="pm-icon pm-icon--yellow co__success-icon" aria-hidden="true"><Icon name="check" /></span>
          <h3 class="pm-h2">Bedankt!</h3>
          <p class="pm-text">We nemen zo snel mogelijk contact met je op.</p>
        </div>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    var calendarUrl = "https://calendar.google.com/calendar/appointments/schedules/AcZssZ0KnPaRiH37bvNSB0ta7HrOtyHk8wT8EUaAMULRWJcV8kywKhl-TEVeRu1YsOLCFd3vzfBt6dve?gv=true";
    var tries = 0;

    function closeOverlay() {
      var overlay = document.getElementById("contact-overlay");
      if (!overlay) return;
      overlay.classList.remove("is-open");
      document.body.style.overflow = "";
    }

    // Watch for Google's popup iframe and boost its z-index above the overlay
    var observer = new MutationObserver(function (mutations) {
      mutations.forEach(function (m) {
        m.addedNodes.forEach(function (node) {
          if (node.nodeType !== 1) return;
          // Google scheduling popup: iframe or container with iframe
          var iframe = node.tagName === "IFRAME" ? node : node.querySelector && node.querySelector("iframe");
          if (iframe && iframe.src && iframe.src.indexOf("calendar.google.com") !== -1) {
            var target = iframe.parentElement && iframe.parentElement !== document.body ? iframe.parentElement : iframe;
            target.style.setProperty("z-index", "99999999", "important");
          }
        });
      });
    });
    observer.observe(document.body, { childList: true, subtree: true });

    function initSchedulingButton() {
      var slot = document.getElementById("overlay-calendar-button-slot");
      if (!slot || slot.dataset.initialized === "true") return;
      if (!window.calendar || !window.calendar.schedulingButton) return;

      window.calendar.schedulingButton.load({
        url: calendarUrl,
        color: "#9A1436",
        label: "Plan een videocall",
        target: slot,
      });

      slot.dataset.initialized = "true";
      slot.classList.add("is-ready");

      // Close overlay when the Google button is clicked
      slot.addEventListener("click", function () {
        closeOverlay();
      }, true);
    }

    function initWithRetry() {
      var timer = window.setInterval(function () {
        tries += 1;
        initSchedulingButton();
        var slot = document.getElementById("overlay-calendar-button-slot");
        if ((slot && slot.dataset.initialized === "true") || tries >= 40) {
          window.clearInterval(timer);
        }
      }, 100);
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initWithRetry);
    } else {
      initWithRetry();
    }

  })();
</script>
<style>
  .co {
    position: fixed;
    inset: 0;
    z-index: 9999999;
    background: var(--pm-cream);
    color: var(--pm-ink);
    overflow-y: auto;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.45s var(--pm-ease), visibility 0s linear 0.45s;
  }
  .co.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition: opacity 0.45s var(--pm-ease), visibility 0s;
  }

  .co__inner {
    position: relative;
    min-height: 100%;
    display: grid;
    align-items: center;
    padding-block: clamp(5.5rem, 9vh, 7rem) clamp(2.5rem, 6vh, 4rem);
  }

  .co__close {
    position: absolute;
    top: clamp(1rem, 3vh, 2rem);
    right: var(--pm-gutter);
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    padding: 0;
    border: var(--pm-border);
    border-radius: 50%;
    background: var(--pm-milk);
    color: var(--pm-ink);
    box-shadow: 0 4px 0 var(--pm-ink);
    cursor: pointer;
    transition: transform 0.4s var(--pm-ease), box-shadow 0.4s var(--pm-ease);
  }
  .co__close:active { transform: translateY(3px); box-shadow: 0 1px 0 var(--pm-ink); }

  .co__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }

  /* entrance: info slides up, card scales in */
  .co__info, .co__card {
    transition: transform 0.8s var(--pm-ease), opacity 0.6s var(--pm-ease);
  }
  .co:not(.is-open) .co__info { transform: translateY(32px); opacity: 0; }
  .co:not(.is-open) .co__card { transform: translateY(40px) scale(0.96); opacity: 0; }
  .co.is-open .co__card { transition-delay: 0.08s; }

  .co__info { display: grid; gap: 1.25rem; justify-items: start; }
  .co__title { font-size: clamp(2.6rem, 6.5vw, 5.75rem); overflow-wrap: break-word; }
  .co__grid > * { min-width: 0; }
  .co__desc { max-width: 440px; }

  .co__details {
    list-style: none;
    margin: 0.75rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.9rem;
  }
  .co__detail, .co__cal {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    color: var(--pm-ink);
    font-weight: 700;
    font-size: 1.0625rem;
    text-decoration: none;
  }
  .co__detail > span:last-child {
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
    transition: text-decoration-color 0.25s ease;
  }

  #overlay-calendar-button-slot { min-height: 28px; display: flex; align-items: center; }
  #overlay-calendar-button-slot.is-ready { min-height: 0; }
  #overlay-calendar-button-slot :global(:is(button, a)) {
    display: inline-flex !important;
    align-items: center;
    min-height: 0 !important;
    padding: 0 !important;
    margin: 0 !important;
    background: transparent !important;
    border: 0 !important;
    border-radius: 0 !important;
    box-shadow: none !important;
    color: var(--pm-ink) !important;
    font-family: var(--pm-body) !important;
    font-size: 1.0625rem !important;
    font-weight: 700 !important;
    letter-spacing: 0 !important;
    text-transform: none !important;
    text-decoration: underline !important;
    text-decoration-color: transparent !important;
    text-decoration-thickness: 2px !important;
    text-underline-offset: 4px;
    line-height: 1.3;
    cursor: pointer;
    transition: text-decoration-color 0.25s ease;
  }

  /* form card */
  .co__card { padding: clamp(1.5rem, 3vw, 2.5rem); }
  .co__form { display: grid; gap: 1.1rem; }
  .co__honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }
  .co__field { display: grid; gap: 0.45rem; }
  .co__field label {
    font-size: var(--pm-fs-label);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--pm-ink);
  }
  .co__field input, .co__field textarea {
    width: 100%;
    box-sizing: border-box;
    padding: 0.9rem 1.1rem;
    border: var(--pm-border);
    border-radius: var(--pm-r-sm);
    background: var(--pm-milk);
    color: var(--pm-ink);
    font: inherit;
    font-size: 16px;
    font-weight: 500;
    outline: none;
    transition: box-shadow 0.25s var(--pm-ease), background-color 0.25s ease;
  }
  .co__field textarea { resize: vertical; min-height: 120px; line-height: 1.5; }
  .co__field input::placeholder, .co__field textarea::placeholder { color: var(--pm-ink-mute); }
  .co__field input:focus, .co__field input:focus-visible,
  .co__field textarea:focus, .co__field textarea:focus-visible {
    outline: none;
    background: #fff;
    box-shadow: 0 0 0 3px var(--pm-milk), 0 0 0 5px var(--pm-ink);
  }

  .co__submit { justify-self: start; margin-top: 0.4rem; }
  .co__submit:disabled { opacity: 0.6; cursor: wait; }

  .co__error {
    display: none;
    margin: 1rem 0 0;
    padding: 0.85rem 1rem;
    border: var(--pm-border);
    border-radius: var(--pm-r-sm);
    background: var(--pm-blush);
    color: var(--pm-ink);
    font-size: 0.95rem;
    font-weight: 600;
  }
  .co__error.is-visible { display: block; }

  .co__success {
    display: none;
    text-align: center;
    padding: clamp(2rem, 5vw, 3.5rem) 0;
    justify-items: center;
    gap: 1rem;
  }
  .co__success.is-visible { display: grid; }
  .co__success-icon { width: 72px; height: 72px; border-radius: 22px; }
  .co__success-icon :global(svg) { width: 34px; height: 34px; }

  @media (hover: hover) {
    .co__close:hover { transform: translateY(-2px) rotate(90deg); box-shadow: 0 6px 0 var(--pm-ink); }
    .co__detail:hover > span:last-child,
    #overlay-calendar-button-slot :global(:is(button, a):hover) { text-decoration-color: var(--pm-red) !important; }
  }

  @media (max-width: 860px) {
    .co__inner { align-items: start; padding-top: 5.5rem; }
    .co__grid { grid-template-columns: 1fr; gap: 2.25rem; }
    .co__submit { justify-self: stretch; }
  }

  @media (prefers-reduced-motion: reduce) {
    .co, .co.is-open, .co__info, .co__card, .co__close { transition: none; }
    .co:not(.is-open) .co__info, .co:not(.is-open) .co__card { transform: none; }
  }
</style>
