  html:has(.lx-world):not(.lx-no3d), html:has(.lx-world):not(.lx-no3d) body { overflow: hidden; height: 100%; }

  /* keep the floating widgets out of the info panel's way */
  html.lx-focused .wa-widget { opacity: 0; pointer-events: none; transition: opacity 0.3s ease; }

  /* without WebGL the places become a plain, readable page */
  html.lx-no3d .lx-stage, html.lx-no3d .lx-controls, html.lx-no3d .lx-panel__bar { display: none !important; }
</style>

