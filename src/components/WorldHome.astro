---
import { Image } from "astro:assets";
import founderImage from "../assets/images/luminx-founder.png";
import Icon from "./pm/Icon.astro";
import World from "./world/World";
import { PROJECTS, MARKETING, TECH, BELIEFS, STATS, PLACES } from "./world/content";

const total = PLACES.length;
const indexOf = (id: string) => PLACES.findIndex((p) => p.id === id) + 1;
---

<script is:inline>document.documentElement.classList.add("lx-js");</script>

<div class="lx-loader" data-world-loader aria-hidden="true">
  <div class="lx-loader__inner">
    <span class="lx-loader__sun"></span>
    <span class="lx-loader__title">LuminX</span>
    <span class="lx-loader__sub">Twente wordt opgewarmd</span>
    <span class="lx-loader__bar"><span></span></span>
  </div>
</div>

<section class="lx-world" data-world aria-label="Lichtland Twente: verken ons werk in 3D">
  <div class="lx-stage" aria-hidden="true">
    <World client:only="react" />
  </div>
  <div class="lx-tip" data-tip aria-hidden="true">
    <strong></strong>
    <span data-tip-sub></span>
    <em>Klik om te openen</em>
  </div>

  <!-- a quiet hint that disappears once you start exploring -->
  <p class="lx-hint" data-hint aria-hidden="true">
    <span class="lx-hint__dot"></span>
    <span class="lx-hint--mouse">Sleep om rond te kijken · klik op een gebouw</span>
    <span class="lx-hint--touch">Veeg om rond te kijken · tik op een gebouw</span>
  </p>
  <h1 class="lx-caption">LuminX · Online marketing bureau in Enschede, Twente</h1>

  <!-- menu: the land, and the sheets that open beside it -->
  <nav class="lx-menu" aria-label="Hoofdmenu">
    <button type="button" class="lx-menu__item is-active" data-sheet-open="land" aria-current="true">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/></svg>
      Het land
    </button>
    <button type="button" class="lx-menu__item" data-sheet-open="diensten">Diensten</button>
    <button type="button" class="lx-menu__item" data-sheet-open="werk">Werk</button>
    <button type="button" class="lx-menu__item" data-sheet-open="over">Over</button>
    <button type="button" class="lx-menu__item" data-sheet-open="contact">Contact</button>
  </nav>

  <!-- controls -->
  <div class="lx-controls" role="toolbar" aria-label="Wereld bedienen">
    <button type="button" class="lx-ctrl lx-ctrl--tour" data-tour>
      <Icon name="play" size={16} /> <span>Rondleiding</span>
    </button>
    <button type="button" class="lx-ctrl lx-ctrl--dusk" data-dusk aria-pressed="false">
      <span class="lx-ctrl__bulb" aria-hidden="true"></span> <span data-dusk-label>Lichten aan</span>
    </button>
    <div class="lx-ctrl-zoom">
      <button type="button" class="lx-ctrl lx-ctrl--icon" data-zoom="1" aria-label="Inzoomen"><Icon name="plus" size={18} stroke={2.4} /></button>
      <button type="button" class="lx-ctrl lx-ctrl--icon" data-zoom="-1" aria-label="Uitzoomen"><span class="lx-minus" aria-hidden="true"></span></button>
    </div>
  </div>

  <!-- info panel: every place's content lives here as real HTML -->
  <aside class="lx-panel" data-panel aria-label="Informatie over deze plek">
    <div class="lx-panel__bar">
      <button type="button" class="lx-panel__nav" data-prev aria-label="Vorige plek"><Icon name="arrow" size={16} stroke={2.4} /></button>
      <span class="lx-panel__count" data-count>1 / {total}</span>
      <button type="button" class="lx-panel__nav" data-next aria-label="Volgende plek"><Icon name="arrow" size={16} stroke={2.4} /></button>
      <button type="button" class="lx-panel__close" data-close aria-label="Terug naar overzicht"><Icon name="x" size={18} stroke={2.4} /></button>
    </div>

    <div class="lx-panel__scroll" data-panel-scroll data-lenis-prevent>
      <!-- molen -->
      <article class="lx-place" data-place="marketing" aria-labelledby="pl-marketing">
        <header class="lx-place__head lx-place__head--pink">
          <span class="pm-icon pm-icon--wine"><Icon name="megaphone" /></span>
          <div>
            <p class="lx-kicker">De molen · vangt de wind</p>
            <h2 id="pl-marketing" class="lx-place__title">Online marketing</h2>
          </div>
        </header>
        <div class="lx-place__body">
          <p class="lx-lead">Gevonden worden, geklikt worden, gekozen worden. Zoals de molen de wind vangt, vangen wij aandacht en zetten die om in klanten.</p>
          <ul class="lx-list">
            {MARKETING.map((it) => (
              <li><a href={it.href}><span><strong>{it.title}</strong><span>{it.desc}</span></span><span class="lx-list__arrow" aria-hidden="true"><Icon name="arrow" size={16} stroke={2.4} /></span></a></li>
            ))}
          </ul>
          <p class="pm-tag pm-tag--paper lx-badge"><Icon name="trending-up" size={16} /> Gem. 3× meer organisch verkeer</p>
        </div>
      </article>

      <!-- fabriek -->
      <article class="lx-place" data-place="techniek" aria-labelledby="pl-techniek">
        <header class="lx-place__head lx-place__head--yellow">
          <span class="pm-icon pm-icon--milk"><Icon name="code" /></span>
          <div>
            <p class="lx-kicker">De textielfabriek · draait door</p>
            <h2 id="pl-techniek" class="lx-place__title">Techniek &amp; automatisering</h2>
          </div>
        </header>
        <div class="lx-place__body">
          <p class="lx-lead">Het fundament onder alles wat je online doet. Twente bouwde ooit fabrieken die dag en nacht draaiden; wij bouwen systemen die dat voor jou doen.</p>
          <ul class="lx-list">
            {TECH.map((it) => (
              <li><a href={it.href}><span><strong>{it.title}</strong><span>{it.desc}</span></span><span class="lx-list__arrow" aria-hidden="true"><Icon name="arrow" size={16} stroke={2.4} /></span></a></li>
            ))}
          </ul>
          <p class="pm-tag pm-tag--paper lx-badge"><Icon name="trending-up" size={16} /> 0 dagen downtime bij migraties</p>
        </div>
      </article>

      <!-- erven: projecten -->
      {PROJECTS.map((p, i) => (
        <article class="lx-place" data-place={p.id} aria-labelledby={`pl-${p.id}`}>
          <figure class="lx-place__media"><img src={p.image} alt={`Project ${p.title}`} loading="lazy" decoding="async" /></figure>
          <div class="lx-place__body">
            <p class="lx-kicker">Geselecteerd werk · erf {i + 1} van {PROJECTS.length}</p>
            <h2 id={`pl-${p.id}`} class="lx-place__title">{p.title}</h2>
            <p class="lx-result"><Icon name="trending-up" size={20} /> {p.result}</p>
            <p class="lx-lead">{p.description}</p>
            <span class="pm-tag lx-tag">{p.tag}</span>
            {p.id === "gsm-team" && (
              <blockquote class="lx-quote">
                <p>“Ray heeft onze webshop volledig gemigreerd naar Shopify zonder één dag downtime. De laadtijd ging met 40% omlaag en onze conversie steeg direct mee.”</p>
                <footer><strong>Barry</strong> · GSM Team</footer>
              </blockquote>
            )}
            <a class="pm-btn pm-btn--sm lx-place__cta" href={p.href}>Bekijk de case <Icon name="arrow" size={16} stroke={2.4} /></a>
          </div>
        </article>
      ))}

      <!-- thuis: over + contact -->
      <article class="lx-place" data-place="luminx" aria-labelledby="pl-luminx">
        <div class="lx-place__body">
          <p class="lx-kicker">Het erf van LuminX · Enschede</p>
          <h2 id="pl-luminx" class="lx-place__title">Groei is geen verzameling losse trucjes.</h2>
          <p class="lx-lead">De meeste MKB'ers betalen voor kanalen die niet met elkaar praten. Wij bouwen er één systeem van, zoals al die lichtjes samen één pad naar huis vormen.</p>
          <ul class="lx-beliefs">
            {BELIEFS.map((b) => (
              <li><strong>{b.title}</strong><span>{b.body}</span></li>
            ))}
          </ul>
          <dl class="lx-stats">
            {STATS.map((s) => (
              <div><dt>{s.label}</dt><dd>{s.value}</dd></div>
            ))}
          </dl>
          <div class="lx-founder">
            <Image src={founderImage} alt="Ray Huffenreuter, oprichter van LuminX" widths={[96, 160]} sizes="56px" loading="lazy" class="lx-founder__img" />
            <p><strong>Ray Huffenreuter</strong><span>Oprichter en jouw vaste aanspreekpunt. Reactie binnen 24 uur.</span></p>
          </div>
          <div class="lx-actions">
            <a href="#" class="pm-btn pm-btn--sm" data-overlay-open>Stuur een bericht <Icon name="arrow" size={16} stroke={2.4} /></a>
            <a href="/videocall" class="pm-btn pm-btn--sm pm-btn--white">Plan een videocall</a>
          </div>
          <p class="lx-contact">
            <a href="mailto:hello@luminx.nl"><Icon name="mail" size={16} /> hello@luminx.nl</a>
            <a href="tel:+31613698596"><Icon name="phone" size={16} /> +31 6 1369 8596</a>
          </p>
          <nav class="lx-legal" aria-label="Meer van LuminX">
            <a href="/over">Meer over LuminX</a>
            <a href="/blog">Blog</a>
            <a href="/privacy">Privacy</a>
            <a href="/algemene-voorwaarden">Voorwaarden</a>
          </nav>
        </div>
      </article>
    </div>
  </aside>

  <!-- menu sheets: real content, opened beside the land -->
  <aside class="lx-sheet" data-sheet aria-label="LuminX">
    <button type="button" class="lx-sheet__close" data-sheet-close aria-label="Sluiten"><Icon name="x" size={18} stroke={2.4} /></button>
    <div class="lx-sheet__scroll" data-sheet-scroll data-lenis-prevent>

      <!-- Over -->
      <section class="lx-sec" data-sec="over" id="over" aria-labelledby="sec-over">
        <header class="lx-sec__hero lx-sec__hero--photo">
          <Image src={founderImage} alt="Ray Huffenreuter, oprichter van LuminX" widths={[640, 960]} sizes="(max-width: 820px) 100vw, 620px" class="lx-sec__photo" />
          <div class="lx-sec__herotext">
            <p class="lx-sec__kicker">Hoi, ik ben Ray.</p>
            <h2 id="sec-over" class="lx-sec__title">5+ jaar online groei voor het MKB in Twente. <em>Van losse signalen naar één pad dat omzet oplevert.</em></h2>
            <a href="#" class="lx-sec__cta" data-overlay-open>Een idee of een vraag? Vraag het Ray.</a>
          </div>
        </header>
        <div class="lx-sec__body">
          <p class="lx-sec__lead">Eén aanspreekpunt, alle disciplines. <span>Van website tot ads en automatisering, onder één dak.</span></p>
          <p class="lx-sec__sub">En ja, Twentse nuchterheid zit er gratis bij.</p>
          <div class="lx-cards">
            <div class="lx-cardlet"><Icon name="message" size={20} /><strong>Je praat direct met Ray.</strong><span>Geen accountmanager ertussen. Jij briefed Ray, Ray bouwt het.</span></div>
            <div class="lx-cardlet"><Icon name="arrow" size={20} /><strong>Geen overdrachten.</strong><span>Eén hoofd, van eerste idee tot live en gemeten.</span></div>
            <div class="lx-cardlet"><Icon name="clock" size={20} /><strong>Snel live.</strong><span>Weken in plaats van maanden, zonder in te leveren op kwaliteit.</span></div>
            <div class="lx-cardlet"><Icon name="chart" size={20} /><strong>Meetbaar.</strong><span>Betrouwbare tracking, zodat je ziet wat elke euro oplevert.</span></div>
          </div>
          <ul class="lx-beliefs">
            {BELIEFS.map((b) => (<li><strong>{b.title}</strong><span>{b.body}</span></li>))}
          </ul>
          <dl class="lx-stats">
            {STATS.map((st) => (<div><dt>{st.label}</dt><dd>{st.value}</dd></div>))}
          </dl>
          <a href="/over" class="lx-sec__more">Lees meer over LuminX <Icon name="arrow" size={16} stroke={2.4} /></a>
        </div>
      </section>

      <!-- Diensten -->
      <section class="lx-sec" data-sec="diensten" id="diensten" aria-labelledby="sec-diensten">
        <header class="lx-sec__hero lx-sec__hero--pink">
          <p class="lx-sec__kicker">Diensten · de Oude Markt, Enschede</p>
          <h2 id="sec-diensten" class="lx-sec__title">Alles wat groei nodig heeft. <em>Elk winkeltje rond het ijs is een dienst.</em></h2>
        </header>
        <div class="lx-sec__body">
          <h3 class="lx-sec__h3"><span class="lx-dot lx-dot--pink"></span>Online marketing</h3>
          <div class="lx-cards">
            {MARKETING.map((it) => (<a class="lx-cardlet lx-cardlet--link" href={it.href}><strong>{it.title}</strong><span>{it.desc}</span><Icon name="arrow" size={16} stroke={2.4} /></a>))}
          </div>
          <h3 class="lx-sec__h3"><span class="lx-dot lx-dot--yellow"></span>Techniek &amp; automatisering</h3>
          <div class="lx-cards">
            {TECH.map((it) => (<a class="lx-cardlet lx-cardlet--link" href={it.href}><strong>{it.title}</strong><span>{it.desc}</span><Icon name="arrow" size={16} stroke={2.4} /></a>))}
          </div>
        </div>
      </section>

      <!-- Werk -->
      <section class="lx-sec" data-sec="werk" id="werk" aria-labelledby="sec-werk">
        <header class="lx-sec__hero lx-sec__hero--yellow">
          <p class="lx-sec__kicker">Geselecteerd werk</p>
          <h2 id="sec-werk" class="lx-sec__title">Bewijs, geen beloftes. <em>Elk erf in het land is een echte klant.</em></h2>
        </header>
        <div class="lx-sec__body">
          <div class="lx-works">
            {PROJECTS.map((p) => (
              <a class="lx-work" href={p.href}>
                <span class="lx-work__media"><img src={p.image} alt={`Project ${p.title}`} loading="lazy" decoding="async" /></span>
                <span class="lx-work__body">
                  <span class="pm-tag lx-work__tag">{p.tag}</span>
                  <strong>{p.title}</strong>
                  <span class="lx-work__result"><Icon name="trending-up" size={16} /> {p.result}</span>
                </span>
              </a>
            ))}
          </div>
          <blockquote class="lx-quote">
            <p>“Ray heeft onze webshop volledig gemigreerd naar Shopify zonder één dag downtime. De laadtijd ging met 40% omlaag en onze conversie steeg direct mee.”</p>
            <footer><strong>Barry</strong> · GSM Team</footer>
          </blockquote>
        </div>
      </section>

      <!-- Contact -->
      <section class="lx-sec" data-sec="contact" id="contact" aria-labelledby="sec-contact">
        <header class="lx-sec__hero lx-sec__hero--wine">
          <p class="lx-sec__kicker">Contact</p>
          <h2 id="sec-contact" class="lx-sec__title">Laten we de lichten aandoen. <em>Ray reageert binnen 24 uur.</em></h2>
        </header>
        <div class="lx-sec__body">
          <div class="lx-cards">
            <a href="#" class="lx-cardlet lx-cardlet--link" data-overlay-open><Icon name="send" size={20} /><strong>Stuur een bericht</strong><span>Vertel kort wat je wilt bereiken.</span></a>
            <a href="/videocall" class="lx-cardlet lx-cardlet--link"><Icon name="video" size={20} /><strong>Plan een videocall</strong><span>Een halfuur, vrijblijvend.</span></a>
            <a href="mailto:hello@luminx.nl" class="lx-cardlet lx-cardlet--link"><Icon name="mail" size={20} /><strong>hello@luminx.nl</strong><span>Mail mag altijd.</span></a>
            <a href="tel:+31613698596" class="lx-cardlet lx-cardlet--link"><Icon name="phone" size={20} /><strong>+31 6 1369 8596</strong><span>Bellen of appen.</span></a>
          </div>
          <p class="lx-sec__sub"><Icon name="map-pin" size={16} /> Enschede, Twente · werkzaam in heel Nederland</p>
          <nav class="lx-legal" aria-label="Meer van LuminX">
            <a href="/over">Over LuminX</a>
            <a href="/blog">Blog</a>
            <a href="/privacy">Privacy</a>
            <a href="/algemene-voorwaarden">Voorwaarden</a>
          </nav>
        </div>
      </section>
      <!-- any page of the site, loaded into the popup -->
      <section class="lx-sec lx-pagesec" data-sec="page" aria-live="polite">
        <div class="lx-pagebar">
          <button type="button" class="lx-pagebar__back" data-page-back><Icon name="arrow" size={16} stroke={2.4} /> <span data-page-back-label>Terug</span></button>
          <a class="lx-pagebar__open" data-page-open href="/" target="_blank" rel="noopener">Open als pagina <Icon name="arrow-up-right" size={14} stroke={2.4} /></a>
        </div>
        <div class="lx-pagebody" data-page-body></div>
      </section>
    </div>
    <button type="button" class="lx-sheet__down" data-sheet-down aria-label="Verder lezen"><Icon name="arrow" size={18} stroke={2.4} /></button>
  </aside>
</section>



<script>
  import { PLACES, PROJECTS } from "./world/content";

  const root = document.documentElement;
  const loader = document.querySelector<HTMLElement>("[data-world-loader]");
  const panel = document.querySelector<HTMLElement>("[data-panel]")!;
  const scroller = document.querySelector<HTMLElement>("[data-panel-scroll]")!;
  const count = document.querySelector<HTMLElement>("[data-count]")!;
  const duskBtn = document.querySelector<HTMLButtonElement>("[data-dusk]")!;
  const duskLabel = document.querySelector<HTMLElement>("[data-dusk-label]")!;
  const articles = Array.from(document.querySelectorAll<HTMLElement>("[data-place]"));
  const order = PLACES.map((p) => p.id);
  let current: string | null = null;
  let ready = false;
  let lightsOn = false;

  const select = (id: string | null) => window.dispatchEvent(new CustomEvent("lx:select", { detail: { id } }));
  const setDusk = (on: boolean) => {
    lightsOn = on;
    duskBtn.setAttribute("aria-pressed", String(on));
    duskLabel.textContent = on ? "Lichten uit" : "Lichten aan";
    root.classList.toggle("lx-night", on);
    window.dispatchEvent(new CustomEvent("lx:dusk", { detail: { on } }));
  };

  /* ─── menu sheets ─────────────────────────────────────────────── */
  const sheet = document.querySelector<HTMLElement>("[data-sheet]")!;
  const sheetScroll = document.querySelector<HTMLElement>("[data-sheet-scroll]")!;
  const secs = Array.from(document.querySelectorAll<HTMLElement>("[data-sec]"));
  const menuItems = Array.from(document.querySelectorAll<HTMLElement>("[data-sheet-open]"));
  // where the camera goes while a sheet is open (null = the whole land, nudged aside)
  const SHEET_VIEW: Record<string, string | null> = { over: "luminx", contact: "luminx", diensten: "oudemarkt", werk: null };
  let sheetOpen: string | null = null;
  const setMenu = (id: string) => menuItems.forEach((m) => {
    const on = m.dataset.sheetOpen === id;
    m.classList.toggle("is-active", on);
    if (on) m.setAttribute("aria-current", "true"); else m.removeAttribute("aria-current");
  });
  const hideSheet = () => {
    sheetOpen = null;
    sheet.classList.remove("is-open");
    root.classList.remove("lx-sheet-open");
    setMenu("land");
  };
  const openSheet = (id: string) => {
    sheet.classList.remove("is-wide");
    if (location.pathname !== "/") { history.pushState({}, "", "/"); document.title = homeTitle; }
    if (id === "land") {
      if (sheetOpen) window.dispatchEvent(new CustomEvent("lx:view", { detail: { id: null, sheet: false } }));
      if (current) select(null);
      hideSheet();
      return;
    }
    if (current) select(null);
    sheetOpen = id;
    secs.forEach((x) => x.classList.toggle("is-active", x.dataset.sec === id));
    sheet.classList.add("is-open");
    root.classList.add("lx-sheet-open");
    sheetScroll.scrollTop = 0;
    setMenu(id);
    window.dispatchEvent(new CustomEvent("lx:view", { detail: { id: SHEET_VIEW[id] ?? null, sheet: true } }));
    if (id === "contact" && !lightsOn) setDusk(true);
  };
  menuItems.forEach((m) => m.addEventListener("click", () => openSheet(m.dataset.sheetOpen!)));
  document.querySelector("[data-sheet-close]")?.addEventListener("click", () => openSheet("land"));
  document.querySelector("[data-sheet-down]")?.addEventListener("click", () => sheetScroll.scrollBy({ top: sheetScroll.clientHeight * 0.8, behavior: "smooth" }));

  /* ─── every internal page opens in the popup ──────────────────────── */
  const pageBody = document.querySelector<HTMLElement>("[data-page-body]")!;
  const pageBackLabel = document.querySelector<HTMLElement>("[data-page-back-label]")!;
  const pageOpen = document.querySelector<HTMLAnchorElement>("[data-page-open]")!;
  const homeTitle = document.title;
  const pageCache = new Map<string, Promise<{ title: string; main: Element } | null>>();
  let returnTo: string | null = null;
  const FULL_PAGES = ["/videocall", "/tracking-audit", "/coming-soon"];
  const SHEET_NAMES: Record<string, string> = { diensten: "Diensten", werk: "Werk", over: "Over", contact: "Contact" };

  const viewFor = (path: string): { view: string | null; menu: string } => {
    if (path.startsWith("/diensten")) return { view: "oudemarkt", menu: "diensten" };
    if (path.startsWith("/cases")) {
      const p = PROJECTS.find((x) => path.startsWith(x.href));
      return { view: p ? p.id : null, menu: "werk" };
    }
    if (path.startsWith("/over")) return { view: "luminx", menu: "over" };
    return { view: null, menu: "" };
  };

  // bring along any stylesheet the page needs that this page doesn't have yet
  // (in production the site shares one stylesheet, so this is usually a no-op)
  const adoptStyles = (doc: Document) => {
    doc.head.querySelectorAll<HTMLLinkElement>('link[rel="stylesheet"]').forEach((l) => {
      const href = new URL(l.getAttribute("href")!, location.href).href;
      const has = Array.from(document.querySelectorAll<HTMLLinkElement>('link[rel="stylesheet"]')).some((x) => x.href === href);
      if (!has) document.head.appendChild(Object.assign(document.createElement("link"), { rel: "stylesheet", href }));
    });
    doc.head.querySelectorAll("style").forEach((st) => {
      const id = st.getAttribute("data-vite-dev-id");
      const dupe = id
        ? document.head.querySelector(`style[data-vite-dev-id="${CSS.escape(id)}"]`)
        : Array.from(document.head.querySelectorAll("style")).some((x) => x.textContent === st.textContent);
      if (!dupe) document.head.appendChild(st.cloneNode(true));
    });
  };

  const fetchPage = (url: string) => {
    const key = url.split("#")[0];
    if (!pageCache.has(key)) {
      pageCache.set(key, fetch(key, { credentials: "same-origin" })
        .then((r) => (r.ok ? r.text() : Promise.reject()))
        .then((html) => {
          const doc = new DOMParser().parseFromString(html, "text/html");
          const main = doc.querySelector("main");
          if (main) adoptStyles(doc);
          return main ? { title: doc.title, main } : null;
        })
        .catch(() => null));
    }
    return pageCache.get(key)!;
  };

  const openPage = async (url: string, push = true) => {
    const path = url.split("#")[0].split("?")[0];
    const hash = url.includes("#") ? url.slice(url.indexOf("#")) : "";
    if (current) select(null);
    if (sheetOpen && sheetOpen !== "page") returnTo = sheetOpen;
    else if (!sheetOpen) returnTo = null;
    pageBackLabel.textContent = returnTo ? `Terug naar ${SHEET_NAMES[returnTo] ?? "het overzicht"}` : "Terug naar het land";
    pageOpen.href = path;
    sheetOpen = "page";
    secs.forEach((x) => x.classList.toggle("is-active", x.dataset.sec === "page"));
    sheet.classList.add("is-open", "is-wide");
    root.classList.add("lx-sheet-open");
    pageBody.innerHTML = '<div class="lx-pageload"><span></span><span></span><span></span></div>';
    sheetScroll.scrollTop = 0;
    const { view, menu } = viewFor(path);
    setMenu(menu || "none");
    window.dispatchEvent(new CustomEvent("lx:view", { detail: { id: view, sheet: true } }));
    if (push) history.pushState({ lxPage: url }, "", url);

    const page = await fetchPage(url);
    if (sheetOpen !== "page") return;
    if (!page) { location.href = url; return; }
    const main = document.importNode(page.main, true);
    main.querySelectorAll("script").forEach((n) => n.remove());
    // content that normally animates in on scroll is simply shown
    main.querySelectorAll("[data-reveal]").forEach((n) => n.classList.add("is-in"));
    pageBody.replaceChildren(main);
    document.title = page.title;
    if (hash) pageBody.querySelector(hash)?.scrollIntoView();
  };

  const toHomeUrl = () => {
    if (location.pathname !== "/") history.pushState({}, "", "/");
    document.title = homeTitle;
  };

  document.querySelector("[data-page-back]")?.addEventListener("click", () => {
    toHomeUrl();
    sheet.classList.remove("is-wide");
    if (returnTo) openSheet(returnTo);
    else openSheet("land");
  });

  // intercept internal links anywhere on the page (menu, panels, the popup itself)
  document.addEventListener("click", (e) => {
    if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
    const target = e.target as Element;
    const overlayBtn = target.closest("[data-overlay-open]");
    if (overlayBtn && pageBody.contains(overlayBtn)) {
      // buttons inside a loaded page: hand over to the site's own contact overlay
      e.preventDefault();
      document.querySelector<HTMLElement>("header [data-overlay-open]")?.click();
      return;
    }
    const a = target.closest<HTMLAnchorElement>("a[href]");
    if (!a || a.hasAttribute("data-overlay-open") || a.hasAttribute("download") || a.hasAttribute("data-page-open")) return;
    if (a.target && a.target !== "_self") return;
    const u = new URL(a.href, location.href);
    if (u.origin !== location.origin) return;
    if (u.pathname === "/" || /\.(pdf|xml|txt|png|jpe?g|webp|svg)$/i.test(u.pathname)) return;
    // pages that rely on their own scripts (booking widget, audit form) open normally
    if (FULL_PAGES.some((p) => u.pathname.startsWith(p))) return;
    if (u.pathname === location.pathname && u.hash) {
      e.preventDefault();
      pageBody.querySelector(u.hash)?.scrollIntoView({ behavior: "smooth" });
      return;
    }
    e.preventDefault();
    // close the site menu if it was open
    const nav = document.querySelector("[data-nav]");
    if (nav?.classList.contains("is-open")) document.querySelector<HTMLElement>("[data-nav-toggle]")?.click();
    openPage(u.pathname + u.search + u.hash);
  });

  window.addEventListener("popstate", (e) => {
    const st = e.state as { lxPage?: string } | null;
    if (st?.lxPage) openPage(st.lxPage, false);
    else if (location.pathname === "/") {
      document.title = homeTitle;
      sheet.classList.remove("is-wide");
      if (sheetOpen === "page") { if (returnTo) openSheet(returnTo); else openSheet("land"); }
    }
  });

  window.addEventListener("lx:select", (e) => {
    const id = (e as CustomEvent<{ id: string | null }>).detail.id;
    if (id && sheetOpen) hideSheet();
    current = id;
    root.classList.toggle("lx-focused", !!id);
    panel.classList.toggle("is-open", !!id);
    if (!id) return;
    articles.forEach((a) => a.classList.toggle("is-active", a.dataset.place === id));
    count.textContent = `${order.indexOf(id) + 1} / ${order.length}`;
    scroller.scrollTop = 0;
    // the farm at the end of the lane is where the lights come on
    if (id === "luminx" && !lightsOn) setDusk(true);
  });

  const step = (dir: number) => {
    const i = current ? order.indexOf(current) : -1;
    select(order[(i + dir + order.length) % order.length]);
  };

  document.querySelectorAll<HTMLElement>("[data-select]").forEach((b) =>
    b.addEventListener("click", () => select(b.dataset.select!)),
  );
  document.querySelector("[data-prev]")?.addEventListener("click", () => step(-1));
  document.querySelector("[data-next]")?.addEventListener("click", () => step(1));
  document.querySelector("[data-close]")?.addEventListener("click", () => select(null));
  document.querySelector("[data-tour]")?.addEventListener("click", () => select(order[0]));
  // the hint bows out after the first real interaction with the land
  const hint = document.querySelector<HTMLElement>("[data-hint]");
  const dismiss = () => hint?.classList.add("is-gone");
  document.querySelector(".lx-stage")?.addEventListener("pointerdown", dismiss, { once: true });
  window.addEventListener("lx:select", dismiss, { once: true });
  duskBtn.addEventListener("click", () => setDusk(!lightsOn));
  document.querySelectorAll<HTMLElement>("[data-zoom]").forEach((b) =>
    b.addEventListener("click", () => window.dispatchEvent(new CustomEvent("lx:zoom", { detail: { dir: Number(b.dataset.zoom) } }))),
  );
  window.addEventListener("keydown", (e) => {
    if (sheetOpen && e.key === "Escape") return openSheet("land");
    if (!current) return;
    if (e.key === "Escape") select(null);
    if (e.key === "ArrowRight") step(1);
    if (e.key === "ArrowLeft") step(-1);
  });

  // deep links (#werk, #diensten, #over …) open the matching place
  const HASH: Record<string, string> = { techniek: "techniek", marketing: "marketing" };
  const fromHash = () => {
    const h = location.hash.slice(1);
    if (h in SHEET_VIEW) return openSheet(h);
    const id = HASH[h] ?? (order.includes(h) ? h : null);
    if (!id) return;
    document.querySelector("[data-world]")?.scrollIntoView({ behavior: "smooth" });
    select(id);
  };
  window.addEventListener("hashchange", () => ready && fromHash());

  const done = () => {
    if (ready) return;
    ready = true;
    loader?.classList.add("is-done");
    fromHash();
  };
  window.addEventListener("luminx:world-ready", () => requestAnimationFrame(done), { once: true });
  window.setTimeout(done, 9000);
</script>

