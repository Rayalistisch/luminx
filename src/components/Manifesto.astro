---
import { Image } from "astro:assets";
import founderImage from "../assets/images/luminx-founder.png";

const beliefs = [
  {
    title: "We verwijderen frictie.",
    body: "Trage pagina's, kapotte formulieren, onduidelijke funnels: elk obstakel kost je klanten. We beginnen bij wat nu lekt en dichten dat eerst: pas daarna gaat er budget naar meer verkeer.",
  },
  {
    title: "We automatiseren het werk.",
    body: "Handmatige exports, dubbele invoer, losse spreadsheets. We koppelen je systemen zodat terugkerend werk zichzelf doet en jij je tijd terugkrijgt.",
  },
  {
    title: "We engineeren groei.",
    body: "Geen onderbuikgevoel, maar data. Met betrouwbare tracking zien we welk kanaal echt omzet oplevert, en schalen we alleen wat werkt.",
  },
  {
    title: "We bouwen digitale bedrijven.",
    body: "Website, marketing en automatisering als één systeem, niet als losse projecten. Zodat je bedrijf online net zo soepel draait als op de werkvloer.",
  },
];
---

<section class="pm-section manifesto" aria-labelledby="manifesto-title">
  <div class="pm-container">
    <header class="pm-head">
      <span class="pm-label" data-reveal>Waarom LuminX</span>
      <h2 id="manifesto-title" class="pm-h2" data-reveal style="--d: 1">Omdat groei geen verzameling losse trucjes is.</h2>
      <p class="pm-opening" data-reveal style="--d: 2">
        De meeste MKB'ers betalen voor kanalen die niet met elkaar praten. Wij bouwen er één systeem van.
      </p>
    </header>

    <div class="pm-split">
      <figure class="pm-card pm-card--lift manifesto__visual" data-reveal>
        <Image
          src={founderImage}
          alt="Ray Huffenreuter, oprichter van LuminX"
          widths={[480, 720, 1000]}
          sizes="(max-width: 860px) 100vw, 640px"
          quality={90}
          loading="lazy"
        />
        <figcaption class="pm-tag pm-tag--yellow manifesto__caption">Ray, oprichter en jouw vaste aanspreekpunt</figcaption>
      </figure>

      <ul class="pm-accordion" data-reveal style="--d: 1">
        {beliefs.map((b, i) => (
          <li>
            <details class="pm-acc" name="manifesto" open={i === 0}>
              <summary>{b.title}</summary>
              <div class="pm-acc__body"><p>{b.body}</p></div>
            </details>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .manifesto__visual {
    margin: 0;
    aspect-ratio: 4 / 4.2;
    background: linear-gradient(180deg, var(--pm-paper), #F6DFC0);
  }
  .manifesto__visual :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 88% 0%;  /* Ray stands right of centre in the source */
  }
  .manifesto__caption {
    position: absolute;
    left: 1.25rem;
    bottom: 1.25rem;
    white-space: normal;
  }
</style>
