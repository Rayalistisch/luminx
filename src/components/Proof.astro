---
import { Image } from "astro:assets";
import founderImage from "../assets/images/ray_avatar.png";
import Icon from "./pm/Icon.astro";

const stats = [
  { value: 150, suffix: "%", label: "Effectiever werken", tone: "yellow" },
  { value: 10, suffix: "+", label: "Klanten", tone: "milk" },
  { value: 5, suffix: "+", label: "Jaren ervaring", tone: "milk" },
  { value: 2, suffix: "", label: "Awards", tone: "pink" },
];
---

<section class="pm-section proof" id="over" aria-labelledby="proof-title">
  <div class="pm-container">
    <header class="pm-head">
      <span class="pm-label" data-reveal>Bewezen resultaat</span>
      <h2 id="proof-title" class="pm-h2" data-reveal style="--d: 1">Wat klanten zeggen.</h2>
    </header>

    <div class="proof__grid">
      <figure class="pm-card pm-card--pink pm-card--lift proof__quote" data-reveal>
        <span class="proof__mark" aria-hidden="true">“</span>
        <blockquote class="pm-display">
          Ray heeft onze webshop volledig gemigreerd naar Shopify zonder één dag downtime.
          De laadtijd ging met 40% omlaag en onze conversie steeg direct mee.
        </blockquote>
        <figcaption>
          <strong>Barry</strong>
          <span>GSM Team</span>
        </figcaption>
      </figure>

      <div class="proof__side">
        <div class="proof__stats">
          {stats.map((s, i) => (
            <div class:list={["pm-card", "pm-stat", "proof__stat", `proof__stat--${s.tone}`]} data-value={s.value} data-suffix={s.suffix} data-reveal style={`--d: ${i}`}>
              <span class="pm-stat__value">{s.value}{s.suffix}</span>
              <span class="pm-stat__label">{s.label}</span>
            </div>
          ))}
        </div>

        <div class="pm-card proof__founder" data-reveal style="--d: 2">
          <Image
            class="proof__avatar"
            src={founderImage}
            alt="Ray – oprichter van LuminX"
            widths={[96, 160]}
            sizes="80px"
            loading="lazy"
          />
          <div>
            <p>Rechtstreekse samenwerking met Ray, oprichter van LuminX: geen accountmanager ertussen, geen bureau-constructie.</p>
            <a href="#" class="pm-link" data-overlay-open>Plan een kennismaking <Icon name="arrow" size={18} stroke={2.4} /></a>
          </div>
        </div>
      </div>
    </div>

    <p class="proof__clients" data-reveal>Vertrouwd door <strong>GSM Team</strong>, <strong>ActifAid</strong> en <strong>Ascendio</strong>.</p>
  </div>
</section>

<script>
  function animateCount(el: HTMLElement) {
    const valueEl = el.querySelector<HTMLElement>(".pm-stat__value");
    if (!valueEl) return;
    const target = Number(el.dataset.value || "0");
    const suffix = el.dataset.suffix || "";
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    const duration = 1200;
    const start = performance.now();
    const tick = (now: number) => {
      const p = Math.min(1, (now - start) / duration);
      const eased = 1 - Math.pow(1 - p, 3);
      valueEl.textContent = `${Math.round(target * eased)}${suffix}`;
      if (p < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }

  function initProof() {
    const stats = document.querySelectorAll<HTMLElement>(".proof__stat");
    if (!stats.length) return;
    const io = new IntersectionObserver(
      (entries, obs) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            animateCount(entry.target as HTMLElement);
            obs.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.5 }
    );
    stats.forEach((s) => io.observe(s));
  }

  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", initProof);
  else initProof();
</script>

<style>
  .proof__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: clamp(1.25rem, 2.5vw, 2rem);
    align-items: stretch;
  }

  .proof__quote {
    margin: 0;
    padding: clamp(2rem, 4.5vw, 3.75rem);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;
  }
  .proof__mark {
    font-family: var(--pm-display);
    font-size: 7rem;
    line-height: 0.6;
    height: 2.5rem;
    color: var(--pm-milk);
    -webkit-text-stroke: 2px var(--pm-ink);
    paint-order: stroke fill;
  }
  .proof__quote blockquote {
    margin: 0;
    font-size: clamp(1.6rem, 2.6vw, 2.35rem);
    line-height: 1.18;
  }
  .proof__quote figcaption { display: grid; gap: 0.1rem; }
  .proof__quote figcaption strong { font-size: 1.1rem; }
  .proof__quote figcaption span { font-weight: 600; color: var(--pm-ink-soft); }

  .proof__side { display: grid; gap: clamp(1.25rem, 2.5vw, 2rem); }

  .proof__stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.9rem;
  }
  .proof__stat {
    padding: 1.4rem 1.5rem;
    border-radius: var(--pm-r);
    box-shadow: var(--pm-drop);
  }
  .proof__stat--yellow { background: var(--pm-yellow); }
  .proof__stat--milk { background: var(--pm-milk); }
  .proof__stat--pink { background: var(--pm-blush); }

  .proof__founder {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1.4rem 1.5rem;
    border-radius: var(--pm-r);
    background: var(--pm-milk);
  }
  .proof__founder p { margin: 0 0 0.6rem; color: var(--pm-ink-soft); }
  .proof__founder :global(.proof__avatar) {
    flex: none;
    width: 80px;
    height: 80px;
    border-radius: 50%;
    border: var(--pm-border);
    object-fit: cover;
    background: var(--pm-yellow);
  }

  .proof__clients {
    margin: clamp(2.5rem, 5vw, 3.5rem) 0 0;
    text-align: center;
    color: var(--pm-ink-soft);
  }
  .proof__clients strong { color: var(--pm-ink); }

  @media (max-width: 960px) {
    .proof__grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 480px) {
    .proof__founder { flex-direction: column; align-items: flex-start; }
  }
</style>
