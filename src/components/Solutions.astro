---
import Icon from "./pm/Icon.astro";

const groups = [
  {
    id: "marketing",
    label: "Online marketing",
    lead: "Gevonden worden, geklikt worden, gekozen worden.",
    chip: "Gem. 3× meer organisch verkeer",
    tone: "pink",
    icon: "megaphone",
    items: [
      { title: "SEO", desc: "Structureel gevonden worden op wat je klanten zoeken.", href: "/diensten/seo" },
      { title: "SEA – Google Ads", desc: "Direct bovenaan met winstgevende campagnes.", href: "/diensten/sea" },
      { title: "Social advertising", desc: "Bereik en conversie op Meta, TikTok & LinkedIn.", href: "/diensten/social-advertising" },
      { title: "E-mailmarketing", desc: "Automatische flows die klanten laten terugkomen.", href: "/diensten/emailmarketing" },
      { title: "GEO – AI-zichtbaarheid", desc: "Genoemd worden in AI-antwoorden en chatbots.", href: "/diensten/geo" },
    ],
  },
  {
    id: "techniek",
    label: "Techniek & automatisering",
    lead: "Het fundament onder alles wat je online doet.",
    chip: "0 dagen downtime bij migraties",
    tone: "yellow",
    icon: "code",
    items: [
      { title: "Websites", desc: "Razendsnelle sites die laden én converteren.", href: "/diensten/websites" },
      { title: "Next.js → WordPress", desc: "AI-site op Vercel ombouwen naar aanpasbaar WordPress.", href: "/diensten/nextjs-naar-wordpress" },
      { title: "Webshops", desc: "Schaalbare shops op Shopify of maatwerk.", href: "/diensten/webshops" },
      { title: "Procesautomatisering", desc: "Handmatig werk eruit, data erin.", href: "/diensten/procesautomation" },
      { title: "Tag Manager, GA4 & Consent", desc: "Betrouwbaar meten wat mag, en wat werkt.", href: "/diensten/google-tag-manager" },
    ],
  },
] as const;
---

<section class="pm-section solutions" id="diensten" aria-labelledby="solutions-title">
  <div class="pm-container">
    <header class="pm-head">
      <span class="pm-label" data-reveal>Oplossingen</span>
      <h2 id="solutions-title" class="pm-h2" data-reveal style="--d: 1">Alles wat groei nodig heeft, onder één dak.</h2>
    </header>

    <div class="pm-split solutions__grid">
      {groups.map((g, gi) => (
        <article class:list={["pm-card", "pm-card--lift", "solutions__group", `solutions__group--${g.tone}`]} data-reveal style={`--d: ${gi}`}>
          <header class="solutions__top">
            <span class:list={["pm-icon", g.tone === "yellow" ? "pm-icon--milk" : "pm-icon--wine"]}><Icon name={g.icon} /></span>
            <div>
              <h3 class="pm-h3">{g.label}</h3>
              <p class="solutions__lead">{g.lead}</p>
            </div>
          </header>
          <ul class="solutions__list">
            {g.items.map((it) => (
              <li>
                <a href={it.href} class="solutions__row">
                  <span>
                    <strong>{it.title}</strong>
                    <span>{it.desc}</span>
                  </span>
                  <span class="solutions__arrow" aria-hidden="true"><Icon name="arrow" size={18} stroke={2.4} /></span>
                </a>
              </li>
            ))}
          </ul>
          <p class="pm-tag pm-tag--paper solutions__chip"><Icon name="trending-up" size={16} /> {g.chip}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .solutions__group { display: flex; flex-direction: column; background: var(--pm-milk); }

  .solutions__top {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border-bottom: var(--pm-border);
  }
  .solutions__group--pink .solutions__top { background: var(--pm-pink); }
  .solutions__group--yellow .solutions__top { background: var(--pm-yellow); }
  .solutions__lead { margin: 0.3rem 0 0; font-weight: 600; color: var(--pm-ink-soft); }

  .solutions__list { list-style: none; margin: 0; padding: 0.5rem clamp(1rem, 2.5vw, 1.75rem); flex: 1; }
  .solutions__list li + li { border-top: 2px dashed var(--pm-ink-line); }

  .solutions__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.1rem 0.25rem;
    color: var(--pm-ink);
    text-decoration: none;
  }
  .solutions__row > span:first-child { display: grid; gap: 0.15rem; }
  .solutions__row strong {
    font-family: var(--pm-display);
    font-weight: 400;
    font-size: clamp(1.35rem, 1.8vw, 1.6rem);
    line-height: 1.15;
    letter-spacing: 0.01em;
    transition: color 0.2s ease;
  }
  .solutions__row strong + span { font-size: 0.95rem; color: var(--pm-ink-soft); }

  .solutions__arrow {
    display: grid;
    place-items: center;
    flex: none;
    width: 40px;
    height: 40px;
    border: var(--pm-border);
    border-radius: 50%;
    background: var(--pm-paper);
    transition: transform 0.45s var(--pm-ease), background-color 0.2s ease, box-shadow 0.45s var(--pm-ease);
  }
  @media (hover: hover) {
    .solutions__row:hover strong { color: var(--pm-red); }
    .solutions__row:hover .solutions__arrow {
      background: var(--pm-red);
      color: var(--pm-milk);
      transform: translateY(-2px) rotate(-30deg);
      box-shadow: 0 4px 0 var(--pm-ink);
    }
  }

  .solutions__chip {
    margin: 0 clamp(1.5rem, 3vw, 2.25rem) clamp(1.5rem, 3vw, 2.25rem);
    align-self: flex-start;
  }
</style>
